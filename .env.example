# Alan Woodyard Photo Environment Variables
# Cloudflare Pages & API Keys

# Stripe keys (embedded Checkout + webhook signature verification)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLIC_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Resend API Key (for lead capture and order alerts)
RESEND_API_KEY=re_placeholder
OPERATOR_EMAIL=alan@alanwoodyard.com
RESEND_FROM="Alan Woodyard Photo <orders@alanwoodyard.photo>"

# Public https origin for print files. Resolved as {base}/masters/{slug}.tif
# Leave ALLOW_CLEAN_PREVIEW_ASSETS unset so labs never receive the webp preview.
PRINT_MASTERS_BASE_URL=
PRINT_MASTERS_EXTENSION=tif
ALLOW_CLEAN_PREVIEW_ASSETS=

# Prodigi Print API v4
PRODIGI_API_KEY=test_prodigi_api_key

# Printify API v1
PRINTIFY_API_TOKEN=test_printify_token
PRINTIFY_SHOP_ID=1234567

# Printful API v2
PRINTFUL_API_TOKEN=test_printful_token
PRINTFUL_STORE_ID=1234567

# Gelato API v2
GELATO_API_KEY=test_gelato_key

# Gooten API
GOOTEN_RECIPE_ID=test_recipe_id

# Umami Analytics Host
UMAMI_HOST_URL=http://chantecler-01:3008
UMAMI_WEBSITE_ID=alanwoodyard-photo-prod
