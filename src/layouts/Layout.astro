---
import CartDrawer from '../components/CartDrawer.astro';

interface Props {
  title?: string;
  theme?: 'petrol' | 'walnut' | 'moss' | 'slate';
}

const { 
  title = "Alan Woodyard | Photography", 
  theme = "petrol" 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
                                                            <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    
    

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&family=Italiana&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  </head>

  <body 
    data-theme={theme} 
    class="min-h-full flex flex-col bg-[var(--theme-bg)] text-[var(--theme-text)] selection:bg-[var(--theme-accent)] selection:text-[var(--theme-bg)] transition-colors duration-500 ease-out font-sans antialiased"
  >
    <slot />
    <CartDrawer />
  </body>
</html>

<style is:global>
  :root {
    --font-serif: 'Italiana', serif;
    --font-sans: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: 'Space Mono', monospace;
  }

  /* 1. Main Exhibition (Deep Petrol & Brass) */
  body[data-theme="petrol"] {
    --theme-bg: #091013;
    background-image: radial-gradient(ellipse 80% 50% at 50% 0%, #111e24 0%, #070d0f 100%);
    --theme-surface: #10191d;
    --theme-surface-raised: #152227;
    --theme-border: rgba(212, 163, 89, 0.15);
    --theme-accent: #d4a359;
    --theme-accent-hover: #e5b66d;
    --theme-text: #f5efe6;
    --theme-text-muted: #85989e;
  }

  /* 2. Collector Salon / Detail View (Velvety Espresso, Ambient Track Light & Brushed Bronze) */
  body[data-theme="walnut"] {
    --theme-bg: #0d0b0a;
    background-image: radial-gradient(ellipse 75% 55% at 50% -5%, #241c18 0%, #0c0a09 100%);
    background-attachment: fixed;
    --theme-surface: rgba(22, 18, 16, 0.75);
    --theme-surface-raised: #211b18;
    --theme-border: rgba(255, 255, 255, 0.08);
    --theme-accent: #d9a76a;
    --theme-accent-hover: #e8bd84;
    --theme-text: #f7f3ee;
    --theme-text-muted: #9e948c;
  }

  /* 3. The Garden / Field Notes (Olive Moss & Sage) */
  body[data-theme="moss"] {
    --theme-bg: #0b0f0c;
    background-image: radial-gradient(ellipse 80% 50% at 50% 0%, #151e18 0%, #080c09 100%);
    --theme-surface: #121914;
    --theme-surface-raised: #18221b;
    --theme-border: rgba(143, 158, 122, 0.18);
    --theme-accent: #8f9e7a;
    --theme-accent-hover: #a1b08c;
    --theme-text: #f3efe7;
    --theme-text-muted: #85948a;
  }

  /* 4. Drafting Studio / Admin (Cast Iron & Technical Amber) */
  body[data-theme="slate"] {
    --theme-bg: #0f1012;
    --theme-surface: #16181b;
    --theme-surface-raised: #1e2024;
    --theme-border: rgba(223, 155, 50, 0.18);
    --theme-accent: #df9b32;
    --theme-accent-hover: #f0ac43;
    --theme-text: #ece8e1;
    --theme-text-muted: #8a8e96;
  }
</style>