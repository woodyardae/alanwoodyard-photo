---
// src/components/ArtworkCard.astro
interface Props {
  artwork: any;
}

const { artwork } = Astro.props;
const data = artwork.data;
const slug = data.slug || artwork.slug || artwork.id.replace(/\.[^/.]+$/, '');
const locationName = typeof data.capture?.location === 'object' ? data.capture.location.name : (data.capture?.location || '');
const variants = data.print_variants || data.variants || [];
const minPrice = variants.length > 0 
  ? Math.min(...variants.map((v: any) => v.price_usd_cents || v.priceCents || 18500)) / 100 
  : 185;
const moods = data.taxonomies?.mood?.join(',') || (data.taxonomies?.moods || []).join(',') || '';
---
<article 
  class="gallery-item group relative mb-24 md:mb-32"
  data-moods={moods}
>
  <a href={`/artwork/${slug}`} class="block overflow-hidden">
    <div class="w-full flex items-center justify-center bg-[#0a0908]">
      <img 
        src={`/images/artworks/${slug}.webp`} 
        alt={data.title}
        loading="lazy"
        class="w-full h-auto object-contain max-h-[78vh] transition-transform duration-700 ease-out group-hover:scale-[1.012]"
      />
    </div>
  </a>

  <div class="mt-6 flex justify-between items-baseline gap-4">
    <div>
      <h2 class="font-serif text-2xl md:text-3xl text-[#f7f4ee] font-light">
        <a href={`/artwork/${slug}`} class="hover:text-[#dfb872] transition-colors">
          {data.title}
        </a>
      </h2>
      <p class="text-sm text-[#a89f91] mt-1.5 font-sans tracking-wide">
        {locationName}{locationName && ' — '}{new Date(data.capture.date).getFullYear()}
      </p>
    </div>

    <div class="text-right">
      <span class="text-sm font-mono text-[#c5a059] font-medium">From ${minPrice}</span>
    </div>
  </div>
</article>