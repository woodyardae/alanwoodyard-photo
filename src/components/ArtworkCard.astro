---
// src/components/ArtworkCard.astro
interface Props {
  artwork: any;
  priority?: boolean;
  spanFull?: boolean;
}

const { artwork, spanFull = false } = Astro.props;
const data = artwork.data;
---
<article 
  class={`gallery-item group relative mb-20 md:mb-32 ${spanFull ? 'col-span-full' : ''}`}
  data-moods={data.taxonomies?.mood?.join(',') || ''}
  data-collections={data.taxonomies?.collections?.join(',') || ''}
>
  <a href={`/artwork/${artwork.slug}`} class="block overflow-hidden bg-black/40">
    <div class="relative w-full flex items-center justify-center p-2 md:p-8 border gallery-hairline bg-[#09090b]/50 group-hover:border-white/20 transition-all duration-700">
      <img 
        src={`/images/artworks/${artwork.slug}.webp`} 
        alt={data.title}
        loading="lazy"
        class="w-full h-auto object-contain max-h-[85vh] transition-transform duration-1000 ease-out group-hover:scale-[1.01]"
      />
    </div>
  </a>

  <!-- Museum Placard Label -->
  <div class="mt-6 flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-2 px-1">
    <div>
      <h2 class="font-serif text-lg md:text-xl text-zinc-100 tracking-wide">
        <a href={`/artwork/${artwork.slug}`} class="hover:underline underline-offset-4">
          {data.title}
        </a>
      </h2>
      <p class="text-xs text-zinc-400 font-light mt-1">
        {data.capture.location} &bull; {new Date(data.capture.date).getFullYear()}
      </p>
    </div>

    <div class="text-left sm:text-right">
      <p class="text-[11px] font-mono tracking-wider text-zinc-400">
        From ${Math.min(...data.print_variants.map((v: any) => v.price_usd_cents)) / 100}
      </p>
      <p class="text-[10px] font-mono uppercase tracking-widest text-zinc-600 mt-0.5">
        Archival Giclée &bull; Acrylic &bull; Aluminum
      </p>
    </div>
  </div>
</article>