---
// src/components/ArtworkCard.astro
import type { Artwork } from '../content.config';

interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;
const lowestPrice = Math.min(...artwork.variants.map((v) => v.retailPriceUsd));
const isLimited = artwork.limitedEdition?.isLimited;
---

<article
  class="group relative flex flex-col rounded-xl border border-[#202334] bg-[#11121a] overflow-hidden transition-all duration-300 hover:border-sky-500/60 hover:shadow-2xl hover:shadow-sky-500/10"
  data-collections={artwork.collections.join(' ')}
>
  <!-- Artwork Image Preview Container -->
  <a
    href={`/artwork/${artwork.slug}`}
    class="relative block aspect-[4/3] w-full overflow-hidden bg-[#0c0d12] cursor-pointer"
  >
    <img
      src={artwork.previewImage}
      alt={artwork.title}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
    />

    <!-- Gradient Vignette -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20 opacity-80 group-hover:opacity-60 transition-opacity"></div>

    <!-- Top Badges -->
    <div class="absolute top-3 left-3 right-3 flex items-center justify-between pointer-events-none">
      <div class="flex items-center gap-1.5">
        <span class="rounded bg-black/60 backdrop-blur-md px-2 py-0.5 text-[10px] font-mono font-bold tracking-wider text-sky-400 border border-sky-500/30 uppercase">
          {artwork.colorScience.colorSpace}
        </span>
        <span class="rounded bg-black/60 backdrop-blur-md px-1.5 py-0.5 text-[10px] font-mono text-slate-300 border border-slate-700/60">
          {artwork.dimensions.aspectRatio}
        </span>
      </div>

      {isLimited && (
        <span class="rounded bg-amber-500/20 backdrop-blur-md px-2 py-0.5 text-[10px] font-bold text-amber-400 border border-amber-500/40 uppercase tracking-wider">
          Ltd. {artwork.limitedEdition?.editionSize}
        </span>
      )}
    </div>

    <!-- Bottom Technical Bar -->
    <div class="absolute bottom-2.5 left-3 right-3 text-[11px] text-slate-300 flex items-center justify-between pointer-events-none">
      <span class="truncate max-w-[200px] text-slate-400">{artwork.capture.location.name}</span>
      <span class="font-mono text-xs font-semibold text-white">from ${lowestPrice}</span>
    </div>
  </a>

  <!-- Content & Metadata Footer -->
  <div class="p-4 flex-1 flex flex-col justify-between">
    <div>
      <h3 class="text-base font-bold text-white tracking-tight group-hover:text-sky-400 transition-colors">
        <a href={`/artwork/${artwork.slug}`}>
          {artwork.title}
        </a>
      </h3>

      <p class="mt-1.5 text-xs text-slate-400 line-clamp-2 leading-relaxed">
        {artwork.description}
      </p>

      <!-- Technical Camera Spec Row -->
      <div class="mt-3 flex flex-wrap gap-2 text-[10px] font-mono text-slate-500 border-t border-[#1c1f2e] pt-2.5">
        <span>{artwork.capture.camera.split(' ')[0]}</span>
        <span>&bull;</span>
        <span>{artwork.capture.lens.split(' ')[0]} {artwork.capture.focalLength}</span>
        <span>&bull;</span>
        <span>{artwork.capture.aperture}</span>
        <span>&bull;</span>
        <span>{artwork.capture.shutterSpeed}</span>
      </div>
    </div>

    <!-- Quick Purchase & Inspect Action -->
    <div class="mt-4 pt-3 border-t border-[#1c1f2e] flex items-center justify-between">
      <div class="flex items-center gap-1">
        {artwork.colorScience.dominantHex.map((hex) => (
          <span
            class="h-3 w-3 rounded-full border border-black/40"
            style={`background-color: ${hex};`}
            title={`Dominant Tone: ${hex}`}
          />
        ))}
      </div>

      <a
        href={`/artwork/${artwork.slug}`}
        class="inline-flex items-center gap-1 text-xs font-semibold text-sky-400 hover:text-sky-300 transition-colors"
      >
        <span>Inspect &amp; Collect</span>
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
