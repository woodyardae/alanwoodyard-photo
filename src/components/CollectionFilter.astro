---
// src/components/CollectionFilter.astro
const moods = [
  { id: 'all', label: 'All Works' },
  { id: 'magenta-twilight', label: 'Twilight' },
  { id: 'golden-hour', label: 'Golden Hour' },
  { id: 'deep-ocean', label: 'Deep Ocean' },
  { id: 'fog-mist', label: 'Fog & Mist' },
  { id: 'monochrome', label: 'Monochrome' }
];
---
<div class="w-full max-w-7xl mx-auto px-6 md:px-12 pt-12 pb-8 flex flex-col md:flex-row justify-between items-start md:items-baseline gap-4 border-b gallery-hairline">
  <div class="text-[11px] font-mono uppercase tracking-widest text-zinc-500">
    Curated Portfolio &mdash; Coastal & Maritime Plates
  </div>
  
  <div class="flex flex-wrap gap-x-6 gap-y-2 text-xs tracking-wider">
    {moods.map((m) => (
      <button 
        class="mood-trigger text-zinc-500 hover:text-zinc-200 transition-colors cursor-pointer capitalize data-[active=true]:text-zinc-100 data-[active=true]:underline underline-offset-8"
        data-mood={m.id}
        data-active={m.id === 'all' ? 'true' : 'false'}
      >
        {m.label}
      </button>
    ))}
  </div>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.mood-trigger');
  const items = document.querySelectorAll<HTMLElement>('.gallery-item');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.setAttribute('data-active', 'false'));
      btn.setAttribute('data-active', 'true');
      const selected = btn.dataset.mood;

      if (window.umami) {
        window.umami.track('filter_mood', { mood: selected });
      }

      items.forEach(item => {
        const itemMoods = (item.dataset.moods || '').split(',');
        if (selected === 'all' || itemMoods.includes(selected!)) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>