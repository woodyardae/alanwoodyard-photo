---
// src/components/CollectionFilter.astro
const moods = [
  { id: 'all', label: 'All Works' },
  { id: 'magenta-twilight', label: 'Twilight' },
  { id: 'golden-hour', label: 'Golden Hour' },
  { id: 'deep-ocean', label: 'Deep Ocean' },
  { id: 'fog-mist', label: 'Fog & Mist' },
  { id: 'monochrome', label: 'Monochrome' }
];
---
<div class="w-full max-w-7xl mx-auto px-6 md:px-12 pt-12 pb-8 flex flex-col md:flex-row justify-between items-start md:items-baseline gap-6 border-b brass-border">
  <div class="text-[10px] font-mono uppercase tracking-[0.25em] text-[#c89346]">
    Architectural & Maritime Plates &mdash; Studio Editions
  </div>
  
  <div class="flex flex-wrap gap-2 text-xs tracking-wider">
    {moods.map((m) => (
      <button 
        class="mood-trigger text-[#9e9382] hover:text-[#f5f0e6] px-3.5 py-1.5 rounded-sm border border-transparent transition-all cursor-pointer text-xs font-sans tracking-widest uppercase data-[active=true]:border-[#c89346]/60 data-[active=true]:bg-[#c89346]/10 data-[active=true]:text-[#f5f0e6]"
        data-mood={m.id}
        data-active={m.id === 'all' ? 'true' : 'false'}
      >
        {m.label}
      </button>
    ))}
  </div>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.mood-trigger');
  const items = document.querySelectorAll<HTMLElement>('.gallery-item');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.setAttribute('data-active', 'false'));
      btn.setAttribute('data-active', 'true');
      const selected = btn.dataset.mood;

      if (window.umami) {
        window.umami.track('filter_mood', { mood: selected });
      }

      items.forEach(item => {
        const itemMoods = (item.dataset.moods || '').split(',');
        if (selected === 'all' || itemMoods.includes(selected!)) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>