---
// src/components/CollectionFilter.astro
const moods = [
  { id: 'all', label: 'All Plates' },
  { id: 'magenta-twilight', label: 'Twilight' },
  { id: 'golden-hour', label: 'Golden Hour' },
  { id: 'deep-ocean', label: 'Deep Ocean' },
  { id: 'fog-mist', label: 'Mist & Fog' },
  { id: 'monochrome', label: 'Monochrome' }
];
---
<div class="w-full max-w-[1700px] mx-auto px-6 md:px-16 pt-12 pb-8 flex flex-col md:flex-row justify-between items-start md:items-baseline gap-6 border-b border-white/[0.08]">
  <div class="text-xs font-mono uppercase tracking-[0.25em] text-[#a89f91]">
    Curated Horizons &bull; Archival Editions
  </div>
  
  <div class="flex flex-wrap gap-x-10 gap-y-3 text-sm font-sans tracking-[0.18em] uppercase">
    {moods.map((m) => (
      <button 
        class="mood-trigger text-[#8e8577] hover:text-[#f7f4ee] transition-colors cursor-pointer data-[active=true]:text-[#f7f4ee] data-[active=true]:border-b data-[active=true]:border-[#c5a059] pb-1"
        data-mood={m.id}
        data-active={m.id === 'all' ? 'true' : 'false'}
      >
        {m.label}
      </button>
    ))}
  </div>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.mood-trigger');
  const items = document.querySelectorAll<HTMLElement>('.gallery-item');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.setAttribute('data-active', 'false'));
      btn.setAttribute('data-active', 'true');
      const selected = btn.dataset.mood;

      if (window.umami) {
        window.umami.track('filter_mood', { mood: selected });
      }

      items.forEach(item => {
        const itemMoods = (item.dataset.moods || '').split(',');
        if (selected === 'all' || itemMoods.includes(selected!)) {
          item.style.display = 'block';
        } else {
          item.style.display = 'none';
        }
      });
    });
  });
</script>