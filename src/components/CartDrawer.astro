---
---

<div id="cartModal" class="fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0">
  <!-- Backdrop -->
  <div id="cartBackdrop" class="absolute inset-0 bg-black/70 backdrop-blur-sm transition-opacity"></div>

  <!-- Panel -->
  <aside class="absolute top-0 right-0 h-full w-full max-w-lg bg-[var(--theme-surface)] border-l border-[var(--theme-border)] shadow-2xl flex flex-col font-sans text-[var(--theme-text)] pointer-events-auto transform translate-x-full transition-transform duration-300 ease-out" id="cartPanel">
    <!-- Header -->
    <div class="p-6 border-b border-[var(--theme-border)] flex items-center justify-between">
      <div>
        <h2 class="font-serif text-lg tracking-wider uppercase text-[var(--theme-text)]">Collector Cart</h2>
        <p class="text-xs font-mono text-[var(--theme-text-muted)] mt-0.5" id="cartHeaderSubtitle">Direct Fulfillment Staging</p>
      </div>
      <button type="button" id="closeCartBtn" class="p-2 text-[var(--theme-text-muted)] hover:text-[var(--theme-accent)] font-mono text-sm">
        &times; CLOSE
      </button>
    </div>

    <!-- Scrollable Body -->
    <div class="flex-1 overflow-y-auto p-6 space-y-6" id="cartBody">
      <!-- Consolidation Recommendation Banner (Hidden by default) -->
      <div id="consolidationBanner" class="hidden p-4 border border-[var(--theme-accent)]/40 bg-[var(--theme-bg)] text-xs font-mono space-y-2">
        <div class="flex items-start gap-2 text-[var(--theme-accent)]">
          <span>📦</span>
          <span class="font-bold uppercase tracking-wider">Consolidated Studio Shipping Available</span>
        </div>
        <p class="text-[11px] text-[var(--theme-text-muted)] leading-relaxed" id="consolidationText">
          Switching your secondary item to the matching fine-art lab consolidates your order into a single shipment.
        </p>
        <button type="button" id="consolidateBtn" class="w-full mt-2 py-2 px-3 border border-[var(--theme-accent)] bg-[var(--theme-accent)]/10 text-[var(--theme-accent)] hover:bg-[var(--theme-accent)] hover:text-[var(--theme-bg)] transition-colors font-bold tracking-wider uppercase text-[11px]">
          ⇄ Consolidate & Save Freight
        </button>
      </div>

      <!-- Items List -->
      <div id="cartItemList" class="space-y-4"></div>

      <!-- Multi-Origin Parcel Warning / Breakdown -->
      <div id="shipmentBreakdown" class="hidden border-t border-[var(--theme-border)] pt-4 space-y-3 font-mono text-xs">
        <span class="text-[11px] uppercase tracking-widest text-[var(--theme-accent)] block">
          Dispatch & Packaging Breakdown
        </span>
        <div id="packageList" class="space-y-2"></div>
      </div>
    </div>

    <!-- Footer Summary & Checkout -->
    <div class="p-6 border-t border-[var(--theme-border)] bg-[var(--theme-bg)]/80 space-y-4 font-mono text-xs">
      <div class="space-y-1.5 text-[var(--theme-text-muted)]">
        <div class="flex justify-between">
          <span>Print Subtotal</span>
          <span class="text-[var(--theme-text)] font-sans text-sm" id="subtotalVal">$0.00</span>
        </div>
        <div class="flex justify-between">
          <span>Carrier Freight</span>
          <span class="text-[var(--theme-accent)]" id="shippingVal">Included</span>
        </div>
      </div>

      <div class="border-t border-[var(--theme-border)] pt-3 flex justify-between items-baseline">
        <span class="font-serif text-sm tracking-wider uppercase text-[var(--theme-text)]">Estimated Total</span>
        <span class="font-serif text-xl text-[var(--theme-accent)]" id="totalVal">$0.00</span>
      </div>

      <button type="button" id="checkoutBtn" class="w-full py-3.5 bg-[var(--theme-accent)] text-[var(--theme-bg)] hover:bg-[var(--theme-accent-hover)] font-mono text-xs uppercase tracking-widest font-bold transition-colors">
        Proceed to Secure Checkout &rarr;
      </button>
      <p class="text-[10px] text-center text-[var(--theme-text-muted)]">
        Insured Fine-Art Delivery &bull; Certificate of Authenticity Included
      </p>
    </div>
  </aside>
</div>

<script>
  import { 
    $cartItems, 
    $isCartOpen, 
    $cartSubtotal, 
    $fulfillmentPackages, 
    $totalShipping, 
    removeItem, 
    consolidateItem 
  } from '../stores/cart';

  const modal = document.getElementById('cartModal')!;
  const panel = document.getElementById('cartPanel')!;
  const backdrop = document.getElementById('cartBackdrop')!;
  const closeBtn = document.getElementById('closeCartBtn')!;
  const itemList = document.getElementById('cartItemList')!;
  const subtotalVal = document.getElementById('subtotalVal')!;
  const shippingVal = document.getElementById('shippingVal')!;
  const totalVal = document.getElementById('totalVal')!;
  const consolidationBanner = document.getElementById('consolidationBanner')!;
  const consolidationText = document.getElementById('consolidationText')!;
  const consolidateBtn = document.getElementById('consolidateBtn')!;
  const shipmentBreakdown = document.getElementById('shipmentBreakdown')!;
  const packageList = document.getElementById('packageList')!;

  let currentConsolidationTargetId: string | null = null;

  function renderCart() {
    const items = $cartItems.get();
    const subtotal = $cartSubtotal.get();
    const packages = $fulfillmentPackages.get();
    const shipping = $totalShipping.get();

    // 1. Render Line Items
    if (items.length === 0) {
      itemList.innerHTML = `
        <div class="py-12 text-center text-[var(--theme-text-muted)] font-mono text-xs">
          Your collector cart is currently empty.
        </div>
      `;
      consolidationBanner.classList.add('hidden');
      shipmentBreakdown.classList.add('hidden');
    } else {
      itemList.innerHTML = items.map((item) => `
        <div class="p-3 border border-[var(--theme-border)] bg-[var(--theme-bg)] flex gap-4 items-center">
          <img src="${item.imageSrc}" alt="${item.artworkTitle}" class="w-16 h-16 object-cover border border-white/10" />
          <div class="flex-1 min-w-0">
            <h3 class="font-serif text-sm text-[var(--theme-text)] truncate">${item.artworkTitle}</h3>
            <p class="text-[11px] font-mono text-[var(--theme-text-muted)]">${item.variantTitle}</p>
            <p class="text-[11px] font-mono text-[var(--theme-accent)] mt-1">$${item.price.toFixed(2)} &times; ${item.quantity}</p>
          </div>
          <button type="button" data-remove="${item.id}" class="text-xs font-mono text-[var(--theme-text-muted)] hover:text-red-400 p-2">
            &times;
          </button>
        </div>
      `).join('');
    }

    // 2. Multi-Package Warning & Breakdown
    if (packages.length > 1) {
      shipmentBreakdown.classList.remove('hidden');
      packageList.innerHTML = packages.map((pkg, idx) => `
        <div class="p-2.5 border border-[var(--theme-border)] bg-[var(--theme-surface)]">
          <div class="flex justify-between text-[11px]">
            <span class="text-[var(--theme-text)] font-bold">Package ${idx + 1}: ${pkg.providerName}</span>
            <span class="${pkg.estimatedShipping === 0 ? 'text-[var(--theme-accent)]' : 'text-[var(--theme-text)]'}">
              ${pkg.estimatedShipping === 0 ? 'Included' : '$' + pkg.estimatedShipping.toFixed(2)}
            </span>
          </div>
          <p class="text-[10px] text-[var(--theme-text-muted)] mt-0.5">${pkg.packagingDescription}</p>
        </div>
      `).join('');
    } else {
      shipmentBreakdown.classList.add('hidden');
    }

    // 3. Check for Consolidation Opportunities
    const swappable = items.find((i) => i.consolidationAlternative && packages.length > 1);
    if (swappable && swappable.consolidationAlternative) {
      currentConsolidationTargetId = swappable.id;
      consolidationBanner.classList.remove('hidden');
      consolidationText.textContent = `Your cart has items dispatching from separate labs. Switch ${swappable.artworkTitle} to the ${swappable.consolidationAlternative.variantTitle} to bundle into a single shipment and save $${swappable.consolidationAlternative.estimatedFreightSaved.toFixed(2)} in freight.`;
    } else {
      consolidationBanner.classList.add('hidden');
      currentConsolidationTargetId = null;
    }

    // 4. Update Financial Totals
    subtotalVal.textContent = `$${subtotal.toFixed(2)}`;
    shippingVal.textContent = shipping === 0 ? 'Included' : `$${shipping.toFixed(2)}`;
    totalVal.textContent = `$${(subtotal + shipping).toFixed(2)}`;
  }

  // Event Listeners
  $cartItems.subscribe(renderCart);

  $isCartOpen.subscribe((isOpen) => {
    if (isOpen) {
      modal.classList.remove('pointer-events-none', 'opacity-0');
      modal.classList.add('opacity-100');
      panel.classList.remove('translate-x-full');
    } else {
      modal.classList.remove('opacity-100');
      modal.classList.add('pointer-events-none', 'opacity-0');
      panel.classList.add('translate-x-full');
    }
  });

  closeBtn.addEventListener('click', () => $isCartOpen.set(false));
  backdrop.addEventListener('click', () => $isCartOpen.set(false));

  itemList.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const removeId = target.getAttribute('data-remove');
    if (removeId) removeItem(removeId);
  });

  consolidateBtn.addEventListener('click', () => {
    if (currentConsolidationTargetId) {
      consolidateItem(currentConsolidationTargetId);
    }
  });
</script>