---
// src/components/Header.astro
---
<header class="w-full border-b brass-border py-6 px-6 md:px-12 flex justify-between items-center bg-[#14110f]/90 backdrop-blur-md sticky top-0 z-40 transition-all duration-300">
  <div class="flex items-baseline gap-4">
    <a href="/" class="text-xl md:text-2xl font-serif tracking-[0.08em] uppercase text-[#f5f0e6] hover:text-[#dfa85b] transition-colors">
      Alan Woodyard
    </a>
    <span class="text-[10px] tracking-[0.25em] uppercase text-[#c89346] font-mono font-medium hidden sm:inline">
      Fine Art Photography
    </span>
  </div>
  
  <nav class="flex items-center gap-6 md:gap-10 text-[11px] tracking-[0.2em] uppercase text-[#a69c8d] font-medium font-sans">
    <a href="/" class="hover:text-[#f5f0e6] transition-colors">Exhibition</a>
    <a href="/about" class="hover:text-[#f5f0e6] transition-colors">Provenance</a>
    <a href="https://faa.alanwoodyard.photo" target="_blank" rel="noopener noreferrer" class="text-[#c89346]/80 hover:text-[#dfa85b] transition-colors hidden md:inline">
      FAA Catalog &nearr;
    </a>
    <button id="cart-toggle" class="text-[#a69c8d] hover:text-[#f5f0e6] flex items-center gap-2 font-mono text-[11px] border border-[#c89346]/40 px-3 py-1.5 rounded-sm hover:border-[#c89346] transition-all">
      <span>CART</span>
      <span id="cart-badge" class="text-[10px] text-[#c89346] font-bold">(0)</span>
    </button>
  </nav>
</header>