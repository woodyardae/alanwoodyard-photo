---
// src/components/Header.astro
---
<header class="w-full border-b gallery-hairline py-6 px-6 md:px-12 flex justify-between items-baseline bg-[#0c0c0e]/90 backdrop-blur-md sticky top-0 z-40">
  <div class="flex items-baseline gap-4">
    <a href="/" class="text-lg md:text-xl font-serif tracking-widest uppercase text-zinc-100 hover:text-white transition-colors">
      Alan Woodyard
    </a>
    <span class="text-[10px] tracking-widest uppercase text-zinc-500 font-mono hidden sm:inline">Fine Art Photography</span>
  </div>
  
  <nav class="flex items-center gap-6 md:gap-8 text-xs tracking-widest uppercase text-zinc-400 font-light">
    <a href="/" class="hover:text-zinc-100 transition-colors">Exhibition</a>
    <a href="/about" class="hover:text-zinc-100 transition-colors">About & Provenance</a>
    <a href="https://faa.alanwoodyard.photo" target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-zinc-300 transition-colors hidden md:inline">FAA Archive &nearr;</a>
    <button id="cart-toggle" class="text-zinc-300 hover:text-white flex items-center gap-1.5 font-mono text-[11px]">
      <span>CART</span>
      <span id="cart-badge" class="text-[10px] text-zinc-400">(0)</span>
    </button>
  </nav>
</header>