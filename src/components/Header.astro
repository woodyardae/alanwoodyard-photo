---
// src/components/Header.astro
---
<header class="w-full border-b border-white/[0.08] py-7 px-6 md:px-16 flex justify-between items-center bg-[#0d0c0a]/95 backdrop-blur-md sticky top-0 z-40">
  <a href="/" class="text-2xl md:text-3xl font-serif tracking-[0.14em] uppercase text-[#f7f4ee] hover:text-[#dfb872] transition-colors">
    Alan Woodyard
  </a>
  
  <nav class="flex items-center gap-8 md:gap-12 text-xs tracking-[0.22em] uppercase text-[#a89f91] font-sans font-medium">
    <a href="/" class="hover:text-[#f7f4ee] transition-colors">Work</a>
    <a href="/about" class="hover:text-[#f7f4ee] transition-colors">Contact</a>
    <button id="cart-toggle" class="text-[#f7f4ee] hover:text-[#dfb872] flex items-center gap-2.5 font-mono text-xs border border-white/[0.12] px-4 py-2 rounded-sm hover:border-[#c5a059] transition-all">
      <span>CART</span>
      <span id="cart-badge" class="text-[11px] text-[#c5a059] font-bold">(0)</span>
    </button>
  </nav>
</header>