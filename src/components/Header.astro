---
---

<header class="w-full border-b border-[var(--theme-border)] px-6 lg:px-10 py-5 flex items-center justify-between transition-colors duration-500">
  <a href="/" class="flex items-center gap-3.5 group">
    <!-- Clean geometric AW monogram -->
    <img src="/logo-mark-light.png" alt="Alan Woodyard" class="w-7 h-7 object-contain opacity-90 group-hover:opacity-100 transition-opacity" />
    
    <span class="font-serif text-sm tracking-[0.22em] text-[var(--theme-text)] uppercase font-normal">
      Alan Woodyard
    </span>
  </a>

  <div class="flex items-center gap-8">
    <nav class="flex items-center gap-8 font-mono text-xs tracking-wider text-[var(--theme-text-muted)]">
      <a href="/artworks" class="hover:text-[var(--theme-accent)] transition-colors">Artworks</a>
      <a href="/garden" class="hover:text-[var(--theme-accent)] transition-colors">Garden</a>
    </nav>

    <!-- Cart Trigger -->
    <button 
      type="button" 
      id="openCartTrigger" 
      class="flex items-center gap-2 font-mono text-xs tracking-wider text-[var(--theme-text-muted)] hover:text-[var(--theme-accent)] transition-colors border-l border-[var(--theme-border)] pl-6"
      aria-label="Open Cart"
    >
      <span>CART</span>
      <span id="cartCountBadge" class="hidden px-1.5 py-0.2 bg-[var(--theme-accent)] text-[var(--theme-bg)] text-[10px] font-bold rounded-full">
        0
      </span>
    </button>
  </div>
</header>

<script>
  import { $cartCount, $isCartOpen } from '../stores/cart';

  const trigger = document.getElementById('openCartTrigger');
  const badge = document.getElementById('cartCountBadge');

  trigger?.addEventListener('click', () => $isCartOpen.set(true));

  $cartCount.subscribe((count) => {
    if (badge) {
      if (count > 0) {
        badge.textContent = count.toString();
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }
  });
</script>