---
// src/components/Header.astro
---
<header class="w-full border-b brass-border py-6 px-6 md:px-12 flex justify-between items-baseline bg-[#14110f]/95 backdrop-blur-md sticky top-0 z-40">
  <div class="flex items-baseline gap-4">
    <a href="/" class="text-lg md:text-xl font-sans tracking-[0.25em] uppercase text-[#f5f0e6] hover:text-[#dfa85b] transition-colors">
      Alan Woodyard
    </a>
    <span class="text-[9px] tracking-[0.25em] uppercase text-[#c89346] font-mono hidden sm:inline">Fine Art Photography</span>
  </div>
  
  <nav class="flex items-center gap-6 md:gap-8 text-xs tracking-[0.18em] uppercase text-[#9e9382] font-medium">
    <a href="/" class="hover:text-[#f5f0e6] transition-colors">Exhibition</a>
    <a href="/about" class="hover:text-[#f5f0e6] transition-colors">Provenance</a>
    <a href="https://faa.alanwoodyard.photo" target="_blank" rel="noopener noreferrer" class="text-[#c89346]/80 hover:text-[#dfa85b] transition-colors hidden md:inline">FAA Archive &nearr;</a>
    <button id="cart-toggle" class="text-[#9e9382] hover:text-[#f5f0e6] flex items-center gap-1.5 font-mono text-[11px] border border-[#c89346]/30 px-3 py-1 rounded-sm">
      <span>CART</span>
      <span id="cart-badge" class="text-[10px] text-[#c89346]">(0)</span>
    </button>
  </nav>
</header>