---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { safeAdminReturnPath } from '../../lib/admin-session';

const redirectParam = safeAdminReturnPath(
  Astro.url.searchParams.get('redirect') || '/admin/merch-studio/',
);
const errorParam = Astro.url.searchParams.get('error') || '';
const serverErrors: Record<string, string> = {
  unconfigured: 'The admin password is not set on the server.',
  session: 'That session was rejected. Enter the passphrase again.',
};
const serverError = serverErrors[errorParam] || '';
---

<Layout title="Admin Sign In | Alan Woodyard Photography" theme="walnut">
  <main class="min-h-screen flex items-center justify-center p-6 bg-[var(--theme-bg)] text-[var(--awp-text)]">
    <div class="w-full max-w-md bg-[var(--awp-surface)] border border-[var(--awp-border)] p-8 shadow-2xl space-y-6">

      <div class="text-center space-y-2">
        <span class="text-[11px] font-mono tracking-[0.25em] uppercase text-[var(--awp-accent)] block">
          Studio sign in
        </span>
        <h1 class="text-2xl font-serif text-[var(--awp-text)] font-light">
          Alan Woodyard Studio
        </h1>
        <p class="text-xs font-mono text-[var(--awp-text-muted)]">
          Sign in to run catalog and fulfillment tools.
        </p>
      </div>

      {serverError && (
        <div id="serverError" class="p-3 border border-[var(--awp-border)] bg-[var(--theme-bg)] text-[var(--awp-text)] font-mono text-xs" role="alert">
          {serverError}
        </div>
      )}

      <form id="loginForm" class="space-y-4">
        <input type="hidden" id="redirectInput" value={redirectParam} />

        <div class="space-y-1.5">
          <label class="block text-xs font-mono uppercase tracking-wider text-[var(--awp-text-muted)]" for="adminPassword">
            Passphrase
          </label>
          <input
            type="password"
            id="adminPassword"
            required
            autofocus
            autocomplete="current-password"
            class="w-full px-4 py-3 bg-[var(--theme-bg)] border border-[var(--awp-border)] text-[var(--awp-text)] font-mono text-sm focus:border-[var(--awp-accent)] focus:outline-none"
          />
        </div>

        <button
          type="submit"
          id="loginBtn"
          class="w-full py-3.5 bg-[var(--awp-accent)] text-[var(--theme-bg)] font-mono text-xs uppercase tracking-widest font-bold transition-colors active:scale-[0.99]"
        >
          Enter studio
        </button>

        <p id="errorMsg" class="text-xs font-mono text-[var(--awp-text)] text-center min-h-[1.25rem]" role="alert"></p>
      </form>

      <div class="border-t border-[var(--awp-border)] pt-4 text-center">
        <a href="/" class="text-xs font-mono text-[var(--awp-text-muted)] hover:text-[var(--awp-text)]">
          &larr; Return to the public gallery
        </a>
      </div>

    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('loginForm') as HTMLFormElement;
  const passwordInput = document.getElementById('adminPassword') as HTMLInputElement;
  const redirectInput = document.getElementById('redirectInput') as HTMLInputElement;
  const loginBtn = document.getElementById('loginBtn') as HTMLButtonElement;
  const errorMsg = document.getElementById('errorMsg')!;

  function restoreButton(label: string | null) {
    loginBtn.disabled = false;
    loginBtn.textContent = label;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const originalLabel = loginBtn.textContent;
    loginBtn.disabled = true;
    loginBtn.textContent = 'Checking passphrase...';
    errorMsg.textContent = '';

    try {
      const res = await fetch('/api/admin/login', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          password: passwordInput.value,
          redirect: redirectInput.value,
        }),
      });

      let data: { success?: boolean; redirect?: string; error?: string } = {};
      try {
        data = await res.json();
      } catch {
        errorMsg.textContent = 'The sign-in request failed. Try again.';
        restoreButton(originalLabel);
        return;
      }

      const nextUrl = typeof data.redirect === 'string' ? data.redirect : '';
      if (!res.ok || !data.success || !nextUrl.startsWith('/admin/') || nextUrl.startsWith('/admin/login')) {
        errorMsg.textContent = data.error || 'That passphrase was rejected.';
        restoreButton(originalLabel);
        return;
      }

      const probe = await fetch('/api/admin/session', { credentials: 'same-origin' });
      if (!probe.ok) {
        errorMsg.textContent = 'Sign-in did not stick. The browser did not keep the session cookie.';
        restoreButton(originalLabel);
        return;
      }

      window.location.assign(nextUrl);
    } catch {
      errorMsg.textContent = 'The sign-in request failed. Try again.';
      restoreButton(originalLabel);
    }
  });
</script>
