---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import {
  PHOTO_RATIO_PRODUCTS,
  SWS_RATIO_PRODUCTS,
  RATIO_KEYS,
  RATIO_MAP,
  RATIO_LABELS,
} from '../../lib/merch-studio-shared';

const artworks = await getCollection('artworks');

const photoItems = artworks.map((art) => ({
  id: art.id,
  store: 'photo' as const,
  title: art.data.title,
  category: art.data.collections?.[0] || art.data.mood || 'Fine Art Photography',
  img: `/images/artworks/${art.id}.webp`,
  width: art.data.capture?.native_dimensions?.width || 6000,
  height: art.data.capture?.native_dimensions?.height || 4000,
  crops: art.data.merch_crops || {},
  approved: art.data.merch_approved || [],
  rejected: Boolean(art.data.merch_rejected),
}));

let swsItems: any[] = [];
try {
  const swsQueuePath = path.resolve('src/data/sws-queue.json');
  if (fs.existsSync(swsQueuePath)) {
    const raw = fs.readFileSync(swsQueuePath, 'utf8').replace(/^\uFEFF/, '');
    const parsed = JSON.parse(raw);
    if (Array.isArray(parsed)) {
      swsItems = parsed.map((item) => ({
        id: item.id,
        store: 'sws' as const,
        title: item.title,
        category: item.category || 'SeeWhatSticks',
        img: item.img,
        width: item.width || 2048,
        height: item.height || 2048,
        crops: item.crops || {},
        approved: item.approved || [],
        rejected: Boolean(item.rejected),
      }));
    }
  }
} catch {
  swsItems = [];
}

const catalogData = [...photoItems, ...swsItems];
---

<Layout title="Unified Merch Framing & Approval Queue">
  <!-- Live Browser Diagnostic Console -->
  <div id="runtimeCrashBanner" style="display: none;" class="fixed top-0 left-0 right-0 z-50 bg-red-900 border-b border-red-500 text-white p-4 font-mono text-xs"></div>

  <!-- Isolated Auth Gate -->
  <div id="authGate" class="w-full pt-16 pb-24 px-6 flex justify-center text-[#f7f4ee]">
    <div class="w-full max-w-sm bg-[#120f0d] border border-white/[0.1] p-8 rounded shadow-2xl">
      <h1 class="font-serif text-xl mb-1 text-[#c5a059]">Unified Merch Studio Access</h1>
      <p class="text-xs font-mono text-[#a89f91] mb-6">Single login for Photo &amp; SeeWhatSticks.store queue.</p>

      <div id="gateErr" style="display: none;" class="mb-4 p-3 bg-red-950/60 border border-red-500/40 text-red-200 text-xs font-mono rounded">
        Incorrect master password.
      </div>

      <div class="space-y-4">
        <div>
          <input
            type="password"
            id="gatePass"
            autocomplete="current-password"
            placeholder="Master Password"
            class="w-full bg-[#050404] border border-white/[0.15] focus:border-[#c5a059] p-3 text-sm font-mono text-[#f7f4ee] rounded outline-none"
          />
        </div>
        <button
          type="button"
          id="unlockBtn"
          class="w-full py-3.5 bg-[#c5a059] hover:bg-[#d9b36c] active:bg-[#967434] text-[#0a0808] font-mono text-xs font-bold uppercase tracking-wider rounded transition cursor-pointer select-none"
        >
          Unlock Unified Queue &rarr;
        </button>
      </div>
    </div>
  </div>

  <!-- Studio Main Application -->
  <main id="studioApp" style="display: none;" class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8 text-[#f7f4ee]">
    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/[0.08] pb-4 mb-5">
      <div>
        <h1 class="text-xl sm:text-2xl font-serif text-[var(--theme-text)]">Unified Merch Approval Queue</h1>
        <p class="text-[11px] font-mono text-[var(--theme-text-muted)] mt-0.5">Single-login framing, DPI preflight &amp; SKU triage across Alan Woodyard Photo + SeeWhatSticks.store.</p>
      </div>
      <div class="flex items-center gap-4">
        <a href="/admin/syndication/" class="text-xs font-mono text-[var(--theme-text-muted)] hover:text-white">Syndication Desk &rarr;</a>
        <button type="button" id="lockBtn" class="text-xs font-mono text-[var(--theme-text-muted)] hover:text-white cursor-pointer">Lock Studio</button>
        <a href="/" class="text-xs font-mono text-[var(--theme-accent)] hover:underline">&larr; Storefront</a>
      </div>
    </div>

    <!-- Top Unified Store & Queue Filter Bar -->
    <div class="bg-[#120f0d] border border-white/[0.08] rounded p-3 sm:p-4 mb-5 space-y-3">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <!-- Store Switcher -->
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-[10px] font-mono uppercase tracking-wider text-[#a89f91] mr-1">Store:</span>
          <button type="button" class="store-filter px-2.5 py-1.5 rounded bg-white/[0.18] text-xs font-mono text-white font-bold cursor-pointer" data-store="all">All (<span id="count-store-all">0</span>)</button>
          <button type="button" class="store-filter px-2.5 py-1.5 rounded bg-white/[0.05] hover:bg-white/[0.1] text-xs font-mono text-[#c5a059] cursor-pointer" data-store="photo">Photo (<span id="count-store-photo">0</span>)</button>
          <button type="button" class="store-filter px-2.5 py-1.5 rounded bg-white/[0.05] hover:bg-white/[0.1] text-xs font-mono text-[#5cc8ff] cursor-pointer" data-store="sws">SeeWhatSticks (<span id="count-store-sws">0</span>)</button>
        </div>

        <!-- Queue Status Tabs -->
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-[10px] font-mono uppercase tracking-wider text-[#a89f91] mr-1">Queue:</span>
          <button type="button" class="queue-filter px-2.5 py-1.5 rounded bg-[#c5a059] text-black text-xs font-mono font-bold cursor-pointer" data-queue="needs_review">Needs Review (<span id="count-queue-needs_review">0</span>)</button>
          <button type="button" class="queue-filter px-2.5 py-1.5 rounded bg-white/[0.05] hover:bg-white/[0.1] text-xs font-mono text-emerald-300 cursor-pointer" data-queue="approved">Approved (<span id="count-queue-approved">0</span>)</button>
          <button type="button" class="queue-filter px-2.5 py-1.5 rounded bg-white/[0.05] hover:bg-white/[0.1] text-xs font-mono text-rose-300 cursor-pointer" data-queue="rejected">Rejected (<span id="count-queue-rejected">0</span>)</button>
        </div>
      </div>

      <!-- Prev / Dropdown / Next Stepper -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 pt-2 border-t border-white/[0.06]">
        <div class="flex items-center gap-2">
          <button type="button" id="prev-item-btn" class="px-3 py-2 rounded bg-white/[0.06] hover:bg-white/[0.14] active:scale-[0.98] text-xs font-mono text-[#f7f4ee] cursor-pointer shrink-0">&larr; Prev</button>
          <div class="flex items-center gap-2 px-2 py-1 rounded bg-[#080706] border border-white/[0.08] text-[11px] font-mono shrink-0">
            <span id="item-store-badge" class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-[#c5a059]/20 text-[#c5a059]">PHOTO</span>
            <span id="queue-pos-label" class="text-[#f7f4ee]">0 / 0</span>
          </div>
          <button type="button" id="next-item-btn" class="px-3 py-2 rounded bg-white/[0.06] hover:bg-white/[0.14] active:scale-[0.98] text-xs font-mono text-[#f7f4ee] cursor-pointer shrink-0">Next &rarr;</button>
        </div>

        <select id="artwork-select" class="flex-1 bg-[#080706] border border-white/[0.12] rounded p-2 text-sm font-mono text-[#f7f4ee]"></select>
      </div>
    </div>

    <!-- Main Workspace: Canvas top on mobile (order-1), Rubric/Details left on desktop -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
      <!-- Viewport & Quick-Tap Mobile Actions (Top on mobile, right 2 cols on desktop) -->
      <div class="order-1 lg:order-2 lg:col-span-2 space-y-4">
        <!-- Quick-Tap Aspect Ratio Pills -->
        <div class="bg-[#120f0d] border border-white/[0.06] rounded p-2.5">
          <div class="flex items-center justify-between mb-1.5 px-1">
            <span class="text-[10px] font-mono uppercase tracking-wider text-[#a89f91]">Quick Aspect Ratio Switcher</span>
            <span id="item-category-label" class="text-[10px] font-mono text-[#c5a059]">--</span>
          </div>
          <div id="ratio-pills" class="flex items-center gap-1.5 overflow-x-auto pb-1">
            {RATIO_KEYS.map((rk) => (
              <button
                type="button"
                class="ratio-pill shrink-0 px-2.5 py-1.5 rounded border border-white/[0.1] bg-[#080706] text-xs font-mono text-[#f7f4ee] hover:border-[#c5a059] cursor-pointer transition"
                data-ratio-key={rk}
              >
                <span class="ratio-pill-label">{rk}</span>
                <span class="ratio-pill-check hidden ml-1 text-emerald-400">✓</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Touch Canvas -->
        <div class="flex flex-col items-center justify-center bg-[#0a0908] border border-white/[0.06] rounded p-3 sm:p-5 min-h-[380px] sm:min-h-[500px]">
          <div
            id="canvasWrapper"
            class="relative w-full flex items-center justify-center p-2 sm:p-3 rounded bg-[#070606] border border-white/[0.08] select-none"
            style="touch-action: none !important; -webkit-touch-callout: none; -webkit-user-select: none; user-select: none;"
          >
            <canvas
              id="cropCanvas"
              style="touch-action: none !important;"
              class="cursor-grab active:cursor-grabbing max-w-full max-h-[520px] shadow-2xl border border-white/[0.1] rounded select-none"
            ></canvas>
          </div>
        </div>

        <!-- Mobile-Friendly Zoom + Primary Action Strip -->
        <div class="bg-[#141210] border border-white/[0.08] p-4 rounded space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center gap-3">
            <div class="flex-1">
              <div class="flex justify-between text-[11px] font-mono text-[var(--theme-text-muted)] mb-1">
                <span>Zoom (1 finger drag / 2 finger pinch)</span>
                <span id="zoom-val">1.00x</span>
              </div>
              <input type="range" id="zoom-slider" min="1" max="3" step="0.01" value="1" class="w-full accent-[var(--theme-accent)]" />
            </div>
            <label class="flex items-center gap-2 text-xs font-mono text-[#d4cdbf] cursor-pointer shrink-0 select-none">
              <input type="checkbox" id="auto-advance-cb" checked class="accent-[var(--theme-accent)]" />
              <span>Auto-advance ratios</span>
            </label>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1">
            <button id="save-btn" type="button" class="bg-[var(--theme-accent)] text-black font-mono text-xs uppercase tracking-wider py-3.5 px-3 rounded font-bold hover:opacity-90 transition active:scale-[0.98] cursor-pointer">
              &check; Save Ratio
            </button>
            <button id="save-next-btn" type="button" class="bg-emerald-600 hover:bg-emerald-500 text-white font-mono text-xs uppercase tracking-wider py-3.5 px-3 rounded font-bold transition active:scale-[0.98] cursor-pointer">
              Approve &amp; Next SKU &rarr;
            </button>
            <button id="reject-btn" type="button" class="bg-rose-900/70 hover:bg-rose-800 border border-rose-500/40 text-rose-100 font-mono text-xs uppercase tracking-wider py-3.5 px-3 rounded font-bold transition active:scale-[0.98] cursor-pointer">
              &times; Reject SKU
            </button>
          </div>
          <p id="status-msg" class="text-xs font-mono text-center min-h-[1rem]"></p>
        </div>
      </div>

      <!-- Left Controls Panel: Metadata, Full Ratio Selector & Product Rubric -->
      <div class="order-2 lg:order-1 space-y-5">
        <div class="bg-[#141210] border border-white/[0.06] p-4 rounded space-y-2">
          <label class="block text-xs font-mono uppercase tracking-wider text-[var(--theme-text-muted)]">1. Asset Specs</label>
          <div id="nativeResIndicator" class="text-xs font-mono text-[#a89f91] flex justify-between">
            <span>Native Resolution:</span>
            <span id="nativeResVal" class="text-[#f7f4ee]">--</span>
          </div>
          <div class="text-xs font-mono text-[#a89f91] flex justify-between">
            <span>Storefront Rubric:</span>
            <span id="storeRubricLabel" class="text-[#f7f4ee]">--</span>
          </div>
        </div>

        <div class="bg-[#141210] border border-white/[0.06] p-4 rounded">
          <label class="block text-xs font-mono uppercase tracking-wider text-[var(--theme-text-muted)] mb-2">2. Aspect Ratio Cluster</label>
          <select id="ratio-select" class="w-full bg-[#080706] border border-white/[0.1] rounded p-2.5 text-sm font-mono text-[#f7f4ee]">
            {RATIO_KEYS.map((rk) => (
              <option value={rk} data-ratio={String(RATIO_MAP[rk])}>{RATIO_LABELS[rk]}</option>
            ))}
          </select>
        </div>

        <!-- Product Rubric & Vendor Batch Selectors -->
        <div class="space-y-3 bg-[#141210] border border-white/[0.06] p-4 rounded">
          <div class="flex items-center justify-between pb-1 border-b border-white/[0.04]">
            <label class="block text-xs font-mono uppercase tracking-wider text-[var(--theme-text-muted)]">3. Product Rubric</label>
            <button type="button" id="toggle-all-btn" class="text-[10px] font-mono text-[var(--theme-accent)] hover:underline cursor-pointer">Toggle All</button>
          </div>

          <div class="flex flex-wrap gap-1.5 pt-1">
            <button type="button" class="vendor-filter px-2 py-1 rounded bg-white/[0.15] text-[10px] font-mono text-white cursor-pointer" data-vendor="all">All Vendors</button>
            <button type="button" class="vendor-filter px-2 py-1 rounded bg-white/[0.04] hover:bg-white/[0.1] text-[10px] font-mono text-[#c5a059] cursor-pointer" data-vendor="Prodigi">Prodigi</button>
            <button type="button" class="vendor-filter px-2 py-1 rounded bg-white/[0.04] hover:bg-white/[0.1] text-[10px] font-mono text-[#5cc8ff] cursor-pointer" data-vendor="Printify">Printify</button>
            <button type="button" class="vendor-filter px-2 py-1 rounded bg-white/[0.04] hover:bg-white/[0.1] text-[10px] font-mono text-[#ff80bf] cursor-pointer" data-vendor="Printful">Printful</button>
            <button type="button" class="vendor-filter px-2 py-1 rounded bg-white/[0.04] hover:bg-white/[0.1] text-[10px] font-mono text-[#8ce99a] cursor-pointer" data-vendor="Gooten">Gooten</button>
            <button type="button" class="vendor-filter px-2 py-1 rounded bg-white/[0.04] hover:bg-white/[0.1] text-[10px] font-mono text-[#ffd43b] cursor-pointer" data-vendor="Gelato">Gelato</button>
            <button type="button" class="vendor-filter px-2 py-1 rounded bg-white/[0.04] hover:bg-white/[0.1] text-[10px] font-mono text-[#ff922b] cursor-pointer" data-vendor="Displate">Displate</button>
          </div>

          <div id="product-rubric-container" class="space-y-2 max-h-80 overflow-y-auto pr-1"></div>
        </div>
      </div>
    </div>
  </main>

  <!-- SCRIPT 1: AUTHENTICATION ENGINE -->
  <script is:inline>
    (function() {
      window.onerror = function(msg, url, line) {
        var banner = document.getElementById('runtimeCrashBanner');
        if (banner) {
          banner.style.display = 'block';
          banner.innerText = 'Script Error: ' + msg + ' (Line: ' + line + ')';
        }
      };

      var MASTER_KEY = '30S!g%zlxg&gJ2is';
      var STORAGE_KEY = 'aw_studio_auth';

      function unlock() {
        var input = document.getElementById('gatePass');
        var err = document.getElementById('gateErr');
        var val = (input ? input.value : '').trim();

        if (val === MASTER_KEY) {
          if (err) err.style.display = 'none';
          try { localStorage.setItem(STORAGE_KEY, MASTER_KEY); } catch(e) {}
          try { sessionStorage.setItem(STORAGE_KEY, MASTER_KEY); } catch(e) {}
          document.cookie = 'aw_studio_auth=' + encodeURIComponent(MASTER_KEY) + '; path=/; max-age=31536000; SameSite=Lax';

          var gate = document.getElementById('authGate');
          var app = document.getElementById('studioApp');
          if (gate) gate.style.display = 'none';
          if (app) app.style.display = 'block';

          if (window.bootStudioEngine) {
            window.bootStudioEngine();
          }
        } else {
          if (err) {
            err.innerText = val.length === 0 ? 'Please enter master password.' : 'Incorrect master password.';
            err.style.display = 'block';
          }
          if (input) {
            input.value = '';
            input.focus();
          }
        }
      }

      window.runUnlock = unlock;

      var saved = '';
      try { saved = localStorage.getItem(STORAGE_KEY) || sessionStorage.getItem(STORAGE_KEY) || ''; } catch(e) {}
      if (saved === MASTER_KEY) {
        var gate = document.getElementById('authGate');
        var app = document.getElementById('studioApp');
        if (gate) gate.style.display = 'none';
        if (app) app.style.display = 'block';
        window.isAuthedOnLoad = true;
      }

      var btn = document.getElementById('unlockBtn');
      if (btn) btn.onclick = unlock;

      var passInput = document.getElementById('gatePass');
      if (passInput) {
        passInput.onkeydown = function(e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            unlock();
          }
        };
      }

      var lockBtn = document.getElementById('lockBtn');
      if (lockBtn) {
        lockBtn.onclick = function() {
          try { localStorage.removeItem(STORAGE_KEY); } catch(e) {}
          try { sessionStorage.removeItem(STORAGE_KEY); } catch(e) {}
          document.cookie = 'aw_studio_auth=; path=/; max-age=0;';
          var gate = document.getElementById('authGate');
          var app = document.getElementById('studioApp');
          if (app) app.style.display = 'none';
          if (gate) gate.style.display = 'flex';
          var pass = document.getElementById('gatePass');
          if (pass) pass.value = '';
        };
      }
    })();
  </script>

  <!-- SCRIPT 2: UNIFIED MOBILE QUEUE ENGINE -->
  <script define:vars={{ catalogData, PHOTO_RATIO_PRODUCTS, SWS_RATIO_PRODUCTS, RATIO_KEYS }}>
    const MASTER_KEY = '30S!g%zlxg&gJ2is';
    let isStudioInitialized = false;
    let currentImg = new Image();
    let panX = 0;
    let panY = 0;
    let zoom = 1.0;
    let activeVendorFilter = 'all';
    let activeStoreFilter = 'all';
    let activeQueueFilter = 'needs_review';
    let filteredQueue = [];

    const artworkSelect = document.getElementById('artwork-select');
    const ratioSelect = document.getElementById('ratio-select');
    const zoomSlider = document.getElementById('zoom-slider');
    const zoomVal = document.getElementById('zoom-val');
    const nativeResVal = document.getElementById('nativeResVal');
    const storeRubricLabel = document.getElementById('storeRubricLabel');
    const itemStoreBadge = document.getElementById('item-store-badge');
    const itemCategoryLabel = document.getElementById('item-category-label');
    const queuePosLabel = document.getElementById('queue-pos-label');
    const prevItemBtn = document.getElementById('prev-item-btn');
    const nextItemBtn = document.getElementById('next-item-btn');
    const autoAdvanceCb = document.getElementById('auto-advance-cb');
    const canvasWrapper = document.getElementById('canvasWrapper');
    const canvas = document.getElementById('cropCanvas');
    const ctx = canvas.getContext('2d');
    const rubricContainer = document.getElementById('product-rubric-container');
    const toggleAllBtn = document.getElementById('toggle-all-btn');
    const saveBtn = document.getElementById('save-btn');
    const saveNextBtn = document.getElementById('save-next-btn');
    const rejectBtn = document.getElementById('reject-btn');
    const statusMsg = document.getElementById('status-msg');

    function getItemStatus(item) {
      if (!item) return 'needs_review';
      if (item.rejected || (item.crops && item.crops.__rejected === true)) {
        return 'rejected';
      }
      const cropKeys = Object.keys(item.crops || {}).filter((k) => k !== '__rejected');
      if (cropKeys.length > 0 || (Array.isArray(item.approved) && item.approved.length > 0)) {
        return 'approved';
      }
      return 'needs_review';
    }

    function getSelectedArtwork() {
      if (!filteredQueue.length) return null;
      return filteredQueue.find((a) => a.id === artworkSelect.value) || filteredQueue[0];
    }

    function updateFilterCounts() {
      const storeScoped = activeStoreFilter === 'all'
        ? catalogData
        : catalogData.filter((i) => i.store === activeStoreFilter);

      const storeAllEl = document.getElementById('count-store-all');
      const storePhotoEl = document.getElementById('count-store-photo');
      const storeSwsEl = document.getElementById('count-store-sws');
      if (storeAllEl) storeAllEl.textContent = String(catalogData.length);
      if (storePhotoEl) storePhotoEl.textContent = String(catalogData.filter((i) => i.store === 'photo').length);
      if (storeSwsEl) storeSwsEl.textContent = String(catalogData.filter((i) => i.store === 'sws').length);

      let nr = 0;
      let ap = 0;
      let rj = 0;
      storeScoped.forEach((item) => {
        const st = getItemStatus(item);
        if (st === 'rejected') rj++;
        else if (st === 'approved') ap++;
        else nr++;
      });

      const qNrEl = document.getElementById('count-queue-needs_review');
      const qApEl = document.getElementById('count-queue-approved');
      const qRjEl = document.getElementById('count-queue-rejected');
      if (qNrEl) qNrEl.textContent = String(nr);
      if (qApEl) qApEl.textContent = String(ap);
      if (qRjEl) qRjEl.textContent = String(rj);
    }

    function rebuildQueue(preserveId) {
      updateFilterCounts();
      filteredQueue = catalogData.filter((item) => {
        if (activeStoreFilter !== 'all' && item.store !== activeStoreFilter) return false;
        return getItemStatus(item) === activeQueueFilter;
      });

      const targetId = preserveId || artworkSelect.value;
      artworkSelect.innerHTML = '';

      if (!filteredQueue.length) {
        const opt = document.createElement('option');
        opt.value = '';
        opt.textContent = 'No items in this queue view';
        artworkSelect.appendChild(opt);
      } else {
        filteredQueue.forEach((art) => {
          const opt = document.createElement('option');
          opt.value = art.id;
          const tag = art.store === 'sws' ? '[SWS]' : '[PHOTO]';
          opt.textContent = `${tag} ${art.title}`;
          artworkSelect.appendChild(opt);
        });
        if (targetId && filteredQueue.some((a) => a.id === targetId)) {
          artworkSelect.value = targetId;
        } else {
          artworkSelect.value = filteredQueue[0].id;
        }
      }

      switchPhoto();
    }

    function updateQueueBadges(art) {
      if (!art) {
        if (queuePosLabel) queuePosLabel.textContent = '0 / 0';
        if (itemCategoryLabel) itemCategoryLabel.textContent = 'Empty Queue';
        if (nativeResVal) nativeResVal.textContent = '--';
        if (storeRubricLabel) storeRubricLabel.textContent = '--';
        if (itemStoreBadge) {
          itemStoreBadge.textContent = 'EMPTY';
          itemStoreBadge.className = 'px-1.5 py-0.5 rounded text-[10px] font-bold bg-white/10 text-[#a89f91]';
        }
        if (rejectBtn) rejectBtn.textContent = '× Reject SKU';
        return;
      }

      const idx = filteredQueue.findIndex((a) => a.id === art.id);
      if (queuePosLabel) {
        queuePosLabel.textContent = `${idx + 1} / ${filteredQueue.length}`;
      }
      if (itemCategoryLabel) {
        itemCategoryLabel.textContent = art.category || '--';
      }
      if (nativeResVal) {
        nativeResVal.textContent = `${art.width} × ${art.height} px`;
      }
      if (storeRubricLabel) {
        storeRubricLabel.textContent = art.store === 'sws' ? 'SeeWhatSticks.store POD' : 'Alan Woodyard Fine Art';
      }
      if (itemStoreBadge) {
        if (art.store === 'sws') {
          itemStoreBadge.textContent = 'SWS';
          itemStoreBadge.className = 'px-1.5 py-0.5 rounded text-[10px] font-bold bg-[#5cc8ff]/20 text-[#5cc8ff]';
        } else {
          itemStoreBadge.textContent = 'PHOTO';
          itemStoreBadge.className = 'px-1.5 py-0.5 rounded text-[10px] font-bold bg-[#c5a059]/20 text-[#c5a059]';
        }
      }
      if (rejectBtn) {
        rejectBtn.textContent = getItemStatus(art) === 'rejected' ? '↺ Restore SKU' : '× Reject SKU';
      }
    }

    function updateRatioPills(art) {
      const activeKey = ratioSelect.value;
      document.querySelectorAll('.ratio-pill').forEach((pill) => {
        const rk = pill.getAttribute('data-ratio-key');
        const checkEl = pill.querySelector('.ratio-pill-check');
        const hasCrop = Boolean(art && art.crops && art.crops[rk]);
        if (checkEl) {
          if (hasCrop) checkEl.classList.remove('hidden');
          else checkEl.classList.add('hidden');
        }
        if (rk === activeKey) {
          pill.classList.add('border-[#c5a059]', 'bg-[#c5a059]/20', 'text-[#f7f4ee]');
          pill.classList.remove('border-white/[0.1]', 'bg-[#080706]');
        } else {
          pill.classList.remove('border-[#c5a059]', 'bg-[#c5a059]/20', 'text-[#f7f4ee]');
          pill.classList.add('border-white/[0.1]', 'bg-[#080706]');
        }
      });
    }

    function renderRubric() {
      const ratioKey = ratioSelect.value;
      const art = getSelectedArtwork();
      updateQueueBadges(art);
      updateRatioPills(art);

      if (!art) {
        rubricContainer.innerHTML = '<p class="text-xs font-mono text-[var(--theme-text-muted)]">Select or change queue filters above to inspect items.</p>';
        return;
      }

      const storeRubricMap = art.store === 'sws' ? SWS_RATIO_PRODUCTS : PHOTO_RATIO_PRODUCTS;
      const allProducts = storeRubricMap[ratioKey] || [];
      const existingCrop = (art.crops && art.crops[ratioKey]) || {};
      const approvedList = existingCrop.approved_products;

      rubricContainer.innerHTML = '';
      if (!allProducts.length) {
        rubricContainer.innerHTML = '<p class="text-xs font-mono text-[var(--theme-text-muted)]">No products mapped for this ratio.</p>';
        return;
      }

      const products = activeVendorFilter === 'all'
        ? allProducts
        : allProducts.filter((p) => p.vendor === activeVendorFilter);

      if (!products.length) {
        rubricContainer.innerHTML = `<p class="text-xs font-mono text-[var(--theme-text-muted)]">No ${activeVendorFilter} items in this ratio.</p>`;
        return;
      }

      products.forEach((prod) => {
        const isChecked = approvedList ? approvedList.includes(prod.id) : true;
        const div = document.createElement('label');
        div.className = 'flex items-center justify-between p-2 rounded bg-white/[0.02] border border-white/[0.04] hover:border-white/[0.1] cursor-pointer text-xs font-mono';

        let vendorBadgeColor = 'text-[#c5a059]';
        if (prod.vendor === 'Printify') vendorBadgeColor = 'text-[#5cc8ff]';
        else if (prod.vendor === 'Printful') vendorBadgeColor = 'text-[#ff80bf]';
        else if (prod.vendor === 'Gooten') vendorBadgeColor = 'text-[#8ce99a]';
        else if (prod.vendor === 'Gelato') vendorBadgeColor = 'text-[#ffd43b]';
        else if (prod.vendor === 'Displate') vendorBadgeColor = 'text-[#ff922b]';

        div.innerHTML = `
          <div class="flex items-center gap-2">
            <input type="checkbox" value="${prod.id}" class="rubric-cb accent-[var(--theme-accent)]" ${isChecked ? 'checked' : ''} />
            <div class="flex flex-col">
              <span class="text-[#f7f4ee]">${prod.name}</span>
              <span class="text-[9px] text-[var(--theme-text-muted)]">Req: ${prod.minPx} @ ${prod.minDpi} DPI</span>
            </div>
          </div>
          <div class="text-right">
            <span class="text-[10px] font-bold ${vendorBadgeColor}">${prod.vendor}</span>
            <span class="text-[10px] text-[var(--theme-text-muted)] block">${prod.retail}</span>
          </div>
        `;
        rubricContainer.appendChild(div);
      });
    }

    // Store Filters
    document.querySelectorAll('.store-filter').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.store-filter').forEach((b) => {
          b.classList.remove('bg-white/[0.18]', 'font-bold');
          b.classList.add('bg-white/[0.05]');
        });
        btn.classList.remove('bg-white/[0.05]');
        btn.classList.add('bg-white/[0.18]', 'font-bold');
        activeStoreFilter = btn.getAttribute('data-store') || 'all';
        rebuildQueue();
      });
    });

    // Queue Filters
    document.querySelectorAll('.queue-filter').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.queue-filter').forEach((b) => {
          b.classList.remove('bg-[#c5a059]', 'text-black', 'font-bold');
          b.classList.add('bg-white/[0.05]');
        });
        btn.classList.remove('bg-white/[0.05]');
        btn.classList.add('bg-[#c5a059]', 'text-black', 'font-bold');
        activeQueueFilter = btn.getAttribute('data-queue') || 'needs_review';
        rebuildQueue();
      });
    });

    // Ratio Quick-Tap Pills
    document.querySelectorAll('.ratio-pill').forEach((pill) => {
      pill.addEventListener('click', () => {
        const rk = pill.getAttribute('data-ratio-key');
        if (rk && ratioSelect.value !== rk) {
          ratioSelect.value = rk;
          switchPhoto();
        }
      });
    });

    // Vendor Filter Buttons
    document.querySelectorAll('.vendor-filter').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.vendor-filter').forEach((b) => {
          b.classList.remove('bg-white/[0.15]');
          b.classList.add('bg-white/[0.04]');
        });
        btn.classList.remove('bg-white/[0.04]');
        btn.classList.add('bg-white/[0.15]');
        activeVendorFilter = btn.getAttribute('data-vendor') || 'all';
        renderRubric();
      });
    });

    toggleAllBtn.addEventListener('click', () => {
      const cbs = document.querySelectorAll('.rubric-cb');
      const allChecked = Array.from(cbs).every((cb) => cb.checked);
      cbs.forEach((cb) => { cb.checked = !allChecked; });
    });

    function stepQueue(delta) {
      if (!filteredQueue.length) return;
      const idx = filteredQueue.findIndex((a) => a.id === artworkSelect.value);
      const nextIdx = (idx + delta + filteredQueue.length) % filteredQueue.length;
      artworkSelect.value = filteredQueue[nextIdx].id;
      switchPhoto();
    }

    if (prevItemBtn) prevItemBtn.addEventListener('click', () => stepQueue(-1));
    if (nextItemBtn) nextItemBtn.addEventListener('click', () => stepQueue(1));

    function getCanvasDims() {
      const opt = ratioSelect.selectedOptions[0];
      const targetRatio = parseFloat(opt ? opt.getAttribute('data-ratio') || '1' : '1');
      const containerWidth = (canvasWrapper && canvasWrapper.clientWidth > 0) ? canvasWrapper.clientWidth : 700;
      const maxW = Math.max(280, Math.min(containerWidth - 32, 700));
      const maxH = 500;
      let w = maxW;
      let h = w / targetRatio;
      if (h > maxH) {
        h = maxH;
        w = h * targetRatio;
      }
      return { w: Math.round(w), h: Math.round(h) };
    }

    function draw() {
      const { w, h } = getCanvasDims();
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
      }

      ctx.fillStyle = '#0a0908';
      ctx.fillRect(0, 0, w, h);

      const art = getSelectedArtwork();
      if (!art) {
        ctx.fillStyle = '#a89f91';
        ctx.font = '13px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('Queue empty for current filter.', w / 2, h / 2);
        ctx.textAlign = 'start';
        return;
      }

      if (currentImg && currentImg.complete && currentImg.naturalWidth > 0) {
        const baseScale = Math.max(w / currentImg.naturalWidth, h / currentImg.naturalHeight);
        const scale = baseScale * zoom;
        const drawW = currentImg.naturalWidth * scale;
        const drawH = currentImg.naturalHeight * scale;

        const drawX = (w - drawW) / 2 + panX;
        const drawY = (h - drawH) / 2 + panY;

        ctx.drawImage(currentImg, drawX, drawY, drawW, drawH);
      } else {
        ctx.fillStyle = '#c5a059';
        ctx.font = '12px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('Loading preview image...', w / 2, h / 2);
        ctx.textAlign = 'start';
      }

      // Safe Bleed Area Guide
      ctx.strokeStyle = 'rgba(197, 160, 89, 0.45)';
      ctx.lineWidth = 1;
      ctx.setLineDash([4, 4]);
      ctx.strokeRect(w * 0.05, h * 0.05, w * 0.9, h * 0.9);
      ctx.setLineDash([]);
    }

    function setZoom(val) {
      zoom = Math.min(Math.max(val, 1.0), 3.0);
      zoomSlider.value = zoom.toFixed(2);
      zoomVal.textContent = zoom.toFixed(2) + 'x';
      draw();
    }

    function switchPhoto() {
      renderRubric();
      const art = getSelectedArtwork();
      const ratioKey = ratioSelect.value;

      if (!art) {
        currentImg = new Image();
        draw();
        return;
      }

      const existingCrop = art.crops ? art.crops[ratioKey] : null;
      if (existingCrop) {
        panX = existingCrop.panX || 0;
        panY = existingCrop.panY || 0;
        zoom = existingCrop.zoom || 1.0;
      } else {
        panX = 0;
        panY = 0;
        zoom = 1.0;
      }

      zoomSlider.value = zoom.toFixed(2);
      zoomVal.textContent = zoom.toFixed(2) + 'x';
      draw();

      const targetUrl = art.img;
      currentImg = new Image();
      currentImg.onload = () => { draw(); };
      currentImg.onerror = () => {
        const { w, h } = getCanvasDims();
        ctx.fillStyle = '#ff6b6b';
        ctx.font = '11px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('Failed to load: ' + targetUrl, w / 2, h / 2);
        ctx.textAlign = 'start';
      };
      currentImg.src = targetUrl;

      if (currentImg.complete && currentImg.naturalWidth > 0) {
        draw();
      }
    }

    // iPad WebKit Gesture Trap
    canvasWrapper.addEventListener('gesturestart', (e) => { e.preventDefault(); }, { passive: false });
    canvasWrapper.addEventListener('gesturechange', (e) => { e.preventDefault(); }, { passive: false });
    canvasWrapper.addEventListener('gestureend', (e) => { e.preventDefault(); }, { passive: false });

    // Touch Engine
    let touchMode = 'none';
    let lastTouchX = 0;
    let lastTouchY = 0;
    let pinchStartDist = 0;
    let pinchBaseZoom = 1.0;

    function getTouchDist(t1, t2) {
      return Math.hypot(t1.clientX - t2.clientX, t1.clientY - t2.clientY);
    }

    canvasWrapper.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        touchMode = 'pan';
        pinchStartDist = 0;
        lastTouchX = e.touches[0].clientX;
        lastTouchY = e.touches[0].clientY;
      } else if (e.touches.length === 2) {
        touchMode = 'pinch';
        pinchStartDist = getTouchDist(e.touches[0], e.touches[1]);
        pinchBaseZoom = zoom;
      }
      e.preventDefault();
    }, { passive: false });

    canvasWrapper.addEventListener('touchmove', (e) => {
      if (touchMode === 'pan' && e.touches.length === 1) {
        const dx = e.touches[0].clientX - lastTouchX;
        const dy = e.touches[0].clientY - lastTouchY;
        panX += dx;
        panY += dy;
        lastTouchX = e.touches[0].clientX;
        lastTouchY = e.touches[0].clientY;
        draw();
      } else if (touchMode === 'pinch' && e.touches.length === 2 && pinchStartDist > 0) {
        const currentDist = getTouchDist(e.touches[0], e.touches[1]);
        const scale = currentDist / pinchStartDist;
        setZoom(pinchBaseZoom * scale);
      }
      e.preventDefault();
    }, { passive: false });

    function onTouchEnd(e) {
      if (e.touches.length === 0) {
        touchMode = 'none';
        pinchStartDist = 0;
      } else if (e.touches.length === 1) {
        touchMode = 'pan';
        pinchStartDist = 0;
        lastTouchX = e.touches[0].clientX;
        lastTouchY = e.touches[0].clientY;
      }
    }

    canvasWrapper.addEventListener('touchend', onTouchEnd, { passive: false });
    canvasWrapper.addEventListener('touchcancel', onTouchEnd, { passive: false });

    // Desktop Mouse Fallback
    let isMouseDown = false;
    let mouseLastX = 0;
    let mouseLastY = 0;

    canvasWrapper.addEventListener('mousedown', (e) => {
      isMouseDown = true;
      mouseLastX = e.clientX;
      mouseLastY = e.clientY;
    });

    window.addEventListener('mousemove', (e) => {
      if (!isMouseDown) return;
      panX += e.clientX - mouseLastX;
      panY += e.clientY - mouseLastY;
      mouseLastX = e.clientX;
      mouseLastY = e.clientY;
      draw();
    });

    window.addEventListener('mouseup', () => { isMouseDown = false; });

    zoomSlider.addEventListener('input', (e) => {
      setZoom(parseFloat(e.target.value));
    });

    artworkSelect.addEventListener('change', switchPhoto);
    ratioSelect.addEventListener('change', switchPhoto);
    window.addEventListener('resize', () => { draw(); });

    async function saveCurrentCrop(advanceToNextItem) {
      const art = getSelectedArtwork();
      if (!art) return;

      saveBtn.disabled = true;
      saveNextBtn.disabled = true;
      statusMsg.className = 'text-xs font-mono text-center text-[var(--theme-text-muted)]';
      statusMsg.innerText = 'Saving crop & products...';

      const approvedProducts = Array.from(document.querySelectorAll('.rubric-cb:checked')).map((cb) => cb.value);
      const excludedProducts = Array.from(document.querySelectorAll('.rubric-cb:not(:checked)')).map((cb) => cb.value);

      const currentIdx = filteredQueue.findIndex((a) => a.id === art.id);
      const nextItemInQueue = currentIdx >= 0 && currentIdx + 1 < filteredQueue.length
        ? filteredQueue[currentIdx + 1].id
        : filteredQueue[0]?.id;

      const payload = {
        artworkId: art.id,
        store: art.store,
        ratioKey: ratioSelect.value,
        authToken: MASTER_KEY,
        crop: {
          panX,
          panY,
          zoom,
          approved_products: approvedProducts,
          excluded_products: excludedProducts,
          approved_at: new Date().toISOString(),
        },
      };

      try {
        const res = await fetch('/api/approve-merch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          art.crops = art.crops || {};
          delete art.crops.__rejected;
          art.crops[ratioSelect.value] = payload.crop;
          art.rejected = false;
          if (approvedProducts.length > 0 && (!art.approved || !art.approved.length)) {
            art.approved = approvedProducts;
          }

          statusMsg.className = 'text-xs font-mono text-center text-emerald-400';
          statusMsg.innerText = `✓ Saved ${ratioSelect.value} framing + ${approvedProducts.length} product(s).`;

          if (advanceToNextItem) {
            rebuildQueue(nextItemInQueue && nextItemInQueue !== art.id ? nextItemInQueue : undefined);
          } else {
            updateRatioPills(art);
            updateFilterCounts();
            if (autoAdvanceCb && autoAdvanceCb.checked) {
              const curR = RATIO_KEYS.indexOf(ratioSelect.value);
              const nextUnset = RATIO_KEYS.slice(curR + 1).find((rk) => !art.crops[rk]) ||
                RATIO_KEYS.find((rk) => !art.crops[rk]);
              if (nextUnset && nextUnset !== ratioSelect.value) {
                ratioSelect.value = nextUnset;
                switchPhoto();
              }
            }
          }
        } else {
          throw new Error(data.error || (await res.text()));
        }
      } catch (err) {
        statusMsg.className = 'text-xs font-mono text-center text-red-400';
        statusMsg.innerText = `Error: ${err.message}`;
      } finally {
        saveBtn.disabled = false;
        saveNextBtn.disabled = false;
      }
    }

    saveBtn.addEventListener('click', () => saveCurrentCrop(false));
    saveNextBtn.addEventListener('click', () => saveCurrentCrop(true));

    rejectBtn.addEventListener('click', async () => {
      const art = getSelectedArtwork();
      if (!art) return;

      const isCurrentlyRejected = getItemStatus(art) === 'rejected';
      const action = isCurrentlyRejected ? 'unreject' : 'reject';
      const currentIdx = filteredQueue.findIndex((a) => a.id === art.id);
      const nextItemInQueue = currentIdx >= 0 && currentIdx + 1 < filteredQueue.length
        ? filteredQueue[currentIdx + 1].id
        : filteredQueue[0]?.id;

      rejectBtn.disabled = true;
      statusMsg.className = 'text-xs font-mono text-center text-[var(--theme-text-muted)]';
      statusMsg.innerText = action === 'reject' ? 'Marking rejected...' : 'Restoring to queue...';

      try {
        const res = await fetch('/api/approve-merch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            artworkId: art.id,
            store: art.store,
            action,
            authToken: MASTER_KEY,
          }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          art.rejected = action === 'reject';
          art.crops = art.crops || {};
          if (art.rejected) art.crops.__rejected = true;
          else delete art.crops.__rejected;

          statusMsg.className = 'text-xs font-mono text-center text-amber-300';
          statusMsg.innerText = action === 'reject' ? `✕ Rejected "${art.title}".` : `↺ Restored "${art.title}".`;
          rebuildQueue(nextItemInQueue && nextItemInQueue !== art.id ? nextItemInQueue : undefined);
        } else {
          throw new Error(data.error || 'Request failed');
        }
      } catch (err) {
        statusMsg.className = 'text-xs font-mono text-center text-red-400';
        statusMsg.innerText = `Error: ${err.message}`;
      } finally {
        rejectBtn.disabled = false;
      }
    });

    async function loadCloudCrops() {
      try {
        const res = await fetch('/api/approve-merch');
        if (res.ok) {
          const remote = await res.json();
          for (const [id, crops] of Object.entries(remote)) {
            const local = catalogData.find((a) => a.id === id);
            if (local) {
              local.crops = { ...local.crops, ...crops };
              if (crops && crops.__rejected === true) {
                local.rejected = true;
              } else if (crops && crops.__rejected === false) {
                local.rejected = false;
              }
            }
          }
          rebuildQueue(artworkSelect.value);
        }
      } catch (e) {}
    }

    function initStudio() {
      rebuildQueue();
      loadCloudCrops();
    }

    window.bootStudioEngine = function() {
      if (!isStudioInitialized) {
        isStudioInitialized = true;
        initStudio();
      }
    };

    if (window.isAuthedOnLoad) {
      window.bootStudioEngine();
    }
  </script>
</Layout>
