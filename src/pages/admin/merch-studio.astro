---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const artworks = await getCollection('artworks');
const catalog = artworks.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="Merchandise Studio | Alan Woodyard Admin" theme="walnut">
  <div class="min-h-screen flex flex-col bg-[#0c0a09] text-[#f7f4ee]">
    
    <!-- Top Header -->
    <header class="sticky top-0 z-40 bg-[#161210]/95 backdrop-blur-md border-b border-white/10 px-4 py-3 sm:px-6">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="px-2 py-0.5 bg-[#c5a059]/20 text-[#dfb872] border border-[#c5a059]/40 text-[10px] font-mono uppercase font-bold rounded">
              Private Studio
            </span>
            <h1 class="text-base sm:text-lg font-serif tracking-wide text-[#f7f4ee]">Merchandise Framing</h1>
          </div>
          <a href="/admin/syndication" class="sm:hidden text-xs font-mono text-[#a89f91]">Syndication &rarr;</a>
        </div>

        <div class="hidden sm:flex items-center gap-4 text-xs font-mono">
          <a href="/admin/syndication" class="text-[#a89f91] hover:text-[#f7f4ee]">Syndication Desk &rarr;</a>
          <a href="/" class="text-[#c5a059] hover:underline" target="_blank">View Live Store ↗</a>
        </div>
      </div>
    </header>

    <!-- Substrate Rail -->
    <nav class="bg-[#100d0c] border-b border-white/[0.08] px-4 py-2.5 overflow-x-auto no-scrollbar">
      <div class="max-w-7xl mx-auto flex items-center gap-2 min-w-max" id="productChips">
        <button type="button" class="prod-chip active px-3.5 py-2 border border-[#c5a059] bg-[#c5a059]/20 text-[#dfb872] text-xs font-mono uppercase transition-colors" data-w="16" data-h="7">
          Desk Pad (16:7)
        </button>
        <button type="button" class="prod-chip px-3.5 py-2 border border-white/10 bg-[#161210] text-[#a89f91] text-xs font-mono uppercase transition-colors" data-w="20" data-h="29">
          Steel Plate (Portrait)
        </button>
        <button type="button" class="prod-chip px-3.5 py-2 border border-white/10 bg-[#161210] text-[#a89f91] text-xs font-mono uppercase transition-colors" data-w="29" data-h="20">
          Steel Plate (Landscape)
        </button>
        <button type="button" class="prod-chip px-3.5 py-2 border border-white/10 bg-[#161210] text-[#a89f91] text-xs font-mono uppercase transition-colors" data-w="4" data-h="5">
          Archival Frame (4:5)
        </button>
        <button type="button" class="prod-chip px-3.5 py-2 border border-white/10 bg-[#161210] text-[#a89f91] text-xs font-mono uppercase transition-colors" data-w="1" data-h="1">
          Square Tile (1:1)
        </button>
        <button type="button" class="prod-chip px-3.5 py-2 border border-white/10 bg-[#161210] text-[#a89f91] text-xs font-mono uppercase transition-colors" data-w="2" data-h="1">
          Canvas Wrap (2:1)
        </button>
      </div>
    </nav>

    <!-- Workspace Grid -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start pb-28 lg:pb-12">
      
      <!-- Left: Interactive Canvas Viewport -->
      <section class="lg:col-span-7 xl:col-span-8 flex flex-col items-center">
        <div 
          class="relative w-full aspect-[4/3] bg-[#050404] border border-white/15 overflow-hidden flex items-center justify-center select-none shadow-2xl" 
          id="viewportContainer"
          style="touch-action: none;"
        >
          <canvas 
            id="cropCanvas" 
            class="max-w-full max-h-full cursor-grab active:cursor-grabbing"
            style="touch-action: none;"
          ></canvas>

          <!-- On-Canvas HUD Controls -->
          <div class="absolute bottom-3 inset-x-3 flex items-center justify-between pointer-events-none gap-2">
            <div class="flex items-center gap-1.5 pointer-events-auto bg-[#0a0808]/90 backdrop-blur-md border border-white/15 p-1 rounded">
              <button 
                type="button" 
                id="hudGridBtn" 
                class="px-2.5 py-1.5 text-[11px] font-mono rounded transition-colors bg-[#c5a059]/30 text-[#dfb872] border border-[#c5a059]"
              >
                Grid: ON
              </button>
              <button 
                type="button" 
                id="hudBleedBtn" 
                class="px-2.5 py-1.5 text-[11px] font-mono rounded transition-colors bg-[#c5a059]/30 text-[#dfb872] border border-[#c5a059]"
              >
                Bleed: ON
              </button>
            </div>

            <div class="flex items-center gap-1 pointer-events-auto bg-[#0a0808]/90 backdrop-blur-md border border-white/15 p-1 rounded text-xs font-mono">
              <button type="button" id="hudZoomOutBtn" class="w-8 h-7 flex items-center justify-center text-base hover:bg-white/10 text-[#f7f4ee] active:scale-95 transition-transform">−</button>
              <span id="hudZoomDisplay" class="px-1 text-[11px] text-[#dfb872] min-w-[3rem] text-center font-bold">1.00x</span>
              <button type="button" id="hudZoomInBtn" class="w-8 h-7 flex items-center justify-center text-base hover:bg-white/10 text-[#f7f4ee] active:scale-95 transition-transform">+</button>
            </div>
          </div>
        </div>

        <div class="w-full mt-3 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] font-mono text-[#8e8577]">
          <p>Two-finger pinch to zoom &bull; Drag to pan &bull; Double-tap to reset</p>
          <p><span class="text-[#f5da9b]">Bleed margin:</span> 5% safe lab cut line</p>
        </div>
      </section>

      <!-- Right: Full Control Panel -->
      <section class="lg:col-span-5 xl:col-span-4 space-y-5 bg-[#14100e] border border-white/10 p-5 rounded-[2px]">
        
        <!-- Artwork Selection -->
        <div class="space-y-1.5">
          <label class="block text-[11px] font-mono uppercase tracking-wider text-[#a89f91]">Photograph</label>
          <div class="flex items-center gap-2">
            <button type="button" id="prevArtworkBtn" class="px-3 py-2.5 bg-[#080706] hover:bg-[#201a17] border border-white/15 text-xs font-mono text-[#dfb872] active:scale-95 transition-all">◀</button>
            <select 
              id="artworkSelect" 
              class="flex-1 text-xs font-mono bg-[#080706] border border-white/15 py-2.5 px-3 text-[#f7f4ee] focus:border-[#c5a059] focus:outline-none"
            >
              {catalog.map((item) => (
                <option value={item.id}>{item.data.title}</option>
              ))}
            </select>
            <button type="button" id="nextArtworkBtn" class="px-3 py-2.5 bg-[#080706] hover:bg-[#201a17] border border-white/15 text-xs font-mono text-[#dfb872] active:scale-95 transition-all">▶</button>
          </div>
        </div>

        <!-- Auto-Fit Suite -->
        <div class="space-y-1.5 border-t border-white/10 pt-4">
          <label class="block text-[11px] font-mono uppercase tracking-wider text-[#a89f91]">Auto-Fit Framing</label>
          <div class="grid grid-cols-3 gap-2">
            <button type="button" id="fitWidthBtn" class="py-2.5 px-2 border border-white/15 hover:border-[#c5a059] bg-[#0a0808] hover:bg-[#1a1512] text-xs font-mono text-[#f7f4ee] active:scale-95 transition-all">
              Fit Width
            </button>
            <button type="button" id="fitHeightBtn" class="py-2.5 px-2 border border-white/15 hover:border-[#c5a059] bg-[#0a0808] hover:bg-[#1a1512] text-xs font-mono text-[#f7f4ee] active:scale-95 transition-all">
              Fit Height
            </button>
            <button type="button" id="fillBleedBtn" class="py-2.5 px-2 border border-white/15 hover:border-[#c5a059] bg-[#0a0808] hover:bg-[#1a1512] text-xs font-mono text-[#f7f4ee] active:scale-95 transition-all">
              Fill Bleed
            </button>
          </div>
        </div>

        <!-- Centering Suite -->
        <div class="space-y-1.5 border-t border-white/10 pt-4">
          <label class="block text-[11px] font-mono uppercase tracking-wider text-[#a89f91]">Alignment & Re-Centering</label>
          <div class="grid grid-cols-3 gap-2">
            <button type="button" id="centerHBtn" class="py-2.5 px-2 border border-white/15 hover:border-[#c5a059] bg-[#0a0808] hover:bg-[#1a1512] text-xs font-mono text-[#f7f4ee] active:scale-95 transition-all">
              Center H
            </button>
            <button type="button" id="centerVBtn" class="py-2.5 px-2 border border-white/15 hover:border-[#c5a059] bg-[#0a0808] hover:bg-[#1a1512] text-xs font-mono text-[#f7f4ee] active:scale-95 transition-all">
              Center V
            </button>
            <button type="button" id="centerAllBtn" class="py-2.5 px-2 border border-white/15 hover:border-[#c5a059] bg-[#0a0808] hover:bg-[#1a1512] text-xs font-mono text-[#f7f4ee] active:scale-95 transition-all">
              Reset Center
            </button>
          </div>
        </div>

        <!-- Numerical Scale & External Nudge Buttons -->
        <div class="space-y-2 border-t border-white/10 pt-4">
          <div class="flex items-center justify-between">
            <label class="text-[11px] font-mono uppercase tracking-wider text-[#a89f91]">Scale Factor</label>
            <div class="flex items-center gap-1.5">
              <div class="flex items-center bg-[#080706] border border-white/20 px-2 py-1">
                <input 
                  type="number" 
                  id="zoomInput" 
                  min="0.3" 
                  max="3.5" 
                  step="0.05" 
                  value="1.00" 
                  class="w-16 bg-transparent text-[#f7f4ee] font-mono text-xs text-right focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                />
                <span class="ml-1 text-xs font-mono text-[#a89f91]">x</span>
              </div>
              <div class="flex flex-col">
                <button type="button" id="nudgeUpBtn" class="px-2 py-0.5 bg-[#181412] hover:bg-[#25201c] border border-white/15 text-[10px] text-[#f7f4ee] active:bg-[#c5a059] active:text-[#0a0808]">▲</button>
                <button type="button" id="nudgeDownBtn" class="px-2 py-0.5 bg-[#181412] hover:bg-[#25201c] border-x border-b border-white/15 text-[10px] text-[#f7f4ee] active:bg-[#c5a059] active:text-[#0a0808]">▼</button>
              </div>
            </div>
          </div>
          <input 
            type="range" 
            id="zoomSlider" 
            min="0.3" 
            max="3.5" 
            step="0.01" 
            value="1.00" 
            class="w-full h-2 bg-[#080706] accent-[#c5a059] cursor-pointer" 
          />
        </div>

        <!-- Overlays -->
        <div class="space-y-1.5 border-t border-white/10 pt-4">
          <label class="block text-[11px] font-mono uppercase tracking-wider text-[#a89f91]">Composition & Lab Overlays</label>
          <div class="grid grid-cols-2 gap-2">
            <button type="button" id="sidebarGridBtn" class="py-2.5 px-2 border border-[#c5a059] bg-[#c5a059]/20 text-xs font-mono text-[#dfb872] active:scale-95 transition-all">
              Grid: ON
            </button>
            <button type="button" id="sidebarBleedBtn" class="py-2.5 px-2 border border-[#c5a059] bg-[#c5a059]/20 text-xs font-mono text-[#dfb872] active:scale-95 transition-all">
              Bleed: ON
            </button>
          </div>
        </div>

        <!-- Export JSON -->
        <div class="border-t border-white/10 pt-4">
          <button 
            type="button" 
            id="exportJsonBtn" 
            class="w-full py-2.5 border border-white/15 bg-[#0a0808] hover:bg-white/5 text-xs font-mono text-[#a89f91] hover:text-[#f7f4ee] transition-colors"
          >
            📋 Download Approved Crops JSON
          </button>
        </div>

      </section>

    </main>

    <!-- Sticky Bottom Bar -->
    <div class="fixed bottom-0 inset-x-0 z-30 bg-[#120f0d]/95 backdrop-blur-md border-t border-white/15 p-3.5 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-2xl">
      <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
        <div class="flex-1 min-w-0">
          <p id="activeSubstrateLabel" class="text-xs font-mono text-[#c5a059] font-bold truncate">Desk Pad (16:7)</p>
          <p id="statusMsg" class="text-[11px] font-mono text-[#a89f91] truncate">Ready to save</p>
        </div>

        <button 
          type="button" 
          id="approveBtn" 
          class="px-6 sm:px-8 py-3.5 bg-[#c5a059] hover:bg-[#d9b36c] text-[#0d0b0a] font-mono text-xs uppercase tracking-widest font-bold transition-all active:scale-[0.98] shadow-lg flex-shrink-0"
        >
          Save Crop Approval &rarr;
        </button>
      </div>
    </div>

  </div>

  <script>
    const canvas = document.getElementById('cropCanvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const viewport = document.getElementById('viewportContainer')!;
    const artworkSelect = document.getElementById('artworkSelect') as HTMLSelectElement;
    const prevArtworkBtn = document.getElementById('prevArtworkBtn')!;
    const nextArtworkBtn = document.getElementById('nextArtworkBtn')!;
    const productChips = document.querySelectorAll('.prod-chip');
    const activeSubstrateLabel = document.getElementById('activeSubstrateLabel')!;
    
    // Zoom Controls
    const zoomSlider = document.getElementById('zoomSlider') as HTMLInputElement;
    const zoomInput = document.getElementById('zoomInput') as HTMLInputElement;
    const nudgeUpBtn = document.getElementById('nudgeUpBtn')!;
    const nudgeDownBtn = document.getElementById('nudgeDownBtn')!;
    const hudZoomDisplay = document.getElementById('hudZoomDisplay')!;
    const hudZoomInBtn = document.getElementById('hudZoomInBtn')!;
    const hudZoomOutBtn = document.getElementById('hudZoomOutBtn')!;

    // Auto-Fit & Alignment
    const fitWidthBtn = document.getElementById('fitWidthBtn')!;
    const fitHeightBtn = document.getElementById('fitHeightBtn')!;
    const fillBleedBtn = document.getElementById('fillBleedBtn')!;
    const centerHBtn = document.getElementById('centerHBtn')!;
    const centerVBtn = document.getElementById('centerVBtn')!;
    const centerAllBtn = document.getElementById('centerAllBtn')!;

    // Overlays
    const hudGridBtn = document.getElementById('hudGridBtn')!;
    const hudBleedBtn = document.getElementById('hudBleedBtn')!;
    const sidebarGridBtn = document.getElementById('sidebarGridBtn')!;
    const sidebarBleedBtn = document.getElementById('sidebarBleedBtn')!;

    // Actions
    const approveBtn = document.getElementById('approveBtn') as HTMLButtonElement;
    const exportJsonBtn = document.getElementById('exportJsonBtn') as HTMLButtonElement;
    const statusMsg = document.getElementById('statusMsg')!;

    let img = new Image();
    let panX = 0;
    let panY = 0;
    let zoom = 1.0;
    let currentRatio = 16 / 7;
    let currentProductName = 'Desk Pad (16:7)';
    let showGrid = true;
    let showBleed = true;

    function draw() {
      if (!img.complete || !img.naturalWidth) return;

      const bounds = viewport.getBoundingClientRect();
      const maxW = Math.min(bounds.width - 24, 800);
      const maxH = Math.min(bounds.height - 24, 600);

      let targetW = maxW;
      let targetH = targetW / currentRatio;
      if (targetH > maxH) {
        targetH = maxH;
        targetW = targetH * currentRatio;
      }

      const dpr = Math.min(window.devicePixelRatio || 1, 3);
      canvas.width = Math.round(targetW * dpr);
      canvas.height = Math.round(targetH * dpr);
      canvas.style.width = `${Math.round(targetW)}px`;
      canvas.style.height = `${Math.round(targetH)}px`;

      ctx.save();
      ctx.scale(dpr, dpr);

      ctx.fillStyle = '#050404';
      ctx.fillRect(0, 0, targetW, targetH);

      const srcRatio = img.naturalWidth / img.naturalHeight;
      let drawW: number;
      let drawH: number;

      if (srcRatio > currentRatio) {
        drawH = targetH * zoom;
        drawW = drawH * srcRatio;
      } else {
        drawW = targetW * zoom;
        drawH = drawW / srcRatio;
      }

      const drawX = (targetW - drawW) / 2 + panX;
      const drawY = (targetH - drawH) / 2 + panY;

      ctx.drawImage(img, drawX, drawY, drawW, drawH);

      // 1. Darker, crisp Thirds Grid (visible against bright/white and dark scenes)
      if (showGrid) {
        ctx.lineWidth = 1.2;
        ctx.setLineDash([5, 5]);
        ctx.strokeStyle = 'rgba(25, 22, 20, 0.7)';
        ctx.beginPath();
        ctx.moveTo(targetW / 3, 0); ctx.lineTo(targetW / 3, targetH);
        ctx.moveTo((targetW * 2) / 3, 0); ctx.lineTo((targetW * 2) / 3, targetH);
        ctx.moveTo(0, targetH / 3); ctx.lineTo(targetW, targetH / 3);
        ctx.moveTo(0, (targetH * 2) / 3); ctx.lineTo(targetW, (targetH * 2) / 3);
        ctx.stroke();
        ctx.setLineDash([]);
      }

      // 2. Lighter Champagne-Gold Bleed Line (lighter weight, lighter tone)
      if (showBleed) {
        ctx.strokeStyle = 'rgba(245, 220, 160, 0.75)';
        ctx.lineWidth = 1.2;
        const inset = Math.min(targetW, targetH) * 0.05;
        ctx.strokeRect(inset, inset, targetW - inset * 2, targetH - inset * 2);
      }

      ctx.restore();

      const zoomStr = zoom.toFixed(2);
      hudZoomDisplay.textContent = `${zoomStr}x`;
      zoomInput.value = zoomStr;
      zoomSlider.value = zoomStr;
    }

    function switchPhoto() {
      const cleanPath = `/images/artworks/clean/${artworkSelect.value}.webp`;
      img.src = cleanPath;
      img.onerror = () => {
        img.onerror = null;
        img.src = `/images/artworks/${artworkSelect.value}.webp`;
      };
      img.onload = () => {
        panX = 0;
        panY = 0;
        zoom = 1.0;
        draw();
      };
    }

    function setZoom(newZoom: number) {
      zoom = Math.min(3.5, Math.max(0.3, parseFloat(newZoom.toFixed(2))));
      draw();
    }

    function fitWidth() {
      if (!img.complete || !img.naturalWidth) return;
      const srcRatio = img.naturalWidth / img.naturalHeight;
      if (srcRatio > currentRatio) {
        setZoom(currentRatio / srcRatio);
      } else {
        setZoom(1.0);
      }
      panX = 0;
      draw();
    }

    function fitHeight() {
      if (!img.complete || !img.naturalWidth) return;
      const srcRatio = img.naturalWidth / img.naturalHeight;
      if (srcRatio < currentRatio) {
        setZoom(srcRatio / currentRatio);
      } else {
        setZoom(1.0);
      }
      panY = 0;
      draw();
    }

    function fillBleed() {
      setZoom(1.0);
      panX = 0;
      panY = 0;
      draw();
    }

    // Touch Engine: Multi-touch pinch & pan
    let isPinching = false;
    let isPanning = false;
    let touchStartX = 0;
    let touchStartY = 0;
    let initialPinchDist = 0;
    let initialPinchZoom = 1.0;
    let initialPinchCenter = { x: 0, y: 0 };
    let initialPan = { x: 0, y: 0 };
    let singleTapCount = 0;
    let tapResetTimer: any = null;

    // Prevent Safari gesture zoom
    viewport.addEventListener('gesturestart', (e) => e.preventDefault(), { passive: false });
    viewport.addEventListener('gesturechange', (e) => e.preventDefault(), { passive: false });
    viewport.addEventListener('gestureend', (e) => e.preventDefault(), { passive: false });

    viewport.addEventListener('touchstart', (e) => {
      // Disregard touches on controls
      if ((e.target as HTMLElement).closest('button, select, input')) return;
      e.preventDefault();

      if (e.touches.length === 1) {
        isPinching = false;
        isPanning = true;
        touchStartX = e.touches[0].clientX - panX;
        touchStartY = e.touches[0].clientY - panY;
      } else if (e.touches.length === 2) {
        isPanning = false;
        isPinching = true;
        singleTapCount = 0;
        if (tapResetTimer) clearTimeout(tapResetTimer);

        const t0 = e.touches[0];
        const t1 = e.touches[1];
        initialPinchDist = Math.hypot(t0.clientX - t1.clientX, t0.clientY - t1.clientY);
        initialPinchZoom = zoom;
        initialPinchCenter = {
          x: (t0.clientX + t1.clientX) / 2,
          y: (t0.clientY + t1.clientY) / 2,
        };
        initialPan = { x: panX, y: panY };
      }
    }, { passive: false });

    window.addEventListener('touchmove', (e) => {
      if (!isPanning && !isPinching) return;
      e.preventDefault();

      if (e.touches.length === 1 && isPanning) {
        panX = e.touches[0].clientX - touchStartX;
        panY = e.touches[0].clientY - touchStartY;
        draw();
      } else if (e.touches.length === 2 && isPinching && initialPinchDist > 0) {
        const t0 = e.touches[0];
        const t1 = e.touches[1];
        const currentDist = Math.hypot(t0.clientX - t1.clientX, t0.clientY - t1.clientY);
        const currentCenter = {
          x: (t0.clientX + t1.clientX) / 2,
          y: (t0.clientY + t1.clientY) / 2,
        };
        const scale = currentDist / initialPinchDist;

        zoom = Math.min(3.5, Math.max(0.3, parseFloat((initialPinchZoom * scale).toFixed(2))));
        panX = initialPan.x + (currentCenter.x - initialPinchCenter.x);
        panY = initialPan.y + (currentCenter.y - initialPinchCenter.y);
        draw();
      }
    }, { passive: false });

    window.addEventListener('touchend', (e) => {
      if (e.touches.length === 1) {
        // Transition back to single-finger pan seamlessly
        isPinching = false;
        isPanning = true;
        touchStartX = e.touches[0].clientX - panX;
        touchStartY = e.touches[0].clientY - panY;
      } else if (e.touches.length === 0) {
        if (isPanning && !isPinching) {
          // Double tap detection strictly on single-touch release
          singleTapCount++;
          if (singleTapCount === 1) {
            tapResetTimer = setTimeout(() => { singleTapCount = 0; }, 300);
          } else if (singleTapCount === 2) {
            clearTimeout(tapResetTimer);
            singleTapCount = 0;
            fillBleed();
          }
        }
        isPinching = false;
        isPanning = false;
        initialPinchDist = 0;
      }
    });

    // Substrate Rail Handlers
    productChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        productChips.forEach((c) => {
          c.className = 'prod-chip px-3.5 py-2 border border-white/10 bg-[#161210] text-[#a89f91] text-xs font-mono uppercase transition-colors';
        });
        chip.className = 'prod-chip active px-3.5 py-2 border border-[#c5a059] bg-[#c5a059]/20 text-[#dfb872] text-xs font-mono uppercase transition-colors';
        
        const btn = chip as HTMLButtonElement;
        const w = parseFloat(btn.dataset.w || '1');
        const h = parseFloat(btn.dataset.h || '1');
        currentRatio = w / h;
        currentProductName = btn.innerText.trim();
        activeSubstrateLabel.textContent = currentProductName;
        panX = 0;
        panY = 0;
        draw();
      });
    });

    // Artwork Steppers
    prevArtworkBtn.addEventListener('click', () => {
      if (artworkSelect.selectedIndex > 0) {
        artworkSelect.selectedIndex--;
        switchPhoto();
      }
    });
    nextArtworkBtn.addEventListener('click', () => {
      if (artworkSelect.selectedIndex < artworkSelect.options.length - 1) {
        artworkSelect.selectedIndex++;
        switchPhoto();
      }
    });
    artworkSelect.addEventListener('change', switchPhoto);

    // Auto-Fit Handlers
    fitWidthBtn.addEventListener('click', fitWidth);
    fitHeightBtn.addEventListener('click', fitHeight);
    fillBleedBtn.addEventListener('click', fillBleed);

    // Centering Handlers
    centerHBtn.addEventListener('click', () => { panX = 0; draw(); });
    centerVBtn.addEventListener('click', () => { panY = 0; draw(); });
    centerAllBtn.addEventListener('click', () => { panX = 0; panY = 0; draw(); });

    // Zoom Handlers
    hudZoomInBtn.addEventListener('click', () => setZoom(zoom + 0.15));
    hudZoomOutBtn.addEventListener('click', () => setZoom(zoom - 0.15));
    nudgeUpBtn.addEventListener('click', () => setZoom(zoom + 0.05));
    nudgeDownBtn.addEventListener('click', () => setZoom(zoom - 0.05));
    zoomInput.addEventListener('change', () => setZoom(parseFloat(zoomInput.value) || 1.0));
    zoomSlider.addEventListener('input', () => setZoom(parseFloat(zoomSlider.value)));

    // Grid & Bleed Toggles
    function toggleGrid() {
      showGrid = !showGrid;
      const label = showGrid ? 'Grid: ON' : 'Grid: OFF';
      const activeClass = 'py-2.5 px-2 border border-[#c5a059] bg-[#c5a059]/20 text-xs font-mono text-[#dfb872] active:scale-95 transition-all';
      const inactiveClass = 'py-2.5 px-2 border border-white/10 bg-[#0a0808] text-xs font-mono text-[#8e8577] active:scale-95 transition-all';
      
      hudGridBtn.textContent = label;
      hudGridBtn.className = showGrid
        ? 'px-2.5 py-1.5 text-[11px] font-mono rounded bg-[#c5a059]/30 text-[#dfb872] border border-[#c5a059]'
        : 'px-2.5 py-1.5 text-[11px] font-mono rounded bg-white/5 text-[#a89f91] border border-white/10';

      sidebarGridBtn.textContent = label;
      sidebarGridBtn.className = showGrid ? activeClass : inactiveClass;
      draw();
    }

    function toggleBleed() {
      showBleed = !showBleed;
      const label = showBleed ? 'Bleed: ON' : 'Bleed: OFF';
      const activeClass = 'py-2.5 px-2 border border-[#c5a059] bg-[#c5a059]/20 text-xs font-mono text-[#dfb872] active:scale-95 transition-all';
      const inactiveClass = 'py-2.5 px-2 border border-white/10 bg-[#0a0808] text-xs font-mono text-[#8e8577] active:scale-95 transition-all';

      hudBleedBtn.textContent = label;
      hudBleedBtn.className = showBleed
        ? 'px-2.5 py-1.5 text-[11px] font-mono rounded bg-[#c5a059]/30 text-[#dfb872] border border-[#c5a059]'
        : 'px-2.5 py-1.5 text-[11px] font-mono rounded bg-white/5 text-[#a89f91] border border-white/10';

      sidebarBleedBtn.textContent = label;
      sidebarBleedBtn.className = showBleed ? activeClass : inactiveClass;
      draw();
    }

    hudGridBtn.addEventListener('click', toggleGrid);
    sidebarGridBtn.addEventListener('click', toggleGrid);
    hudBleedBtn.addEventListener('click', toggleBleed);
    sidebarBleedBtn.addEventListener('click', toggleBleed);

    // Save Approval
    approveBtn.addEventListener('click', async () => {
      const id = artworkSelect.value;
      approveBtn.disabled = true;
      statusMsg.textContent = 'Saving crop...';
      statusMsg.className = 'text-[11px] font-mono text-[#c5a059]';

      try {
        const res = await fetch('/api/approve-merch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id,
            product: currentProductName,
            crop: { panX, panY, zoom, ratio: currentRatio },
            watermark: 'none',
          }),
        });

        const data = await res.json();
        if (res.ok && data.success) {
          statusMsg.textContent = `Saved ✓ (${currentProductName})`;
          statusMsg.className = 'text-[11px] font-mono text-[#c5a059] font-bold';
        } else {
          statusMsg.textContent = data.error || 'Save failed.';
          statusMsg.className = 'text-[11px] font-mono text-red-400';
        }
      } catch {
        statusMsg.textContent = 'Network communication error.';
        statusMsg.className = 'text-[11px] font-mono text-red-400';
      } finally {
        approveBtn.disabled = false;
      }
    });

    // Export Crops
    exportJsonBtn.addEventListener('click', async () => {
      try {
        const res = await fetch('/api/approve-merch');
        const data = await res.json();
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'merch-crops.json';
        a.click();
        URL.revokeObjectURL(url);
      } catch {
        alert('Failed to retrieve crops from cloud.');
      }
    });

    window.addEventListener('resize', draw);
    switchPhoto();
  </script>
</Layout>