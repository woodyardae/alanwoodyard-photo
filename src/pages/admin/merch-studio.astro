        input.value = name;
        input.checked = selectedSet.has(name);
        const span = document.createElement('span');
        span.textContent = name;
        label.appendChild(input);
        label.appendChild(span);
        metaCollections.appendChild(label);
      });
    }

    function syncDescriptionCount() {
      if (!metaDescriptionCount) return;
      const len = metaDescription ? metaDescription.value.length : 0;
      metaDescriptionCount.textContent = len + ' / ' + descriptionLimit;
    }

    function parseTagInput(value) {
      return String(value || '').split(',').map((tag) => tag.trim()).filter((tag) => tag.length > 0);
    }

    function syncArtworkCopy(art) {
      const isPhoto = Boolean(art && art.store === 'photo');
      if (metaPhotoFields) metaPhotoFields.hidden = !isPhoto;
      if (metaSwsNote) metaSwsNote.hidden = isPhoto;
      if (saveMetadataBtn) saveMetadataBtn.disabled = !isPhoto;
      if (!isPhoto) {
        syncDescriptionCount();
