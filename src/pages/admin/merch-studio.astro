      if (metaTitle) metaTitle.value = art.title || '';
      if (metaSlug) metaSlug.value = art.slug || art.id || '';
      if (metaCaption) metaCaption.value = art.caption || '';
      if (metaDescription) metaDescription.value = art.description || '';
      if (metaTags) metaTags.value = Array.isArray(art.tags) ? art.tags.join(', ') : '';
      renderCollections(Array.isArray(art.collections) ? art.collections : []);
      syncDescriptionCount();
    }

    function applyRemoteRecord(local, record) {
      if (!record || typeof record !== 'object' || Array.isArray(record)) return;
      if (typeof record.title === 'string' && record.title.trim()) local.title = record.title;
      if (typeof record.slug === 'string' && record.slug.trim()) local.slug = record.slug;
      if (typeof record.caption === 'string') local.caption = record.caption;
      if (typeof record.description === 'string') local.description = record.description;
      if (Array.isArray(record.collections)) {
        local.collections = record.collections.filter((item) => typeof item === 'string');
      }
      if (Array.isArray(record.tags)) {
        local.tags = record.tags.filter((item) => typeof item === 'string');
      }
      if (Array.isArray(record.merch_approved)) {
        local.approved = record.merch_approved.filter((item) => typeof item === 'string');
      }
      const skip = {
        title: true,
        slug: true,
        caption: true,
        description: true,
        collections: true,
        tags: true,
        merch_approved: true,
        merch_crops: true,
        master_file: true,
        id: true,
      };
      const crops = {};
      Object.keys(record).forEach((key) => {
        if (!skip[key]) crops[key] = record[key];
      });
      if (record.merch_crops && typeof record.merch_crops === 'object' && !Array.isArray(record.merch_crops)) {
        Object.keys(record.merch_crops).forEach((key) => {
          crops[key] = record.merch_crops[key];
        });
      }
      local.crops = { ...(local.crops || {}), ...crops };
      if (crops.__rejected === true) local.rejected = true;
      else if (crops.__rejected === false) local.rejected = false;
    }

    function switchPhoto() {
      renderRubric();
      const art = getSelectedArtwork();
      syncArtworkCopy(art);
      const ratioKey = ratioSelect.value;

      if (!art) {
        currentImg = new Image();
        draw();
        return;
      }

      const existingCrop = art.crops ? art.crops[ratioKey] : null;
      if (existingCrop && !isRejectedCropValue(existingCrop)) {
        panX = existingCrop.panX || 0;
        panY = existingCrop.panY || 0;
        zoom = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, Number(existingCrop.zoom) || 1));
      } else {
        panX = 0;
        panY = 0;
        zoom = 1.0;
      }

      syncZoomUi();
      draw();

      const targetUrl = art.img;
      currentImg = new Image();
      currentImg.onload = () => { draw(); };
      currentImg.onerror = () => {
        const { w, h } = getCanvasDims();
        ctx.fillStyle = '#ff6b6b';
        ctx.font = '11px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('Failed to load: ' + targetUrl, w / 2, h / 2);
        ctx.textAlign = 'start';
      };
      currentImg.src = targetUrl;

      if (currentImg.complete && currentImg.naturalWidth > 0) {
        draw();
      }
    }

    // iPad WebKit Gesture Trap
    canvasWrapper.addEventListener('gesturestart', (e) => { e.preventDefault(); }, { passive: false });
    canvasWrapper.addEventListener('gesturechange', (e) => { e.preventDefault(); }, { passive: false });
    canvasWrapper.addEventListener('gestureend', (e) => { e.preventDefault(); }, { passive: false });

    // Touch Engine
    let touchMode = 'none';
    let lastTouchX = 0;
    let lastTouchY = 0;
    let pinchStartDist = 0;
    let pinchBaseZoom = 1.0;

    function getTouchDist(t1, t2) {
      return Math.hypot(t1.clientX - t2.clientX, t1.clientY - t2.clientY);
    }

    canvasWrapper.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        touchMode = 'pan';
        pinchStartDist = 0;
        lastTouchX = e.touches[0].clientX;
        lastTouchY = e.touches[0].clientY;
      } else if (e.touches.length === 2) {
        touchMode = 'pinch';
        pinchStartDist = getTouchDist(e.touches[0], e.touches[1]);
        pinchBaseZoom = zoom;
      }
      e.preventDefault();
    }, { passive: false });

    canvasWrapper.addEventListener('touchmove', (e) => {
      if (touchMode === 'pan' && e.touches.length === 1) {
        const dx = e.touches[0].clientX - lastTouchX;
        const dy = e.touches[0].clientY - lastTouchY;
        panX += dx;
        panY += dy;
        lastTouchX = e.touches[0].clientX;
        lastTouchY = e.touches[0].clientY;
        draw();
      } else if (touchMode === 'pinch' && e.touches.length === 2 && pinchStartDist > 0) {
        const currentDist = getTouchDist(e.touches[0], e.touches[1]);
        const scale = currentDist / pinchStartDist;
        setZoom(pinchBaseZoom * scale);
      }
      e.preventDefault();
    }, { passive: false });

    function onTouchEnd(e) {
      if (e.touches.length === 0) {
        touchMode = 'none';
        pinchStartDist = 0;
      } else if (e.touches.length === 1) {
        touchMode = 'pan';
        pinchStartDist = 0;
        lastTouchX = e.touches[0].clientX;
        lastTouchY = e.touches[0].clientY;
      }
    }

    canvasWrapper.addEventListener('touchend', onTouchEnd, { passive: false });
    canvasWrapper.addEventListener('touchcancel', onTouchEnd, { passive: false });

    // Desktop Mouse Fallback
    let isMouseDown = false;
    let mouseLastX = 0;
    let mouseLastY = 0;

    canvasWrapper.addEventListener('mousedown', (e) => {
      isMouseDown = true;
      mouseLastX = e.clientX;
      mouseLastY = e.clientY;
    });

    window.addEventListener('mousemove', (e) => {
      if (!isMouseDown) return;
      panX += e.clientX - mouseLastX;
      panY += e.clientY - mouseLastY;
      mouseLastX = e.clientX;
      mouseLastY = e.clientY;
      draw();
    });

    window.addEventListener('mouseup', () => { isMouseDown = false; });

    zoomSlider.addEventListener('input', (e) => {
      setZoom(parseFloat(e.target.value));
    });

    zoomStepDown.addEventListener('click', () => stepZoom(-0.05));
    zoomStepUp.addEventListener('click', () => stepZoom(0.05));
    zoomInput.addEventListener('change', () => {
      const parsed = parseFloat(zoomInput.value);
      if (!Number.isFinite(parsed)) {
        syncZoomUi();
        return;
      }
      setZoom(Math.round(parsed * 100) / 100);
    });

    fitWidthBtn.addEventListener('click', fitWidth);
    fitHeightBtn.addEventListener('click', fitHeight);
    fillBleedBtn.addEventListener('click', fillBleed);
    centerHBtn.addEventListener('click', () => { panX = 0; draw(); });
    centerVBtn.addEventListener('click', () => { panY = 0; draw(); });
    resetCenterBtn.addEventListener('click', () => { panX = 0; panY = 0; draw(); });

    artworkSelect.addEventListener('change', switchPhoto);
    ratioSelect.addEventListener('change', switchPhoto);
    window.addEventListener('resize', () => { draw(); });

    async function saveCurrentCrop(advanceToNextItem) {
      const art = getSelectedArtwork();
      if (!art) return;

      if (cropDecisionForRatio(art.crops, ratioSelect.value) === 'rejected') {
        statusMsg.className = 'text-xs font-mono text-center text-amber-300';
        statusMsg.innerText = 'This ratio is rejected. Restore the crop before saving it.';
        return;
      }

      setDecisionButtonsDisabled(true);
      statusMsg.className = 'text-xs font-mono text-center text-[var(--theme-text-muted)]';
      statusMsg.innerText = 'Saving crop & products...';

      const approvedProducts = Array.from(document.querySelectorAll('.rubric-cb:checked')).map((cb) => cb.value);
      const excludedProducts = Array.from(document.querySelectorAll('.rubric-cb:not(:checked)')).map((cb) => cb.value);

      const currentIdx = filteredQueue.findIndex((a) => a.id === art.id);
      const nextItemInQueue = currentIdx >= 0 && currentIdx + 1 < filteredQueue.length
        ? filteredQueue[currentIdx + 1].id
        : filteredQueue[0]?.id;

      const payload = {
        artworkId: art.id,
        store: art.store,
        ratioKey: ratioSelect.value,
        authToken: MASTER_KEY,
        crop: {
          panX,
          panY,
          zoom,
          approved_products: approvedProducts,
          excluded_products: excludedProducts,
          approved_at: new Date().toISOString(),
        },
      };

      try {
        const res = await fetch('/api/approve-merch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          art.crops = art.crops || {};
          delete art.crops.__rejected;
          art.crops[ratioSelect.value] = payload.crop;
          art.rejected = false;
          if (approvedProducts.length > 0 && (!art.approved || !art.approved.length)) {
            art.approved = approvedProducts;
          }

          statusMsg.className = 'text-xs font-mono text-center text-emerald-400';
          statusMsg.innerText = `✓ Saved ${ratioSelect.value} framing + ${approvedProducts.length} product(s).`;

          if (advanceToNextItem) {
            rebuildQueue(nextItemInQueue && nextItemInQueue !== art.id ? nextItemInQueue : undefined);
          } else {
            rebuildQueue(art.id);
            const still = getSelectedArtwork();
            if (still && still.id === art.id && autoAdvanceCb && autoAdvanceCb.checked) {
              const nextUnset = nextPendingRatio(still.crops, ratioSelect.value);
              if (nextUnset && nextUnset !== ratioSelect.value) {
                ratioSelect.value = nextUnset;
                switchPhoto();
              }
            }
          }
        } else {
          throw new Error(data.error || (await res.text()));
        }
      } catch (err) {
        statusMsg.className = 'text-xs font-mono text-center text-red-400';
        statusMsg.innerText = `Error: ${err.message}`;
      } finally {
        setDecisionButtonsDisabled(false);
      }
    }

    saveBtn.addEventListener('click', () => saveCurrentCrop(false));
    saveNextBtn.addEventListener('click', () => saveCurrentCrop(true));

    if (metaDescription) metaDescription.addEventListener('input', syncDescriptionCount);

    if (metaAddCollection) {
      metaAddCollection.addEventListener('click', () => {
        const raw = metaNewCollection ? metaNewCollection.value.trim().toLowerCase() : '';
        if (!raw) return;
        if (!artworkSlugRe.test(raw)) {
          statusMsg.className = 'text-xs font-mono text-center text-red-400';
          statusMsg.innerText = 'Collection slugs use lowercase letters, numbers, and single hyphens.';
          return;
        }
        if (!knownCollections.includes(raw)) knownCollections.push(raw);
        const selected = selectedCollections();
        if (!selected.includes(raw)) selected.push(raw);
        if (metaNewCollection) metaNewCollection.value = '';
        renderCollections(selected);
      });
    }

    if (saveMetadataBtn) {
      saveMetadataBtn.addEventListener('click', async () => {
        const art = getSelectedArtwork();
        if (!art || art.store !== 'photo') return;

        const title = metaTitle ? metaTitle.value.trim() : '';
        const slug = metaSlug ? metaSlug.value.trim() : '';
        const caption = metaCaption ? metaCaption.value : '';
        const description = metaDescription ? metaDescription.value : '';
        const tags = parseTagInput(metaTags ? metaTags.value : '');
        const collections = selectedCollections();
        const pendingCollection = metaNewCollection ? metaNewCollection.value.trim().toLowerCase() : '';
        if (pendingCollection) {
          if (!artworkSlugRe.test(pendingCollection)) {
            statusMsg.className = 'text-xs font-mono text-center text-red-400';
            statusMsg.innerText = 'Collection slugs use lowercase letters, numbers, and single hyphens.';
            return;
          }
          if (!collections.includes(pendingCollection)) collections.push(pendingCollection);
        }

        if (!title) {
          statusMsg.className = 'text-xs font-mono text-center text-red-400';
          statusMsg.innerText = 'Title is required.';
          return;
        }
        if (!artworkSlugRe.test(slug)) {
          statusMsg.className = 'text-xs font-mono text-center text-red-400';
          statusMsg.innerText = 'Invalid slug. Use lowercase letters, numbers, and single hyphens.';
          return;
        }
        if (description.length > descriptionLimit) {
          statusMsg.className = 'text-xs font-mono text-center text-red-400';
          statusMsg.innerText = 'Description must be ' + descriptionLimit + ' characters or fewer.';
          return;
        }

        saveMetadataBtn.disabled = true;
        statusMsg.className = 'text-xs font-mono text-center text-[var(--theme-text-muted)]';
        statusMsg.innerText = 'Saving artwork copy...';

        try {
          const res = await fetch('/api/approve-merch', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              artworkId: art.id,
              store: art.store,
              action: 'save-metadata',
              authToken: MASTER_KEY,
              title,
              slug,
              caption,
              description,
              collections,
              tags,
            }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            art.title = title;
            art.slug = slug;
            art.caption = caption;
            art.description = description;
            art.collections = collections;
            art.tags = tags;
            collections.forEach((name) => {
              if (!knownCollections.includes(name)) knownCollections.push(name);
            });
            if (metaNewCollection) metaNewCollection.value = '';
            statusMsg.className = 'text-xs font-mono text-center text-emerald-400';
            statusMsg.innerText = 'Saved copy. Public URL /artwork/' + slug + '.';
            rebuildQueue(art.id);
          } else {
            throw new Error(data.error || 'Request failed');
          }
        } catch (err) {
          statusMsg.className = 'text-xs font-mono text-center text-red-400';
          statusMsg.innerText = 'Error: ' + err.message;
        } finally {
          saveMetadataBtn.disabled = false;
        }
      });
    }

    rejectCropBtn.addEventListener('click', async () => {
      const art = getSelectedArtwork();
      if (!art) return;

      const ratioKey = ratioSelect.value;
      const decision = cropDecisionForRatio(art.crops, ratioKey);
      const action = decision === 'rejected' ? 'restore-crop' : 'reject-crop';

      setDecisionButtonsDisabled(true);
      statusMsg.className = 'text-xs font-mono text-center text-[var(--theme-text-muted)]';
      statusMsg.innerText = action === 'reject-crop' ? 'Rejecting this crop...' : 'Restoring this crop...';

      try {
        const res = await fetch('/api/approve-merch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            artworkId: art.id,
            store: art.store,
            action,
            ratioKey,
            authToken: MASTER_KEY,
          }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          art.crops = art.crops || {};
          if (action === 'reject-crop') {
            art.crops[ratioKey] = { rejected: true, rejected_at: new Date().toISOString() };
          } else {
            delete art.crops[ratioKey];
          }

          statusMsg.className = 'text-xs font-mono text-center text-amber-300';
          statusMsg.innerText = action === 'reject-crop'
            ? `Rejected ${ratioKey} for this image.`
            : `Restored ${ratioKey}. This ratio is undecided.`;

          rebuildQueue(art.id);
          const still = getSelectedArtwork();
          if (still && still.id === art.id && action === 'reject-crop' && autoAdvanceCb && autoAdvanceCb.checked) {
            const nextUnset = nextPendingRatio(still.crops, ratioKey);
            if (nextUnset && nextUnset !== ratioKey) {
              ratioSelect.value = nextUnset;
              switchPhoto();
            }
          }
        } else {
          throw new Error(data.error || 'Request failed');
        }
      } catch (err) {
        statusMsg.className = 'text-xs font-mono text-center text-red-400';
        statusMsg.innerText = `Error: ${err.message}`;
      } finally {
        setDecisionButtonsDisabled(false);
      }
    });

    rejectBtn.addEventListener('click', async () => {
      const art = getSelectedArtwork();
      if (!art) return;

      const isCurrentlyRejected = getItemStatus(art) === 'rejected';
      const action = isCurrentlyRejected ? 'unreject' : 'reject';
      const currentIdx = filteredQueue.findIndex((a) => a.id === art.id);
      const nextItemInQueue = currentIdx >= 0 && currentIdx + 1 < filteredQueue.length
        ? filteredQueue[currentIdx + 1].id
        : filteredQueue[0]?.id;

      setDecisionButtonsDisabled(true);
      statusMsg.className = 'text-xs font-mono text-center text-[var(--theme-text-muted)]';
      statusMsg.innerText = action === 'reject' ? 'Marking rejected...' : 'Restoring to queue...';

      try {
        const res = await fetch('/api/approve-merch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            artworkId: art.id,
            store: art.store,
            action,
            authToken: MASTER_KEY,
          }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          art.rejected = action === 'reject';
          art.crops = art.crops || {};
          if (art.rejected) art.crops.__rejected = true;
          else delete art.crops.__rejected;

          statusMsg.className = 'text-xs font-mono text-center text-amber-300';
          statusMsg.innerText = action === 'reject' ? `✕ Rejected "${art.title}".` : `↺ Restored "${art.title}".`;
          rebuildQueue(nextItemInQueue && nextItemInQueue !== art.id ? nextItemInQueue : undefined);
        } else {
          throw new Error(data.error || 'Request failed');
        }
      } catch (err) {
        statusMsg.className = 'text-xs font-mono text-center text-red-400';
        statusMsg.innerText = `Error: ${err.message}`;
      } finally {
        setDecisionButtonsDisabled(false);
      }
    });

    async function loadCloudCrops() {
      try {
        const res = await fetch('/api/approve-merch');
        if (res.ok) {
          const remote = await res.json();
          for (const [id, record] of Object.entries(remote)) {
            const local = catalogData.find((a) => a.id === id);
            if (local) applyRemoteRecord(local, record);
          }
          rebuildQueue(artworkSelect.value);
        }
      } catch (e) {}
    }

    function initStudio() {
      rebuildQueue();
      loadCloudCrops();
    }

    if (!isStudioInitialized) {
      isStudioInitialized = true;
      initStudio();
    }
  </script>
</Layout>
