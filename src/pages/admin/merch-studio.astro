---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import swsQueue from '../../data/sws-queue.json';
import { getCollection } from 'astro:content';
// @ts-ignore cloudflare:workers binding is absent during local Node typecheck.
import { env } from 'cloudflare:workers';
import {
  PHOTO_RATIO_PRODUCTS,
  SWS_RATIO_PRODUCTS,
  RATIO_KEYS,
  RATIO_MAP,
  RATIO_LABELS,
} from '../../lib/merch-studio-shared';
import {
  ARTWORK_DESCRIPTION_MAX,
  ARTWORK_SLUG_RE,
  getEffectiveCatalog,
  type SessionKv,
} from '../../lib/artwork-overlay';

const artworks = await getCollection('artworks');
const session = (env as { SESSION?: SessionKv } | undefined)?.SESSION;
const effectiveCatalog = await getEffectiveCatalog({ SESSION: session });
const effectiveById = new Map(effectiveCatalog.map((art) => [art.id, art]));
const catalogCollections = [...new Set(effectiveCatalog.flatMap((art) => art.collections))].sort();

const photoItems = artworks.map((art) => {
  const entryId = typeof art.data.id === 'string' && art.data.id ? art.data.id : art.id;
  const live = effectiveById.get(entryId) || effectiveById.get(art.id);
  const collections = live?.collections ?? art.data.collections ?? [];
  return {
    id: art.id,
    store: 'photo' as const,
    title: live?.title || art.data.title,
    slug: live?.slug || entryId,
    caption: live?.caption ?? art.data.caption ?? '',
    description: live?.description ?? art.data.description ?? '',
    collections,
    tags: live?.tags ?? art.data.tags ?? [],
    category: collections[0] || art.data.mood || 'Alan Woodyard Photography',
    img: `/images/artworks/${art.id}.webp`,
    width: art.data.capture?.native_dimensions?.width || 6000,
    height: art.data.capture?.native_dimensions?.height || 4000,
    crops: art.data.merch_crops || {},
    approved: art.data.merch_approved || [],
    rejected: Boolean(art.data.merch_rejected),
  };
});

const swsItems = (Array.isArray(swsQueue) ? swsQueue : []).map((item) => ({
  id: item.id,
  store: 'sws' as const,
  title: item.title,
  category: item.category || 'SeeWhatSticks',
  img: item.img,
  width: item.width || 2048,
  height: item.height || 2048,
  crops: item.crops || {},
  approved: item.approved || [],
  rejected: Boolean(item.rejected),
}));

const catalogData = [...photoItems, ...swsItems];
---

<Layout title="Unified Merch Framing & Approval Queue">
  <!-- Live Browser Diagnostic Console -->
  <div id="runtimeCrashBanner" style="display: none;" class="fixed top-0 left-0 right-0 z-50 bg-red-900 border-b border-red-500 text-white p-4 font-mono text-xs"></div>

  <!-- Studio Main Application -->
  <main id="studioApp" class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8 text-[var(--awp-text)]">
    <!-- Header -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/[0.08] pb-4 mb-5">
      <div>
        <h1 class="text-xl sm:text-2xl font-serif text-[var(--theme-text)]">Unified Merch Approval Queue</h1>
        <p class="text-[11px] font-mono text-[var(--awp-text-muted)] mt-0.5">Crop framing, DPI preflight, and SKU review for Alan Woodyard Photo and SeeWhatSticks.</p>
      </div>
      <div class="flex items-center gap-4">
        <a href="/admin/syndication/" class="text-xs font-mono text-[var(--theme-text-muted)] hover:text-white">Syndication Desk &rarr;</a>
        <button type="button" id="lockBtn" class="text-xs font-mono text-[var(--theme-text-muted)] hover:text-white cursor-pointer">Lock Studio</button>
        <a href="/" class="text-xs font-mono text-[var(--theme-accent)] hover:underline">&larr; Storefront</a>
      </div>
    </div>

    <!-- Top Unified Store & Queue Filter Bar -->
    <div class="bg-[#120f0d] border border-white/[0.08] rounded p-3 sm:p-4 mb-5 space-y-3">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <!-- Store Switcher -->
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-[10px] font-mono uppercase tracking-wider text-[#a89f91] mr-1">Store:</span>
          <button type="button" class="store-filter px-2.5 py-1.5 rounded bg-white/[0.18] text-xs font-mono text-white font-bold cursor-pointer" data-store="all">All (<span id="count-store-all">0</span>)</button>
          <button type="button" class="store-filter px-2.5 py-1.5 rounded bg-white/[0.05] hover:bg-white/[0.1] text-xs font-mono text-[#c5a059] cursor-pointer" data-store="photo">Photo (<span id="count-store-photo">0</span>)</button>
          <button type="button" class="store-filter px-2.5 py-1.5 rounded bg-white/[0.05] hover:bg-white/[0.1] text-xs font-mono text-[#5cc8ff] cursor-pointer" data-store="sws">SeeWhatSticks (<span id="count-store-sws">0</span>)</button>
        </div>

        <!-- Queue Status Tabs -->
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-[10px] font-mono uppercase tracking-wider text-[#a89f91] mr-1">Queue:</span>
          <button type="button" class="queue-filter px-2.5 py-1.5 rounded bg-white/[0.05] hover:bg-white/[0.1] text-xs font-mono cursor-pointer" data-queue="all">All (<span id="count-queue-all">0</span>)</button>
          <button type="button" class="queue-filter px-2.5 py-1.5 rounded bg-[#c5a059] text-black text-xs font-mono font-bold cursor-pointer" data-queue="needs_review">Needs Review (<span id="count-queue-needs_review">0</span>)</button>
          <button type="button" class="queue-filter px-2.5 py-1.5 rounded bg-white/[0.05] hover:bg-white/[0.1] text-xs font-mono text-emerald-300 cursor-pointer" data-queue="approved">Approved (<span id="count-queue-approved">0</span>)</button>
          <button type="button" class="queue-filter px-2.5 py-1.5 rounded bg-white/[0.05] hover:bg-white/[0.1] text-xs font-mono text-rose-300 cursor-pointer" data-queue="rejected">Rejected (<span id="count-queue-rejected">0</span>)</button>
        </div>
      </div>

      <!-- Prev / Dropdown / Next Stepper -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 pt-2 border-t border-white/[0.06]">
        <div class="flex items-center gap-2">
          <button type="button" id="prev-item-btn" class="px-3 py-2 rounded bg-white/[0.06] hover:bg-white/[0.14] active:scale-[0.98] text-xs font-mono text-[#f7f4ee] cursor-pointer shrink-0">&larr; Prev</button>
          <div class="flex items-center gap-2 px-2 py-1 rounded bg-[#080706] border border-white/[0.08] text-[11px] font-mono shrink-0">
            <span id="item-store-badge" class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-[#c5a059]/20 text-[#c5a059]">PHOTO</span>
            <span id="queue-pos-label" class="text-[#f7f4ee]">0 / 0</span>
          </div>
          <button type="button" id="next-item-btn" class="px-3 py-2 rounded bg-white/[0.06] hover:bg-white/[0.14] active:scale-[0.98] text-xs font-mono text-[#f7f4ee] cursor-pointer shrink-0">Next &rarr;</button>
        </div>

        <select id="artwork-select" class="flex-1 bg-[#080706] border border-white/[0.12] rounded p-2 text-sm font-mono text-[#f7f4ee]"></select>
      </div>
    </div>

    <!-- Main Workspace: Canvas top on mobile (order-1), Rubric/Details left on desktop -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">
      <!-- Viewport & Quick-Tap Mobile Actions (Top on mobile, right 2 cols on desktop) -->
      <div class="order-1 lg:order-2 lg:col-span-2 space-y-4">
        <!-- Quick-Tap Aspect Ratio Pills -->
        <div class="bg-[#120f0d] border border-white/[0.06] rounded p-2.5">
          <div class="flex items-center justify-between mb-1.5 px-1">
            <span class="text-[10px] font-mono uppercase tracking-wider text-[#a89f91]">Quick Aspect Ratio Switcher</span>
            <span id="item-category-label" class="text-[10px] font-mono text-[#c5a059]">--</span>
          </div>
          <div id="ratio-pills" class="flex items-center gap-1.5 overflow-x-auto pb-1">
            {RATIO_KEYS.map((rk) => (
              <button
                type="button"
                class="ratio-pill shrink-0 px-2.5 py-1.5 rounded border border-white/[0.1] bg-[#080706] text-xs font-mono text-[#f7f4ee] hover:border-[#c5a059] cursor-pointer transition"
                data-ratio-key={rk}
              >
                <span class="ratio-pill-label">{rk}</span>
                <span class="ratio-pill-check hidden ml-1 text-emerald-400">✓</span>
                <span class="ratio-pill-no hidden ml-1 text-rose-300">&times;</span>
              </button>
            ))}
          </div>
        </div>

        <!-- Touch Canvas -->
        <div class="flex flex-col items-center justify-center bg-[#0a0908] border border-white/[0.06] rounded p-3 sm:p-5 min-h-[380px] sm:min-h-[500px]">
          <div
            id="canvasWrapper"
            class="relative w-full flex items-center justify-center p-2 sm:p-3 rounded bg-[#070606] border border-white/[0.08] select-none"
            style="touch-action: none !important; -webkit-touch-callout: none; -webkit-user-select: none; user-select: none;"
          >
            <canvas
              id="cropCanvas"
              style="touch-action: none !important;"
              class="cursor-grab active:cursor-grabbing max-w-full max-h-[520px] shadow-2xl border border-white/[0.1] rounded select-none"
            ></canvas>
          </div>
        </div>

        <!-- Primary Action Strip -->
        <div class="bg-[#141210] border border-white/[0.08] p-4 rounded space-y-3">
          <label class="flex items-center gap-2 text-xs font-mono text-[var(--awp-text)] cursor-pointer select-none">
            <input type="checkbox" id="auto-advance-cb" checked class="accent-[var(--awp-accent)]" />
            <span>Auto-advance ratios</span>
          </label>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
            <button id="save-btn" type="button" class="bg-[var(--theme-accent)] text-black font-mono text-xs uppercase tracking-wider py-3.5 px-3 rounded font-bold hover:opacity-90 transition active:scale-[0.98] cursor-pointer">
              &check; Save Ratio
            </button>
            <button id="reject-crop-btn" type="button" class="border border-[var(--awp-border)] bg-[var(--awp-surface)] text-[var(--awp-text)] font-mono text-xs uppercase tracking-wider py-3.5 px-3 rounded font-bold hover:border-[var(--awp-accent)] transition active:scale-[0.98] cursor-pointer">
              &times; Reject Crop
            </button>
            <button id="save-next-btn" type="button" class="bg-emerald-600 hover:bg-emerald-500 text-white font-mono text-xs uppercase tracking-wider py-3.5 px-3 rounded font-bold transition active:scale-[0.98] cursor-pointer">
              Approve &amp; Next SKU &rarr;
            </button>
            <button id="reject-btn" type="button" class="bg-rose-900/70 hover:bg-rose-800 border border-rose-500/40 text-rose-100 font-mono text-xs uppercase tracking-wider py-3.5 px-3 rounded font-bold transition active:scale-[0.98] cursor-pointer">
              &times; Reject SKU
            </button>
          </div>
          <p id="status-msg" class="text-xs font-mono text-center min-h-[1rem]"></p>
        </div>
      </div>

      <!-- Left Controls Panel: Framing, Metadata, Ratio Cluster, Product Rubric -->
      <div class="contents lg:order-1 lg:block lg:space-y-5">
        <div id="framing-panel" class="order-2 lg:order-none bg-[var(--awp-surface)] border border-[var(--awp-border)] p-4 rounded space-y-3">
          <div>
            <label class="block text-xs font-mono uppercase tracking-wider text-[var(--awp-text-muted)]">Framing</label>
            <p class="mt-1 text-[11px] font-mono text-[var(--awp-text-muted)]">Drag to pan. Pinch with two fingers to zoom.</p>
          </div>

          <div class="grid grid-cols-3 gap-2">
            <button type="button" id="fit-width-btn" class="min-h-11 px-2 py-2 border border-[var(--awp-border)] bg-[var(--theme-bg)] text-[var(--awp-text)] text-xs font-mono hover:border-[var(--awp-accent)] active:scale-[0.98] cursor-pointer">Fit Width</button>
            <button type="button" id="fit-height-btn" class="min-h-11 px-2 py-2 border border-[var(--awp-border)] bg-[var(--theme-bg)] text-[var(--awp-text)] text-xs font-mono hover:border-[var(--awp-accent)] active:scale-[0.98] cursor-pointer">Fit Height</button>
            <button type="button" id="fill-bleed-btn" class="min-h-11 px-2 py-2 border border-[var(--awp-border)] bg-[var(--theme-bg)] text-[var(--awp-text)] text-xs font-mono hover:border-[var(--awp-accent)] active:scale-[0.98] cursor-pointer">Fill Bleed</button>
          </div>
          <div class="grid grid-cols-3 gap-2">
            <button type="button" id="center-h-btn" class="min-h-11 px-2 py-2 border border-[var(--awp-border)] bg-[var(--theme-bg)] text-[var(--awp-text)] text-xs font-mono hover:border-[var(--awp-accent)] active:scale-[0.98] cursor-pointer">Center H</button>
            <button type="button" id="center-v-btn" class="min-h-11 px-2 py-2 border border-[var(--awp-border)] bg-[var(--theme-bg)] text-[var(--awp-text)] text-xs font-mono hover:border-[var(--awp-accent)] active:scale-[0.98] cursor-pointer">Center V</button>
            <button type="button" id="reset-center-btn" class="min-h-11 px-2 py-2 border border-[var(--awp-border)] bg-[var(--theme-bg)] text-[var(--awp-text)] text-xs font-mono hover:border-[var(--awp-accent)] active:scale-[0.98] cursor-pointer">Reset Center</button>
          </div>

          <div class="space-y-2 border-t border-[var(--awp-border)] pt-3">
            <label class="block text-[11px] font-mono uppercase tracking-wider text-[var(--awp-text-muted)]" for="zoom-input">Zoom</label>
            <div class="flex items-center gap-2">
              <button type="button" id="zoom-step-down" class="shrink-0 min-h-11 px-3 border border-[var(--awp-border)] bg-[var(--theme-bg)] text-[var(--awp-text)] text-xs font-mono hover:border-[var(--awp-accent)] active:scale-[0.98] cursor-pointer">-0.05</button>
              <input
                type="number"
                id="zoom-input"
                inputmode="decimal"
                min="0.05"
                max="3"
                step="0.05"
                value="1.00"
                class="min-w-0 flex-1 min-h-11 bg-[var(--theme-bg)] border border-[var(--awp-border)] text-[var(--awp-text)] font-mono text-base text-center px-2 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
              />
              <span class="shrink-0 text-xs font-mono text-[var(--awp-text-muted)]">x</span>
              <button type="button" id="zoom-step-up" class="shrink-0 min-h-11 px-3 border border-[var(--awp-border)] bg-[var(--theme-bg)] text-[var(--awp-text)] text-xs font-mono hover:border-[var(--awp-accent)] active:scale-[0.98] cursor-pointer">+0.05</button>
            </div>
            <input type="range" id="zoom-slider" min="0.05" max="3" step="0.01" value="1" class="w-full accent-[var(--awp-accent)]" />
          </div>
        </div>

        <div class="order-3 lg:order-none bg-[#141210] border border-white/[0.06] p-4 rounded space-y-2">
          <label class="block text-xs font-mono uppercase tracking-wider text-[var(--theme-text-muted)]">1. Asset Specs</label>
          <div id="nativeResIndicator" class="text-xs font-mono text-[#a89f91] flex justify-between">
            <span>Native Resolution:</span>
            <span id="nativeResVal" class="text-[#f7f4ee]">--</span>
          </div>
          <div class="text-xs font-mono text-[#a89f91] flex justify-between">
            <span>Storefront Rubric:</span>
            <span id="storeRubricLabel" class="text-[#f7f4ee]">--</span>
          </div>
        </div>

        <details id="artwork-copy-panel" class="order-6 lg:order-none bg-[var(--awp-surface)] border border-[var(--awp-border)] rounded">
          <summary class="cursor-pointer px-4 py-3 text-xs font-mono uppercase tracking-wider text-[var(--awp-text-muted)]">
            Artwork Copy &amp; Metadata
          </summary>
          <div class="space-y-3 border-t border-[var(--awp-border)] px-4 py-3">
            <p id="meta-sws-note" class="hidden text-[11px] font-mono text-[var(--awp-text-muted)]">
              Copy editing applies to photo artworks.
            </p>
            <div id="meta-photo-fields" class="space-y-3">
              <label class="block space-y-1" for="meta-title">
                <span class="block text-[11px] font-mono uppercase tracking-wider text-[var(--awp-text-muted)]">Title</span>
                <input id="meta-title" type="text" autocomplete="off" class="w-full min-h-11 bg-transparent border border-[var(--awp-border)] text-[var(--awp-text)] font-mono text-sm px-2" />
              </label>
              <label class="block space-y-1" for="meta-slug">
                <span class="block text-[11px] font-mono uppercase tracking-wider text-[var(--awp-text-muted)]">Slug</span>
                <input id="meta-slug" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" pattern="[a-z0-9-]+" class="w-full min-h-11 bg-transparent border border-[var(--awp-border)] text-[var(--awp-text)] font-mono text-sm px-2" />
                <span class="block text-[11px] font-mono text-[var(--awp-text-muted)]">
                  Lowercase letters, numbers, and hyphens. The artwork id and Backblaze master_file stay unchanged. Changing this slug 301-redirects /artwork/old-slug to /artwork/new-slug.
                </span>
              </label>
              <label class="block space-y-1" for="meta-caption">
                <span class="block text-[11px] font-mono uppercase tracking-wider text-[var(--awp-text-muted)]">Caption</span>
                <input id="meta-caption" type="text" autocomplete="off" class="w-full min-h-11 bg-transparent border border-[var(--awp-border)] text-[var(--awp-text)] font-mono text-sm px-2" />
              </label>
              <div class="space-y-1">
                <div class="flex items-center justify-between gap-2">
                  <label class="text-[11px] font-mono uppercase tracking-wider text-[var(--awp-text-muted)]" for="meta-description">Description</label>
                  <span id="meta-description-count" class="text-[11px] font-mono text-[var(--awp-text-muted)]">0 / {ARTWORK_DESCRIPTION_MAX}</span>
                </div>
                <textarea id="meta-description" rows="4" maxlength={ARTWORK_DESCRIPTION_MAX} class="w-full bg-transparent border border-[var(--awp-border)] text-[var(--awp-text)] font-mono text-sm px-2 py-2"></textarea>
              </div>
              <fieldset class="space-y-2 border border-[var(--awp-border)] p-2">
                <legend class="px-1 text-[11px] font-mono uppercase tracking-wider text-[var(--awp-text-muted)]">Collections</legend>
                <div id="meta-collections" class="max-h-36 space-y-1 overflow-y-auto"></div>
                <div class="flex items-center gap-2">
                  <input id="meta-new-collection" type="text" autocomplete="off" autocapitalize="none" spellcheck="false" pattern="[a-z0-9-]+" placeholder="new-collection" class="min-w-0 flex-1 min-h-11 bg-transparent border border-[var(--awp-border)] text-[var(--awp-text)] font-mono text-sm px-2" />
                  <button type="button" id="meta-add-collection" class="shrink-0 min-h-11 px-3 border border-[var(--awp-border)] bg-[var(--awp-surface)] text-[var(--awp-text)] text-xs font-mono hover:border-[var(--awp-accent)] cursor-pointer">Add</button>
                </div>
              </fieldset>
              <label class="block space-y-1" for="meta-tags">
                <span class="block text-[11px] font-mono uppercase tracking-wider text-[var(--awp-text-muted)]">Tags</span>
                <input id="meta-tags" type="text" autocomplete="off" placeholder="comma, separated, tags" class="w-full min-h-11 bg-transparent border border-[var(--awp-border)] text-[var(--awp-text)] font-mono text-sm px-2" />
              </label>
              <button id="save-metadata-btn" type="button" class="w-full bg-[var(--awp-accent)] text-[var(--awp-surface)] font-mono text-xs uppercase tracking-wider py-3.5 px-3 rounded font-bold hover:opacity-90 transition active:scale-[0.98] cursor-pointer">
                Save Metadata
              </button>
            </div>
          </div>
        </details>

        <div class="order-4 lg:order-none bg-[#141210] border border-white/[0.06] p-4 rounded">
          <label class="block text-xs font-mono uppercase tracking-wider text-[var(--theme-text-muted)] mb-2">2. Aspect Ratio Cluster</label>
          <select id="ratio-select" class="w-full bg-[#080706] border border-white/[0.1] rounded p-2.5 text-sm font-mono text-[#f7f4ee]">
            {RATIO_KEYS.map((rk) => (
              <option value={rk} data-ratio={String(RATIO_MAP[rk])}>{RATIO_LABELS[rk]}</option>
            ))}
          </select>
        </div>

        <!-- Product Rubric & Vendor Batch Selectors -->
        <div class="order-5 lg:order-none space-y-3 bg-[#141210] border border-white/[0.06] p-4 rounded">
          <div class="flex items-center justify-between pb-1 border-b border-white/[0.04]">
            <label class="block text-xs font-mono uppercase tracking-wider text-[var(--theme-text-muted)]">3. Product Rubric</label>
            <button type="button" id="toggle-all-btn" class="text-[10px] font-mono text-[var(--theme-accent)] hover:underline cursor-pointer">Toggle All</button>
          </div>

          <div class="flex flex-wrap gap-1.5 pt-1">
            <button type="button" class="vendor-filter px-2 py-1 rounded bg-white/[0.15] text-[10px] font-mono text-white cursor-pointer" data-vendor="all">All Vendors</button>
            <button type="button" class="vendor-filter px-2 py-1 rounded bg-white/[0.04] hover:bg-white/[0.1] text-[10px] font-mono text-[#c5a059] cursor-pointer" data-vendor="Prodigi">Prodigi</button>
            <button type="button" class="vendor-filter px-2 py-1 rounded bg-white/[0.04] hover:bg-white/[0.1] text-[10px] font-mono text-[#5cc8ff] cursor-pointer" data-vendor="Printify">Printify</button>
            <button type="button" class="vendor-filter px-2 py-1 rounded bg-white/[0.04] hover:bg-white/[0.1] text-[10px] font-mono text-[#ff80bf] cursor-pointer" data-vendor="Printful">Printful</button>
            <button type="button" class="vendor-filter px-2 py-1 rounded bg-white/[0.04] hover:bg-white/[0.1] text-[10px] font-mono text-[#ffd43b] cursor-pointer" data-vendor="Gelato">Gelato</button>
            <button type="button" class="vendor-filter px-2 py-1 rounded bg-white/[0.04] hover:bg-white/[0.1] text-[10px] font-mono text-[#ff922b] cursor-pointer" data-vendor="Displate">Displate</button>
          </div>

          <div id="product-rubric-container" class="space-y-2 max-h-80 overflow-y-auto pr-1"></div>
        </div>
      </div>
    </div>
  </main>

  <!-- SCRIPT 1: AUTHENTICATION ENGINE -->
  <script is:inline>
    (function() {
      window.onerror = function(msg, url, line) {
        var banner = document.getElementById('runtimeCrashBanner');
        if (banner) {
          banner.style.display = 'block';
          banner.innerText = 'Script Error: ' + msg + ' (Line: ' + line + ')';
