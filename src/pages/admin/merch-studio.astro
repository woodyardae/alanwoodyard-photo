    if (prevItemBtn) prevItemBtn.addEventListener('click', () => stepQueue(-1));
    if (nextItemBtn) nextItemBtn.addEventListener('click', () => stepQueue(1));

    function getCanvasDims() {
      const opt = ratioSelect.selectedOptions[0];
      const targetRatio = parseFloat(opt ? opt.getAttribute('data-ratio') || '1' : '1');
      const containerWidth = (canvasWrapper && canvasWrapper.clientWidth > 0) ? canvasWrapper.clientWidth : 700;
      const maxW = Math.max(280, Math.min(containerWidth - 32, 700));
      const maxH = 500;
      let w = maxW;
      let h = w / targetRatio;
      if (h > maxH) {
        h = maxH;
        w = h * targetRatio;
      }
      return { w: Math.round(w), h: Math.round(h) };
    }

    function applyDeskMatPanGuard() {
      const ratio = ratioSelect.value;
      if (!DESK_MAT_RATIOS.has(ratio)) return;
      const h = canvas.height || getCanvasDims().h || 500;
      const maxDown = h * DESK_MAT_MAX_DOWN_PAN;
      const maxUp = h * DESK_MAT_KEYBOARD_ZONE;
      panY = Math.max(-maxUp, Math.min(maxDown, panY));
    }

    function draw() {
      applyDeskMatPanGuard();
      const { w, h } = getCanvasDims();
      if (canvas.width !== w || canvas.height !== h) {
        canvas.width = w;
        canvas.height = h;
      }

      ctx.fillStyle = '#0a0908';
      ctx.fillRect(0, 0, w, h);

      const art = getSelectedArtwork();
      if (!art) {
        ctx.fillStyle = '#a89f91';
        ctx.font = '13px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('Queue empty for current filter.', w / 2, h / 2);
        ctx.textAlign = 'start';
        return;
      }

      if (currentImg && currentImg.complete && currentImg.naturalWidth > 0) {
        const baseScale = Math.max(w / currentImg.naturalWidth, h / currentImg.naturalHeight);
        const scale = baseScale * zoom;
        const drawW = currentImg.naturalWidth * scale;
        const drawH = currentImg.naturalHeight * scale;

        const drawX = (w - drawW) / 2 + panX;
        const drawY = (h - drawH) / 2 + panY;

        ctx.drawImage(currentImg, drawX, drawY, drawW, drawH);
      } else {
        ctx.fillStyle = '#c5a059';
        ctx.font = '12px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('Loading preview image...', w / 2, h / 2);
        ctx.textAlign = 'start';
      }

      // Safe Bleed Area Guide
      ctx.strokeStyle = 'rgba(197, 160, 89, 0.45)';
      ctx.lineWidth = 1;
      ctx.setLineDash([4, 4]);
      ctx.strokeRect(w * 0.05, h * 0.05, w * 0.9, h * 0.9);
      ctx.setLineDash([]);
    }

    function setZoom(val) {
      const n = Number(val);
      if (!Number.isFinite(n)) return;
      zoom = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, n));
      syncZoomUi();
      draw();
    }

    function syncZoomUi() {
      const shown = zoom.toFixed(2);
      if (zoomSlider) zoomSlider.value = shown;
      if (zoomInput && document.activeElement !== zoomInput) zoomInput.value = shown;
    }

    function frameRatio() {
      const opt = ratioSelect.selectedOptions[0];
      const parsed = parseFloat(opt ? opt.getAttribute('data-ratio') || '1' : '1');
      return Number.isFinite(parsed) && parsed > 0 ? parsed : 1;
    }

    function sourceRatio() {
      if (!currentImg || !currentImg.complete || !currentImg.naturalWidth || !currentImg.naturalHeight) return null;
      return currentImg.naturalWidth / currentImg.naturalHeight;
    }

    function fitWidth() {
      const src = sourceRatio();
      if (src == null) return;
      const frame = frameRatio();
      panX = 0;
      setZoom(src > frame ? frame / src : 1);
    }

    function fitHeight() {
      const src = sourceRatio();
      if (src == null) return;
      const frame = frameRatio();
      panY = 0;
      setZoom(src < frame ? src / frame : 1);
    }

    function fillBleed() {
      panX = 0;
      panY = 0;
      setZoom(1);
    }

    function stepZoom(delta) {
      setZoom(Math.round((zoom + delta) * 100) / 100);
    }

    function collectionChoices() {
      const names = new Set(knownCollections);
      catalogData.forEach((item) => {
        const list = Array.isArray(item.collections) ? item.collections : [];
        list.forEach((name) => {
          if (typeof name === 'string' && name) names.add(name);
        });
      });
      return Array.from(names).sort();
    }

    function selectedCollections() {
      if (!metaCollections) return [];
      return Array.from(metaCollections.querySelectorAll('.meta-collection-cb:checked')).map((box) => box.value);
    }

    function renderCollections(selected) {
      if (!metaCollections) return;
      const selectedSet = new Set(Array.isArray(selected) ? selected : []);
      metaCollections.innerHTML = '';
      collectionChoices().forEach((name) => {
        const label = document.createElement('label');
        label.className = 'flex items-center gap-2 text-xs font-mono text-[var(--awp-text)]';
        const input = document.createElement('input');
        input.type = 'checkbox';
