---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const artworks = await getCollection('artworks');
const catalog = artworks.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Layout title="Merchandise Studio | Alan Woodyard">
  <main class="w-full max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10 font-sans text-[#f7f4ee]">
    <div class="mb-6 flex flex-wrap items-baseline justify-between border-b border-white/[0.08] pb-4 gap-4">
      <div>
        <h1 class="text-xl sm:text-2xl font-serif tracking-wide text-[#f7f4ee]">Merchandise Framing Studio</h1>
        <p class="text-xs font-mono text-[#a89f91] mt-1">Configure crops, safe bleeds, and watermark positions</p>
      </div>
      <div class="flex gap-4 text-xs font-mono">
        <a href="/admin/syndication" class="text-[#8e8577] hover:text-[#f7f4ee]">&larr; Syndication Desk</a>
        <a href="/" class="text-[#c5a059] hover:underline">Storefront &rarr;</a>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
      <!-- Canvas Viewport -->
      <div class="lg:col-span-8 bg-[#0a0908] border border-white/[0.08] p-4 sm:p-6 flex flex-col items-center rounded-[1px]">
        <div class="relative w-full aspect-[4/3] bg-[#050505] border border-white/[0.04] overflow-hidden flex items-center justify-center select-none" id="viewport">
          <canvas 
            id="cropCanvas" 
            class="max-w-full max-h-full cursor-grab active:cursor-grabbing"
            style="touch-action: none;"
          ></canvas>
        </div>

        <div class="w-full mt-4 flex flex-wrap items-center justify-between gap-4 text-xs font-mono text-[#8e8577]">
          <div class="flex items-center gap-3">
            <span>Scale:</span>
            <input type="range" id="zoomSlider" min="1" max="3" step="0.05" value="1" class="w-28 sm:w-36 accent-[#c5a059]" />
            <span id="zoomVal">1.00x</span>
          </div>
          <div class="flex items-center gap-4">
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" id="gridToggle" checked class="accent-[#c5a059]" />
              <span>Thirds Grid</span>
            </label>
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" id="bleedToggle" checked class="accent-[#c5a059]" />
              <span>Bleed Safe Area</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Controls -->
      <div class="lg:col-span-4 bg-[#141210] border border-white/[0.08] p-4 sm:p-6 space-y-6 rounded-[1px]">
        <div>
          <label class="block text-xs font-mono uppercase tracking-widest text-[#a89f91] mb-2">Photograph</label>
          <select id="artworkSelect" class="w-full text-xs font-mono bg-[#0a0908] border border-white/[0.1] p-3 text-[#f7f4ee]">
            {catalog.map((item) => (
              <option value={item.id}>
                {item.data.title}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label class="block text-xs font-mono uppercase tracking-widest text-[#a89f91] mb-2">Product Target</label>
          <select id="productSelect" class="w-full text-xs font-mono bg-[#0a0908] border border-white/[0.1] p-3 text-[#f7f4ee]">
            <option value="displate_p" data-w="20" data-h="29">Displate Steel (20:29 Portrait)</option>
            <option value="displate_l" data-w="29" data-h="20">Displate Steel (29:20 Landscape)</option>
            <option value="deskmat" data-w="16" data-h="7">Desk Pad (16:7 Ultrawide)</option>
            <option value="frame_4x5" data-w="4" data-h="5">Standard Frame (4:5)</option>
            <option value="square" data-w="1" data-h="1">Square Coaster / Tile (1:1)</option>
            <option value="wrap_pano" data-w="2" data-h="1">Panoramic Canvas (2:1)</option>
          </select>
        </div>

        <div class="border-t border-white/[0.08] pt-4 space-y-3">
          <label class="block text-xs font-mono uppercase tracking-widest text-[#a89f91]">Watermark Placement</label>
          <div class="grid grid-cols-3 gap-2 text-xs font-mono">
            <button type="button" class="wm-choice p-2.5 border border-[#c5a059]/40 bg-[#1f1d1a] text-[#dfb872]" data-wm="br">Bottom-R</button>
            <button type="button" class="wm-choice p-2.5 border border-white/[0.1] bg-[#0a0908] text-[#8e8577]" data-wm="bl">Bottom-L</button>
            <button type="button" class="wm-choice p-2.5 border border-white/[0.1] bg-[#0a0908] text-[#8e8577]" data-wm="none">None</button>
          </div>
        </div>

        <div class="border-t border-white/[0.08] pt-6 space-y-3">
          <button type="button" id="approveBtn" class="w-full py-3.5 bg-[#2a241c] border border-[#c5a059] text-xs font-mono text-[#dfb872] hover:bg-[#c5a059] hover:text-[#0a0908] transition-colors font-bold uppercase tracking-wider">
            Save Crop Approval
          </button>
          <p id="statusMsg" class="text-xs font-mono text-center text-[#8e8577] min-h-[1.5rem]"></p>
        </div>
      </div>
    </div>
  </main>

  <script>
    const canvas = document.getElementById('cropCanvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const artworkSelect = document.getElementById('artworkSelect') as HTMLSelectElement;
    const productSelect = document.getElementById('productSelect') as HTMLSelectElement;
    const zoomSlider = document.getElementById('zoomSlider') as HTMLInputElement;
    const zoomVal = document.getElementById('zoomVal') as HTMLElement;
    const gridToggle = document.getElementById('gridToggle') as HTMLInputElement;
    const bleedToggle = document.getElementById('bleedToggle') as HTMLInputElement;
    const approveBtn = document.getElementById('approveBtn') as HTMLButtonElement;
    const statusMsg = document.getElementById('statusMsg') as HTMLElement;

    let img = new Image();
    let panX = 0;
    let panY = 0;
    let zoom = 1.0;
    let isDragging = false;
    let startX = 0;
    let startY = 0;
    let wmPosition = 'br';

    function getTargetRatio(): number {
      const opt = productSelect.selectedOptions[0];
      const w = parseFloat(opt.dataset.w || '1');
      const h = parseFloat(opt.dataset.h || '1');
      return w / h;
    }

    function draw() {
      if (!img.complete || !img.naturalWidth) return;

      const ratio = getTargetRatio();
      const maxW = 720;
      const maxH = 540;

      let targetW = maxW;
      let targetH = targetW / ratio;
      if (targetH > maxH) {
        targetH = maxH;
        targetW = targetH * ratio;
      }

      canvas.width = targetW;
      canvas.height = targetH;

      ctx.fillStyle = '#050505';
      ctx.fillRect(0, 0, targetW, targetH);

      const srcRatio = img.naturalWidth / img.naturalHeight;
      let drawW: number;
      let drawH: number;

      if (srcRatio > ratio) {
        drawH = targetH * zoom;
        drawW = drawH * srcRatio;
      } else {
        drawW = targetW * zoom;
        drawH = drawW / srcRatio;
      }

      const drawX = (targetW - drawW) / 2 + panX;
      const drawY = (targetH - drawH) / 2 + panY;

      ctx.drawImage(img, drawX, drawY, drawW, drawH);

      if (gridToggle.checked) {
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.2)';
        ctx.lineWidth = 1;
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(targetW / 3, 0); ctx.lineTo(targetW / 3, targetH);
        ctx.moveTo((targetW * 2) / 3, 0); ctx.lineTo((targetW * 2) / 3, targetH);
        ctx.moveTo(0, targetH / 3); ctx.lineTo(targetW, targetH / 3);
        ctx.moveTo(0, (targetH * 2) / 3); ctx.lineTo(targetW, (targetH * 2) / 3);
        ctx.stroke();
        ctx.setLineDash([]);
      }

      if (bleedToggle.checked) {
        ctx.strokeStyle = 'rgba(197, 160, 89, 0.5)';
        ctx.lineWidth = 1;
        const inset = Math.min(targetW, targetH) * 0.05;
        ctx.strokeRect(inset, inset, targetW - inset * 2, targetH - inset * 2);
      }

      if (wmPosition !== 'none') {
        ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
        ctx.font = '10px monospace';
        const label = 'ALAN WOODYARD';
        if (wmPosition === 'br') ctx.fillText(label, targetW - 110, targetH - 12);
        if (wmPosition === 'bl') ctx.fillText(label, 12, targetH - 12);
      }
    }

    function switchPhoto() {
      img.src = `/images/artworks/${artworkSelect.value}.webp`;
      img.onload = () => {
        panX = 0;
        panY = 0;
        zoom = 1.0;
        zoomSlider.value = '1';
        zoomVal.textContent = '1.00x';
        draw();
      };
    }

    artworkSelect.addEventListener('change', switchPhoto);
    productSelect.addEventListener('change', () => { panX = 0; panY = 0; draw(); });

    zoomSlider.addEventListener('input', () => {
      zoom = parseFloat(zoomSlider.value);
      zoomVal.textContent = `${zoom.toFixed(2)}x`;
      draw();
    });

    gridToggle.addEventListener('change', draw);
    bleedToggle.addEventListener('change', draw);

    // Universal Pointer Events (Touch, Pencil, Mouse)
    canvas.addEventListener('pointerdown', (e) => {
      isDragging = true;
      startX = e.clientX - panX;
      startY = e.clientY - panY;
      canvas.setPointerCapture(e.pointerId);
    });

    canvas.addEventListener('pointermove', (e) => {
      if (!isDragging) return;
      panX = e.clientX - startX;
      panY = e.clientY - startY;
      draw();
    });

    const endDrag = (e: PointerEvent) => {
      if (isDragging) {
        isDragging = false;
        try { canvas.releasePointerCapture(e.pointerId); } catch (_) {}
      }
    };

    canvas.addEventListener('pointerup', endDrag);
    canvas.addEventListener('pointercancel', endDrag);

    document.querySelectorAll('.wm-choice').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.wm-choice').forEach((b) => {
          b.className = 'wm-choice p-2.5 border border-white/[0.1] bg-[#0a0908] text-[#8e8577]';
        });
        btn.className = 'wm-choice p-2.5 border border-[#c5a059]/40 bg-[#1f1d1a] text-[#dfb872]';
        wmPosition = btn.getAttribute('data-wm') || 'none';
        draw();
      });
    });

    approveBtn.addEventListener('click', async () => {
      const id = artworkSelect.value;
      const product = productSelect.options[productSelect.selectedIndex].text;
      approveBtn.disabled = true;
      statusMsg.textContent = 'Saving...';

      try {
        const res = await fetch('/api/approve-merch', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id,
            product,
            crop: { panX, panY, zoom, ratio: getTargetRatio() },
            watermark: wmPosition,
          }),
        });

        if (res.ok) {
          statusMsg.textContent = `Approved: ${product}`;
          statusMsg.className = 'text-xs font-mono text-center text-[#c5a059]';
        } else {
          statusMsg.textContent = 'Save failed.';
          statusMsg.className = 'text-xs font-mono text-center text-red-400';
        }
      } catch (err) {
        statusMsg.textContent = 'Network error.';
        statusMsg.className = 'text-xs font-mono text-center text-red-400';
      } finally {
        approveBtn.disabled = false;
      }
    });

    switchPhoto();
  </script>
</Layout>