    function stepQueue(delta) {
      if (!filteredQueue.length) return;
      const idx = filteredQueue.findIndex((a) => a.id === artworkSelect.value);
      const nextIdx = (idx + delta + filteredQueue.length) % filteredQueue.length;
      artworkSelect.value = filteredQueue[nextIdx].id;
