---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Acquisition Checkout | Alan Woodyard Photography" theme="walnut">
  <Header />

  <main class="w-full max-w-7xl mx-auto px-6 lg:px-12 py-12 flex-1">
    <div class="mb-8">
      <a href="/artworks" class="inline-flex items-center gap-2 text-xs font-mono text-[var(--theme-text-muted)] hover:text-[var(--theme-accent)] transition-colors">
        <span>&larr;</span>
        <span class="tracking-widest uppercase text-[11px]">Return to Exhibition Gallery</span>
      </a>
    </div>

    <!-- Empty State Container -->
    <div id="emptyCheckout" class="hidden text-center py-20 font-mono text-xs text-[var(--theme-text-muted)] space-y-4">
      <p>Your collector cart is currently empty.</p>
      <a href="/artworks" class="inline-block px-6 py-2.5 border border-[var(--theme-accent)] text-[var(--theme-accent)] hover:bg-[var(--theme-accent)] hover:text-[var(--theme-bg)] transition-colors uppercase tracking-widest text-[11px]">
        Explore Artworks &rarr;
      </a>
    </div>

    <!-- Active Checkout Grid -->
    <div id="activeCheckout" class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Acquisition Review -->
      <section class="lg:col-span-5 space-y-8 font-sans">
        <div>
          <span class="text-[11px] font-mono text-[var(--theme-accent)] tracking-[0.25em] uppercase block mb-1">
            Order Review
          </span>
          <h1 class="font-serif text-2xl lg:text-3xl tracking-wide text-[var(--theme-text)] font-light">
            Purchase Summary
          </h1>
        </div>

        <!-- Selected Pieces -->
        <div id="checkoutItemsList" class="space-y-3 border-t border-[var(--theme-border)] pt-6"></div>

        <!-- Lab Packaging & Shipping Note -->
        <div id="checkoutShippingBreakdown" class="space-y-3 border-t border-[var(--theme-border)] pt-6 font-mono text-xs">
          <span class="text-[10px] uppercase tracking-widest text-[var(--theme-accent)] block">
            Fulfillment & Packaging
          </span>
          <p class="holiday-ship-note">
            <strong>Order by Dec. 7 for economy, or Dec. 9 for standard, for Christmas Delivery.&nbsp;</strong>
            Contiguous-US orders submitted by Dec. 7 for economy shipping, or by Dec. 9 for standard shipping, have the best chance of arrival by Dec. 24. This is not a delivery guarantee. Printify adds a $0.40 US shipping surcharge from Oct. 15, 2026 through Jan. 17, 2027. Alaska, Hawaii, and US territories need extra transit time.
          </p>
          <div id="checkoutPackageCards" class="space-y-2"></div>
        </div>

        <!-- Pricing Totals -->
        <div class="border-t border-[var(--theme-border)] pt-6 space-y-2 font-mono text-xs">
          <div class="flex justify-between text-[var(--theme-text-muted)]">
            <span>Prints & Substrates</span>
            <span id="summarySubtotal" class="text-[var(--theme-text)] font-sans text-sm">$0.00</span>
          </div>
          <div class="flex justify-between text-[var(--theme-text-muted)]">
            <span>Insured Art Freight</span>
            <span id="summaryFreight" class="text-[var(--theme-accent)]">Included</span>
          </div>
          <div class="border-t border-[var(--theme-border)] pt-3 flex justify-between items-baseline">
            <span class="font-serif text-sm tracking-wider uppercase text-[var(--theme-text)]">Total Acquisition</span>
            <span id="summaryTotal" class="font-serif text-2xl text-[var(--theme-accent)]">$0.00</span>
          </div>
        </div>

        <!-- Trust Badges -->
        <div class="p-4 border border-[var(--theme-border)] bg-[var(--theme-surface)]/50 font-mono text-[11px] text-[var(--theme-text-muted)] space-y-1.5 leading-relaxed">
          <p class="flex items-center gap-2 text-[var(--theme-text)] font-medium">
            <span>🔒</span>
            <span>256-Bit Encrypted Direct Checkout</span>
          </p>
          <p>&bull; All fine-art gicl&eacute;es inspected and hand-packed in rigid archival containers.</p>
          <p>&bull; Insured carrier transit with live digital tracking provided at dispatch.</p>
        </div>
      </section>

      <!-- Right Column: Integrated Stripe Embedded Checkout -->
      <section class="lg:col-span-7 bg-[var(--theme-surface)] border border-[var(--theme-border)] p-6 lg:p-8 shadow-2xl relative min-h-[460px]">
        <div id="paymentLoading" class="absolute inset-0 flex flex-col items-center justify-center font-mono text-xs text-[var(--theme-text-muted)] gap-3 bg-[var(--theme-surface)] z-10">
          <div class="w-6 h-6 border-2 border-[var(--theme-accent)] border-t-transparent rounded-full animate-spin"></div>
          <span>Mounting secure payment gateway...</span>
        </div>

        <!-- Real Stripe Embedded Checkout Mount Target -->
        <div id="stripe-checkout" class="w-full"></div>

        <div id="checkoutRecovery" class="hidden py-8 px-6 text-center space-y-5 font-mono">
          <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--theme-text)]">
            Item unavailable
          </h2>
          <p id="checkoutRecoveryMessage" class="text-xs text-[var(--theme-text-muted)] max-w-md mx-auto leading-relaxed"></p>
          <p id="checkoutRecoveryItem" class="text-xs text-[var(--theme-text)]"></p>
          <p id="checkoutRecoveryDetail" class="text-[11px] text-[var(--theme-text-muted)] max-w-md mx-auto leading-relaxed"></p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <button
              type="button"
              id="removeUnavailableBtn"
              class="px-6 py-3 bg-[var(--theme-accent)] text-[var(--theme-bg)] hover:bg-[var(--theme-accent-hover)] font-mono text-xs uppercase tracking-widest font-bold transition-colors"
            >
              Remove Unavailable Item
            </button>
            <button
              type="button"
              id="resetCartBtn"
              class="px-6 py-3 border border-[var(--theme-accent)] text-[var(--theme-accent)] hover:bg-[var(--theme-accent)] hover:text-[var(--theme-bg)] font-mono text-xs uppercase tracking-widest font-bold transition-colors"
            >
              Reset Cart
            </button>
          </div>
        </div>

        <!-- Fallback Sandbox Mode -->
        <div id="simulatedPaymentPanel" class="hidden py-8 px-6 text-center space-y-6 font-mono">
          <div class="inline-block p-3 rounded-full bg-[var(--theme-accent)]/10 text-[var(--theme-accent)] text-xl">
            🛠️
          </div>
          <div>
            <h2 class="text-sm font-bold uppercase tracking-wider text-[var(--theme-text)]">
              Sandbox Test Environment Active
            </h2>
            <p class="text-xs text-[var(--theme-text-muted)] mt-2 max-w-md mx-auto leading-relaxed">
              Stripe API is operating in local mock mode. You can test the acquisition pipeline without entering card details.
            </p>
          </div>

          <button
            type="button"
            id="mockAcquireBtn"
            class="px-8 py-3.5 bg-[var(--theme-accent)] text-[var(--theme-bg)] hover:bg-[var(--theme-accent-hover)] font-mono text-xs uppercase tracking-widest font-bold transition-colors"
          >
            Complete Mock Acquisition &rarr;
          </button>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script>
  import { 
    $cartItems, 
    $cartSubtotal, 
    $fulfillmentPackages, 
    $totalShipping,
    CART_MAX_QUANTITY,
    clearCart,
    removeItem,
    updateItemQuantity,
    type CartItem,
  } from '../stores/cart';
  import {
    createCheckoutFlightGuard,
    escapeCheckoutText,
    getOrCreateCheckoutNonce,
    identifyUnavailableCartItem,
    isRecoverableCartFailure,
    readStoredCartItems,
    rememberCheckoutNonce,
    storedCartNeedsHeal,
    type CheckoutSkuFailure,
  } from '../lib/checkout-recovery';

  const emptyContainer = document.getElementById('emptyCheckout')!;
  const activeContainer = document.getElementById('activeCheckout')!;
  const itemsList = document.getElementById('checkoutItemsList')!;
  const packageCards = document.getElementById('checkoutPackageCards')!;
  const summarySubtotal = document.getElementById('summarySubtotal')!;
  const summaryFreight = document.getElementById('summaryFreight')!;
  const summaryTotal = document.getElementById('summaryTotal')!;
  const loading = document.getElementById('paymentLoading')!;
  const simPanel = document.getElementById('simulatedPaymentPanel')!;
  const mockBtn = document.getElementById('mockAcquireBtn')!;
  const recovery = document.getElementById('checkoutRecovery')!;
  const recoveryMessage = document.getElementById('checkoutRecoveryMessage')!;
  const recoveryItem = document.getElementById('checkoutRecoveryItem')!;
  const recoveryDetail = document.getElementById('checkoutRecoveryDetail')!;
  const removeBtn = document.getElementById('removeUnavailableBtn') as HTMLButtonElement;
  const resetBtn = document.getElementById('resetCartBtn') as HTMLButtonElement;
  const stripeMount = document.getElementById('stripe-checkout')!;
  const loadingMarkup = loading.innerHTML;
  const flight = createCheckoutFlightGuard();

  let unavailableItemId = '';
  let stripeCheckout: { destroy?: () => void } | null = null;
  let checkoutTask: Promise<void> | null = null;
  let queuedCheckout = false;
  let acceptCartUpdates = false;

  function quantityControls(item: CartItem): string {
    const title = escapeCheckoutText(item.artworkTitle || 'item');
    const id = escapeCheckoutText(item.id);
    const atMax = item.quantity >= CART_MAX_QUANTITY;
    const decreaseLabel =
      item.quantity <= 1 ? `Remove ${title} from cart` : `Decrease quantity of ${title}`;
    return `
      <div class="mt-2 inline-flex items-center gap-1" role="group" aria-label="Quantity for ${title}">
        <button type="button" data-qty-dec="${id}" aria-label="${decreaseLabel}" class="inline-flex min-h-11 min-w-11 items-center justify-center border border-[var(--awp-border)] bg-[var(--awp-surface)] font-mono text-sm text-[var(--awp-text)] hover:border-[var(--awp-accent)] hover:text-[var(--awp-accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--awp-accent)]">-</button>
        <span class="min-w-6 text-center font-mono text-xs text-[var(--awp-text)]" aria-live="polite">${item.quantity}</span>
        <button type="button" data-qty-inc="${id}" aria-label="Increase quantity of ${title}" class="inline-flex min-h-11 min-w-11 items-center justify-center border border-[var(--awp-border)] bg-[var(--awp-surface)] font-mono text-sm text-[var(--awp-text)] hover:border-[var(--awp-accent)] hover:text-[var(--awp-accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--awp-accent)] disabled:cursor-not-allowed disabled:opacity-40" ${atMax ? 'disabled' : ''}>+</button>
      </div>
    `;
  }

  function loadCartItems(): CartItem[] {
    if (typeof localStorage !== 'undefined') {
      const raw = localStorage.getItem('awp_cart_items');
      if (storedCartNeedsHeal(raw)) {
        const healed = readStoredCartItems(raw);
        $cartItems.set(healed);
        return healed;
      }
    }
    const current = $cartItems.get();
    return Array.isArray(current) ? current : [];
  }

  function showEmpty() {
    emptyContainer.classList.remove('hidden');
    activeContainer.classList.add('hidden');
    recovery.classList.add('hidden');
    unavailableItemId = '';
  }

  function showLoading() {
    loading.classList.remove('hidden', 'text-red-400');
    loading.innerHTML = loadingMarkup;
    recovery.classList.add('hidden');
    simPanel.classList.add('hidden');
  }

  function showFatal(message: string) {
    loading.classList.remove('hidden');
    loading.classList.add('text-red-400');
    loading.textContent = message;
    recovery.classList.add('hidden');
  }

  function clearStripeMount() {
    if (stripeCheckout && typeof stripeCheckout.destroy === 'function') {
      stripeCheckout.destroy();
    }
    stripeCheckout = null;
    stripeMount.innerHTML = '';
  }

  function showRecovery(items: CartItem[], failure: CheckoutSkuFailure) {
    const match = identifyUnavailableCartItem(items, failure);
    unavailableItemId = match?.id || '';
    loading.classList.add('hidden');
    simPanel.classList.add('hidden');
    recovery.classList.remove('hidden');
    recoveryMessage.textContent = match
      ? 'This item is not available for checkout. Remove it to continue, or reset the cart.'
      : 'Checkout could not price a cart item. Reset the cart and add the pieces again.';
    recoveryItem.textContent = match
      ? `${match.artworkTitle || 'Cart item'} · ${match.variantTitle || match.sku}`
      : '';
    recoveryDetail.textContent = failure.error || '';
    removeBtn.classList.toggle('hidden', !match);
    removeBtn.disabled = false;
    resetBtn.disabled = false;
  }

  async function mountCheckout(items: CartItem[]) {
    clearStripeMount();
    showLoading();
    // A per-cart attempt nonce reused via sessionStorage so a reload or a double
    // submit within the same cart reuses the same Stripe idempotency key. Cart
    // edits clear it, and a Stripe idempotency mismatch rotates it once.
    const nonce =
      typeof sessionStorage !== 'undefined' ? getOrCreateCheckoutNonce(items, sessionStorage) : '';
    const res = await fetch('/api/create-checkout-session', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ items, nonce }),
    });

    let data: CheckoutSkuFailure & {
      simulated?: boolean;
      returnUrl?: string;
      clientSecret?: string;
      publishableKey?: string;
      attemptNonce?: string;
    } = {};
    try {
      data = await res.json();
    } catch {
      throw new Error('Checkout failed');
    }

    if (!res.ok || data.error) {
      if (isRecoverableCartFailure(data)) {
        showRecovery(items, data);
        return;
      }
      throw new Error(data.error || 'Failed to initialize session');
    }

    if (
      typeof data.attemptNonce === 'string' &&
      data.attemptNonce &&
      typeof sessionStorage !== 'undefined'
    ) {
      rememberCheckoutNonce(items, data.attemptNonce, sessionStorage);
    }

    loading.classList.add('hidden');

    if (data.simulated) {
      if (import.meta.env.PROD) {
        throw new Error('Secure checkout is unavailable.');
      }
      simPanel.classList.remove('hidden');
      mockBtn.onclick = () => {
        if (data.returnUrl) window.location.href = data.returnUrl;
      };
      return;
    }

    if (data.clientSecret && data.publishableKey) {
      if (!(window as any).Stripe) {
        await new Promise<void>((resolve, reject) => {
          const script = document.createElement('script');
          script.src = 'https://js.stripe.com/v3/';
          script.onload = () => resolve();
          script.onerror = () => reject(new Error('Failed to load Stripe.js'));
          document.head.appendChild(script);
        });
      }

      const stripe = (window as any).Stripe(data.publishableKey);
      const checkout = await stripe.initEmbeddedCheckout({
        clientSecret: data.clientSecret,
      });
      stripeCheckout = checkout;
      checkout.mount('#stripe-checkout');
      return;
    }

    throw new Error('Failed to initialize session');
  }

  async function init() {
    return flight.start(async () => {
      removeBtn.disabled = true;
      resetBtn.disabled = true;
      try {
        const items = loadCartItems();
        acceptCartUpdates = true;
        if (!items.length) {
          showEmpty();
          return;
        }

        emptyContainer.classList.add('hidden');
        activeContainer.classList.remove('hidden');

        itemsList.innerHTML = items.map((item) => `
          <div class="flex items-center gap-4 py-2">
            <img src="${escapeCheckoutText(item.imageSrc)}" alt="${escapeCheckoutText(item.artworkTitle)}" class="w-14 h-14 object-cover border border-white/10" />
            <div class="flex-1 min-w-0">
              <h3 class="font-serif text-sm text-[var(--theme-text)] truncate">${escapeCheckoutText(item.artworkTitle)}</h3>
              <p class="text-[11px] font-mono text-[var(--theme-text-muted)]">${escapeCheckoutText(item.variantTitle)}</p>
              <p class="text-[11px] font-mono text-[var(--awp-accent)]">$${item.price.toFixed(2)}</p>
              ${quantityControls(item)}
            </div>
          </div>
        `).join('');

        const packages = $fulfillmentPackages.get();
        packageCards.innerHTML = packages.map((pkg, idx) => `
          <div class="p-2.5 border border-[var(--theme-border)] bg-[var(--theme-bg)] text-[11px]">
            <div class="flex justify-between font-bold text-[var(--theme-text)]">
              <span>Package ${idx + 1}: ${escapeCheckoutText(pkg.providerName)}</span>
              <span class="${pkg.estimatedShipping === 0 ? 'text-[var(--theme-accent)]' : ''}">
                ${pkg.estimatedShipping === 0 ? 'Complimentary' : '$' + pkg.estimatedShipping.toFixed(2)}
              </span>
            </div>
            <p class="text-[10px] text-[var(--theme-text-muted)] mt-0.5">${escapeCheckoutText(pkg.packagingDescription)}</p>
          </div>
        `).join('');

        const subtotal = $cartSubtotal.get();
        const freight = $totalShipping.get();
        summarySubtotal.textContent = `$${subtotal.toFixed(2)}`;
        summaryFreight.textContent = freight === 0 ? 'Included' : `$${freight.toFixed(2)}`;
        summaryTotal.textContent = `$${(subtotal + freight).toFixed(2)}`;

        await mountCheckout(items);
      } catch (err: unknown) {
        const message = err instanceof Error ? err.message : 'Checkout failed';
        showFatal(`Failed to mount checkout: ${message}`);
      } finally {
        if (!recovery.classList.contains('hidden')) {
          removeBtn.disabled = false;
          resetBtn.disabled = false;
        }
      }
    });
  }

  function scheduleCheckout() {
    if (checkoutTask) {
      queuedCheckout = true;
      return;
    }
    const run = init().finally(() => {
      checkoutTask = null;
      if (queuedCheckout) {
        queuedCheckout = false;
        scheduleCheckout();
      }
    });
    checkoutTask = run;
  }

  itemsList.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement | null)?.closest('button');
    if (!button) return;
    const decId = button.getAttribute('data-qty-dec');
    const incId = button.getAttribute('data-qty-inc');
    const id = decId || incId;
    if (!id) return;
    const item = $cartItems.get().find((entry) => entry.id === id);
    if (!item) return;
    updateItemQuantity(id, item.quantity + (incId ? 1 : -1));
  });

  removeBtn.addEventListener('click', () => {
    if (!unavailableItemId) return;
    const id = unavailableItemId;
    unavailableItemId = '';
    removeItem(id);
  });

  resetBtn.addEventListener('click', () => {
    unavailableItemId = '';
    clearCart();
  });

  $cartItems.subscribe(() => {
    if (!acceptCartUpdates) return;
    scheduleCheckout();
  });

  scheduleCheckout();
</script>