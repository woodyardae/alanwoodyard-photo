---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const allArtworks = await getCollection('artworks');
const artworks = allArtworks.filter((art) => art.data.solo_display !== false);
---

<Layout title="Alan Woodyard | Artworks">
  <Header />

  <main class="w-full max-w-7xl mx-auto px-6 md:px-12 py-16">
    <div class="mb-12 flex flex-wrap items-baseline justify-between border-b border-[var(--theme-border)] pb-6 gap-4">
      <h1 class="text-xs uppercase tracking-[0.28em] text-[var(--theme-text-muted)] font-mono">
        Catalog Archive - {artworks.length} Works
      </h1>
      <span class="text-xs font-mono text-[var(--theme-text-muted)]">
        Archival Pigment on Cotton Rag and Selected Substrates
      </span>
    </div>

    <div class="columns-1 md:columns-2 lg:columns-3 gap-8 [column-fill:_balance] space-y-8">
      {artworks.map((art) => {
        const itemSlug = art.id;
        const previewUrl = `/images/artworks/${itemSlug}.webp`;
        const startingPrice = art.data.print_variants?.[0]?.price_cents
          ? `$${Math.round(art.data.print_variants[0].price_cents / 100)}`
          : 'Inquire';

        return (
          <article class="break-inside-avoid group flex flex-col bg-[var(--theme-surface)]/60 border border-[var(--theme-border)] p-4 transition-all duration-300 hover:border-[var(--theme-accent)]/50">
            <a href={`/artwork/${itemSlug}`} class="block overflow-hidden bg-[var(--theme-bg)] flex items-center justify-center">
              <img
                src={previewUrl}
                alt={art.data.title}
                loading="lazy"
                class="w-full h-auto object-contain transition-transform duration-500 group-hover:scale-[1.01]"
              />
            </a>

            <div class="mt-4 pt-3 border-t border-[var(--theme-border)] flex items-baseline justify-between gap-4">
              <div>
                <h2 class="font-serif text-lg tracking-wide text-[var(--theme-text)] group-hover:text-[var(--theme-accent)] transition-colors">
                  <a href={`/artwork/${itemSlug}`}>
                    {art.data.title}
                  </a>
                </h2>
                {art.data.caption && (
                  <p class="text-xs text-[var(--theme-text-muted)] mt-1 line-clamp-1 font-sans">
                    {art.data.caption}
                  </p>
                )}
                {art.data.capture?.aspect_ratio && (
                  <p class="text-[11px] font-mono text-[var(--theme-text-muted)] mt-1 uppercase tracking-wider">
                    Ratio {art.data.capture.aspect_ratio}
                  </p>
                )}
              </div>

              <div class="text-right shrink-0">
                <span class="text-xs font-mono text-[var(--theme-accent)]">
                  {startingPrice}
                </span>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </main>

  <Footer />
</Layout>
