---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CollectionFilter from '../components/CollectionFilter.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import { getCollection } from 'astro:content';

const artworks = await getCollection('artworks');
const getSlug = (art: any) => art.data?.slug || art.slug || art.id.replace(/\.[^/.]+$/, '');
const hero = artworks.length > 0 ? artworks[0] : null;
const heroSlug = hero ? getSlug(hero) : '';
const heroLoc = hero ? (typeof hero.data.capture?.location === 'object' ? hero.data.capture.location.name : hero.data.capture?.location) : '';
const catalogItems = artworks.slice(1);
---
<Layout title="Alan Woodyard">
  <Header />

  <!-- Hero Plate: Full-Bleed Horizon -->
  {hero && (
    <section class="w-full px-6 md:px-16 pt-8 pb-14 max-w-[1700px] mx-auto">
      <a href={`/artwork/${heroSlug}`} class="block group">
        <div class="w-full flex items-center justify-center bg-[#0a0908]">
          <img 
            src={`/images/artworks/${heroSlug}.webp`} 
            alt={hero.data.title}
            class="w-full max-h-[82vh] object-contain transition-transform duration-700 ease-out group-hover:scale-[1.008]"
          />
        </div>
        <div class="mt-6 flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-2">
          <div>
            <h1 class="font-serif text-2xl md:text-4xl text-[#f7f4ee] font-light">{hero.data.title}</h1>
            <p class="text-xs text-[#8e8577] mt-1 font-sans">{heroLoc}{heroLoc && ' — '}{new Date(hero.data.capture.date).getFullYear()}</p>
          </div>
          <div class="text-left sm:text-right">
            <span class="text-xs font-mono text-[#c5a059] group-hover:text-[#dfb872] transition-colors">
              View Details &rarr;
            </span>
          </div>
        </div>
      </a>
    </section>
  )}

  <CollectionFilter />

  <!-- Exhibition Grid: Uniform 2-Column Balance -->
  <main class="w-full max-w-[1700px] mx-auto px-6 md:px-16 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 lg:gap-x-20">
      {catalogItems.map((art) => (
        <ArtworkCard artwork={art} />
      ))}
    </div>
  </main>

  <Footer />
</Layout>