---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CollectionFilter from '../components/CollectionFilter.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import { getCollection } from 'astro:content';

const artworks = await getCollection('artworks');
---
<Layout title="Alan Woodyard | Fine Art Photography">
  <Header />

  <!-- Hero Anchor Plate (Peter Lik Style: Expansive Horizon) -->
  {artworks.length > 0 && (
    <section class="w-full px-4 md:px-12 pt-8 pb-16 max-w-[1600px] mx-auto">
      <a href={`/artwork/${artworks[0].slug}`} class="block group relative">
        <div class="w-full overflow-hidden border gallery-hairline bg-[#09090b] flex items-center justify-center p-3 md:p-10 group-hover:border-white/20 transition-all duration-700">
          <img 
            src={`/images/artworks/${artworks[0].slug}.webp`} 
            alt={artworks[0].data.title}
            class="w-full max-h-[80vh] object-contain transition-transform duration-1000 ease-out group-hover:scale-[1.008]"
          />
        </div>
        <div class="mt-6 flex flex-col md:flex-row md:justify-between md:items-baseline gap-2">
          <div>
            <span class="text-[10px] font-mono uppercase tracking-widest text-zinc-500">Exhibition Hero &mdash; Limited Edition</span>
            <h1 class="font-serif text-2xl md:text-3xl text-zinc-100 mt-1">{artworks[0].data.title}</h1>
            <p class="text-xs text-zinc-400 mt-1 font-light">{artworks[0].data.capture.location} &bull; {new Date(artworks[0].data.capture.date).getFullYear()}</p>
          </div>
          <div class="text-left md:text-right">
            <span class="text-xs font-mono tracking-widest text-zinc-300">View Master Exhibition Plate &rarr;</span>
          </div>
        </div>
      </a>
    </section>
  )}

  <CollectionFilter />

  <!-- Gallery Body: 2-Column Rhythm with Full-Width Breaks -->
  <main class="w-full max-w-[1600px] mx-auto px-4 md:px-12 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 lg:gap-x-20">
      {artworks.slice(1).map((art, idx) => {
        // Every 3rd item breaks out to span the full width (Interrupter)
        const isInterrupter = (idx % 3 === 2);
        return <ArtworkCard artwork={art} spanFull={isInterrupter} />;
      })}
    </div>
  </main>

  <Footer />
</Layout>