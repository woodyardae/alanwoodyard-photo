---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CollectionFilter from '../components/CollectionFilter.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import { getCollection } from 'astro:content';

const artworks = await getCollection('artworks');
const getSlug = (art: any) => art.data?.slug || art.slug || art.id.replace(/\.[^/.]+$/, '');
const hero = artworks.length > 0 ? artworks[0] : null;
const heroSlug = hero ? getSlug(hero) : '';
const heroLoc = hero ? (typeof hero.data.capture?.location === 'object' ? hero.data.capture.location.name : hero.data.capture?.location) : '';
---
<Layout title="Alan Woodyard | Fine Art Photography">
  <Header />

  <!-- Hero Exhibition Plate (Peter Lik Style: Full Horizon) -->
  {hero && (
    <section class="w-full px-4 md:px-16 pt-8 pb-16 max-w-[1700px] mx-auto">
      <a href={`/artwork/${heroSlug}`} class="block group cursor-pointer">
        <img 
          src={`/images/artworks/${heroSlug}.webp`} 
          alt={hero.data.title}
          class="w-full max-h-[85vh] object-contain mx-auto transition-transform duration-1000 ease-out group-hover:scale-[1.008] shadow-2xl"
        />
        <div class="mt-8 flex flex-col md:flex-row md:justify-between md:items-baseline gap-3">
          <div>
            <span class="text-[9px] font-mono uppercase tracking-[0.25em] text-[#c5a059]">Signature Plate &mdash; Limited Edition</span>
            <h1 class="font-serif text-3xl md:text-5xl text-[#f7f4ee] font-light tracking-wide mt-1.5">{hero.data.title}</h1>
            <p class="text-xs font-mono tracking-[0.2em] uppercase text-[#a89f91] mt-1.5 font-light">{heroLoc} &bull; {new Date(hero.data.capture.date).getFullYear()}</p>
          </div>
          <div class="text-left md:text-right">
            <span class="text-xs font-mono tracking-[0.2em] text-[#c5a059] group-hover:text-[#dfb872] uppercase transition-colors">
              Inspect Exhibition Details &rarr;
            </span>
          </div>
        </div>
      </a>
    </section>
  )}

  <CollectionFilter />

  <!-- Exhibition Grid: Alternating 2-Column with Panoramic Breaks -->
  <main class="w-full max-w-[1700px] mx-auto px-4 md:px-16 py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-16 lg:gap-x-28">
      {artworks.slice(1).map((art, idx) => {
        const isInterrupter = (idx % 3 === 2);
        return <ArtworkCard artwork={art} spanFull={isInterrupter} />;
      })}
    </div>
  </main>

  <Footer />
</Layout>