---
// src/pages/artwork/[slug].astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const artworks = await getCollection('artworks');
  return artworks.map(entry => {
    const slug = entry.data?.slug || (entry as any).slug || entry.id.replace(/\.[^/.]+$/, '');
    return {
      params: { slug: String(slug) },
      props: { artwork: entry }
    };
  });
}

const { artwork } = Astro.props;
const data = artwork.data;
const slug = data.slug || artwork.slug || artwork.id.replace(/\.[^/.]+$/, '');
const locationName = typeof data.capture?.location === 'object' ? data.capture.location.name : (data.capture?.location || 'Studio Archive');
const variants = data.print_variants || data.variants || [];
const colorSpace = data.colorScience?.colorSpace || data.color_science?.native_space || 'Adobe RGB (1998)';
---
<Layout title={`${data.title} | Alan Woodyard`}>
  <Header />

  <article class="w-full max-w-[1700px] mx-auto px-4 md:px-16 py-12 md:py-20">
    <!-- Unboxed Floating Master Image -->
    <div class="w-full flex items-center justify-center">
      <img 
        src={`/images/artworks/${slug}.webp`} 
        alt={data.title}
        class="max-w-full max-h-[85vh] object-contain shadow-2xl"
      />
    </div>

    <!-- Versace Gallery Placard & Collector Acquisition Console -->
    <div class="mt-16 md:mt-24 grid grid-cols-1 lg:grid-cols-12 gap-16 border-t gallery-hairline pt-14">
      
      <!-- Left: Curatorial & Technical Provenance -->
      <div class="lg:col-span-7 space-y-8">
        <div>
          <span class="text-[9px] font-mono uppercase tracking-[0.25em] text-[#c5a059]">Master Photographic Plate</span>
          <h1 class="font-serif text-4xl md:text-5xl text-[#f7f4ee] font-light tracking-wide mt-2">{data.title}</h1>
          <p class="text-xs font-mono tracking-[0.2em] uppercase text-[#a89f91] mt-2 font-light">{locationName} &bull; {new Date(data.capture.date).getFullYear()}</p>
        </div>

        <p class="text-[#cfc8bd] font-light leading-relaxed text-sm md:text-base max-w-2xl">
          {data.description}
        </p>

        <!-- Technical Exposure Placard -->
        <div class="pt-8 border-t gallery-hairline">
          <h3 class="text-[9px] font-mono uppercase tracking-[0.25em] text-[#c5a059] mb-4">Technical Exposure Specifications</h3>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-xs font-mono text-[#a89f91]">
            <div>
              <span class="block text-[#6e6557] text-[9px] uppercase tracking-widest">CAMERA</span>
              {data.capture.camera || 'Medium Format'}
            </div>
            <div>
              <span class="block text-[#6e6557] text-[9px] uppercase tracking-widest">LENS</span>
              {data.capture.lens || 'Prime'}
            </div>
            <div>
              <span class="block text-[#6e6557] text-[9px] uppercase tracking-widest">EXPOSURE</span>
              {data.capture.settings?.aperture || 'f/8'} &bull; {data.capture.settings?.shutter_speed || '1/125s'}
            </div>
            <div>
              <span class="block text-[#6e6557] text-[9px] uppercase tracking-widest">COLOR PROFILE</span>
              {colorSpace}
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Substrate & Acquisition Console -->
      <div class="lg:col-span-5 bg-[#14110f] border brass-hairline p-8 md:p-10 space-y-8 shadow-2xl">
        <div>
          <span class="text-[9px] font-mono uppercase tracking-[0.25em] text-[#c5a059] block mb-2">Private Collector Edition</span>
          <h2 class="font-serif text-2xl text-[#f7f4ee] font-light">Select Substrate & Dimensions</h2>
        </div>

        <!-- Substrate Options -->
        <div class="space-y-4">
          <label class="block text-xs font-mono uppercase tracking-[0.2em] text-[#a89f91]">Print Medium</label>
          <div class="grid grid-cols-1 gap-2.5 text-xs">
            {variants.map((v: any, i: number) => {
              const substrateLabel = (v.substrate || v.label || 'Fine Art Giclée').replace(/-/g, ' ');
              const price = (v.price_usd_cents || v.priceCents || 18500) / 100;
              return (
                <label class="flex items-center justify-between p-3.5 border gallery-hairline bg-[#0e0c0a] hover:border-[#c5a059]/60 cursor-pointer transition-colors">
                  <div class="flex items-center gap-3">
                    <input type="radio" name="substrate" value={v.sku} checked={i === 0} class="accent-[#c5a059]" />
                    <span class="text-[#f7f4ee] capitalize font-sans">{substrateLabel}</span>
                  </div>
                  <span class="font-mono text-[#c5a059] font-medium">${price}</span>
                </label>
              );
            })}
          </div>
        </div>

        <button 
          id="buy-btn"
          class="w-full py-4 border border-[#c5a059] text-[#0e0c0a] text-xs font-mono uppercase tracking-[0.25em] bg-[#c5a059] hover:bg-[#dfb872] transition-all duration-300 font-bold"
        >
          Acquire Archival Print &rarr;
        </button>

        <p class="text-[11px] text-[#6e6557] font-light text-center leading-normal">
          Printed to 300 DPI museum archival standards on 100% cotton rag with mineral pigments. Insured art freight calculated at checkout.
        </p>
      </div>

    </div>
  </article>

  <Footer />
</Layout>