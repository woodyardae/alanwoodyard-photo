---
// src/pages/artwork/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { Artwork, Variant } from '../../content.config';

export async function getStaticPaths() {
  const artworkEntries = await getCollection('artworks');
  return artworkEntries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { artwork: entry.data }
  }));
}

interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;
const defaultVariant = artwork.variants[0];
const isLimited = artwork.limitedEdition?.isLimited;
---

<Layout
  title={`${artwork.title} &bull; Alan Woodyard Fine Art`}
  description={artwork.description}
  image={artwork.previewImage}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav class="mb-6 flex items-center space-x-2 text-xs text-slate-500 font-mono">
      <a href="/" class="hover:text-slate-300">Archive</a>
      <span>/</span>
      <span class="text-sky-400 capitalize">{artwork.collections[0]?.replace('-', ' ')}</span>
      <span>/</span>
      <span class="text-slate-300 truncate max-w-xs">{artwork.title}</span>
    </nav>

    <!-- Main Grid: Visualizer Left, Purchase & Specs Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <!-- Left Column: Visualizer & Viewport Toggle -->
      <div class="lg:col-span-7 space-y-4">
        <!-- Interactive Viewport Container -->
        <div class="relative overflow-hidden rounded-2xl border border-[#25283d] bg-[#0c0d13] p-2 flex items-center justify-center min-h-[420px] shadow-2xl">
          <!-- Raw Image View -->
          <img
            id="artwork-viewport-img"
            src={artwork.previewImage}
            alt={artwork.title}
            class="max-h-[600px] w-auto max-w-full rounded-lg object-contain transition-opacity duration-300"
          />

          <!-- View Mode Toggle Overlay -->
          <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex items-center gap-1.5 rounded-full border border-black/60 bg-black/70 backdrop-blur-md px-3 py-1.5 text-xs font-semibold shadow-lg">
            <button
              type="button"
              id="view-mode-raw"
              class="rounded-full bg-sky-500 px-3 py-0.5 text-slate-950 transition-colors"
            >
              Print Master View
            </button>
            <button
              type="button"
              id="view-mode-framed"
              class="rounded-full px-3 py-0.5 text-slate-300 hover:text-white transition-colors"
            >
              Gallery Framed Mockup
            </button>
          </div>
        </div>

        <!-- Color Science Swatch & Technical Badges Bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-[#1f2233] bg-[#10111a] p-4 text-xs">
          <div class="flex items-center gap-3">
            <span class="text-[11px] font-mono text-slate-400 uppercase">Dominant Palette:</span>
            <div class="flex items-center gap-1.5">
              {artwork.colorScience.dominantHex.map((hex) => (
                <div class="flex items-center gap-1">
                  <span
                    class="h-4 w-4 rounded-full border border-white/20 shadow-inner"
                    style={`background-color: ${hex};`}
                  />
                  <span class="font-mono text-[10px] text-slate-400">{hex}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="flex items-center gap-2">
            <span class="rounded bg-sky-950 px-2 py-0.5 font-mono text-[10px] text-sky-400 border border-sky-800">
              {artwork.colorScience.colorSpace}
            </span>
            <span class="rounded bg-[#1a1c28] px-2 py-0.5 font-mono text-[10px] text-slate-300 border border-[#2c3048]">
              White Point: {artwork.colorScience.whitePoint}
            </span>
          </div>
        </div>
      </div>

      <!-- Right Column: Title, Substrate Selection & Purchase Engine -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          {isLimited && (
            <div class="inline-flex items-center gap-1.5 rounded bg-amber-500/15 border border-amber-500/30 px-2.5 py-1 text-xs font-bold text-amber-400 uppercase tracking-wider mb-2">
              <span>Limited Edition Release &bull; {artwork.limitedEdition?.editionSize} Signed &amp; Numbered</span>
            </div>
          )}

          <h1 class="text-3xl font-extrabold tracking-tight text-white leading-tight">
            {artwork.title}
          </h1>

          <div class="mt-2 flex items-center gap-2 text-xs text-slate-400">
            <span>{artwork.capture.location.name}</span>
            <span>&bull;</span>
            <span class="font-mono">{artwork.capture.date}</span>
          </div>

          <p class="mt-4 text-sm text-slate-300 leading-relaxed">
            {artwork.description}
          </p>
        </div>

        <!-- Substrate & Variant Configuration Console -->
        <div class="rounded-xl border border-[#23273e] bg-[#12131d] p-5 space-y-5">
          <!-- Step 1: Substrate Selector -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              Select Substrate &amp; Medium
            </label>
            <div id="substrate-buttons" class="space-y-2">
              {Array.from(new Set(artwork.variants.map((v) => v.substrate))).map((sub, idx) => {
                const sampleVar = artwork.variants.find((v) => v.substrate === sub)!;
                return (
                  <button
                    type="button"
                    class={`substrate-btn w-full text-left rounded-lg border p-3 transition-all cursor-pointer flex items-center justify-between ${
                      idx === 0
                        ? 'active-sub border-sky-500 bg-sky-500/10 text-white'
                        : 'border-[#262940] bg-[#161826] text-slate-300 hover:border-slate-600'
                    }`}
                    data-substrate={sub}
                  >
                    <div>
                      <div class="text-xs font-bold">{sampleVar.substrateName}</div>
                      <div class="text-[10px] text-slate-400 mt-0.5 font-mono uppercase">
                        Fulfillment Lab: {sampleVar.lab}
                      </div>
                    </div>
                    <span class="font-mono text-xs text-sky-400 font-semibold">
                      from ${Math.min(...artwork.variants.filter((v) => v.substrate === sub).map((v) => v.retailPriceUsd))}
                    </span>
                  </button>
                );
              })}
            </div>
          </div>

          <!-- Step 2: Size & Dimension Selector -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
              Select Dimensions
            </label>
            <div id="size-selector-container" class="grid grid-cols-2 gap-2">
              <!-- Dynamically populated based on selected substrate -->
            </div>
          </div>

          <!-- Price & Add To Cart Button -->
          <div class="border-t border-[#23273d] pt-4 flex items-center justify-between">
            <div>
              <div class="text-[10px] text-slate-400 uppercase tracking-wider">Collector Price</div>
              <div id="selected-price-display" class="text-2xl font-extrabold font-mono text-white">
                ${defaultVariant.retailPriceUsd.toFixed(2)}
              </div>
            </div>

            <button
              type="button"
              id="add-to-cart-action"
              class="rounded-lg bg-sky-500 px-6 py-3 text-sm font-bold text-slate-950 hover:bg-sky-400 transition-colors shadow-lg shadow-sky-500/20 cursor-pointer flex items-center gap-2"
            >
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
              <span>Add to Cart</span>
            </button>
          </div>

          <!-- Archival Guarantee Micro-Copy -->
          <div class="text-[11px] text-slate-500 leading-normal pt-1">
            &bull; Printed on demand with 0.125" mirrored bleed margins.<br>
            &bull; Includes physical Certificate of Authenticity and lab color inspection report.
          </div>
        </div>

        <!-- Technical Capture & Pre-Flight Specifications -->
        <div class="rounded-xl border border-[#1f2233] bg-[#0f1017] p-5 space-y-4">
          <h3 class="text-xs font-bold text-slate-300 uppercase tracking-wider">
            Pre-Flight Technical Data &amp; Camera EXIF
          </h3>

          <div class="grid grid-cols-2 gap-3 text-xs">
            <div>
              <span class="text-slate-500 block text-[10px]">Camera System</span>
              <span class="font-mono text-slate-200">{artwork.capture.camera}</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px]">Lens / Focal Length</span>
              <span class="font-mono text-slate-200">{artwork.capture.lens} ({artwork.capture.focalLength})</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px]">Exposure / ISO</span>
              <span class="font-mono text-slate-200">{artwork.capture.aperture} @ {artwork.capture.shutterSpeed}, ISO {artwork.capture.iso}</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px]">Native Resolution</span>
              <span class="font-mono text-slate-200">{artwork.dimensions.widthPx} &times; {artwork.dimensions.heightPx} px</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px]">Max Archival Paper (300 DPI)</span>
              <span class="font-mono text-sky-400">{artwork.masterAsset?.maxDpiPaperWidthInches}" &times; {artwork.masterAsset?.maxDpiPaperHeightInches}"</span>
            </div>
            <div>
              <span class="text-slate-500 block text-[10px]">Max Direct Metal (180 DPI)</span>
              <span class="font-mono text-sky-400">{artwork.masterAsset?.maxDpiMetalWidthInches}" &times; {artwork.masterAsset?.maxDpiMetalHeightInches}"</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script define:vars={{ artwork }}>
    import { trackViewArtwork, trackSelectPrintSize } from '../../lib/analytics';

    // Track artwork pageview
    trackViewArtwork({
      artworkId: artwork.id,
      slug: artwork.slug,
      title: artwork.title,
      collection: artwork.collections[0],
      colorSpace: artwork.colorScience.colorSpace
    });

    // Viewport Toggle
    const viewportImg = document.getElementById('artwork-viewport-img');
    const viewRawBtn = document.getElementById('view-mode-raw');
    const viewFramedBtn = document.getElementById('view-mode-framed');

    if (viewRawBtn && viewFramedBtn && viewportImg) {
      viewRawBtn.addEventListener('click', () => {
        viewportImg.src = artwork.previewImage;
        viewRawBtn.className = 'rounded-full bg-sky-500 px-3 py-0.5 text-slate-950 transition-colors';
        viewFramedBtn.className = 'rounded-full px-3 py-0.5 text-slate-300 hover:text-white transition-colors';
      });

      viewFramedBtn.addEventListener('click', () => {
        if (artwork.framedMockup) {
          viewportImg.src = artwork.framedMockup;
          viewFramedBtn.className = 'rounded-full bg-sky-500 px-3 py-0.5 text-slate-950 transition-colors';
          viewRawBtn.className = 'rounded-full px-3 py-0.5 text-slate-300 hover:text-white transition-colors';
        }
      });
    }

    // Substrate & Variant Configuration State
    let selectedSubstrate = artwork.variants[0].substrate;
    let selectedVariant = artwork.variants[0];

    const sizeContainer = document.getElementById('size-selector-container');
    const priceDisplay = document.getElementById('selected-price-display');
    const addBtn = document.getElementById('add-to-cart-action');
    const substrateButtons = document.querySelectorAll('.substrate-btn');

    function renderSizes() {
      if (!sizeContainer) return;
      const matchingVariants = artwork.variants.filter((v) => v.substrate === selectedSubstrate);

      sizeContainer.innerHTML = matchingVariants
        .map(
          (v, idx) => `
        <button
          type="button"
          class="size-btn rounded-lg border p-2.5 text-left transition-all cursor-pointer ${
            v.sku === selectedVariant.sku
              ? 'border-sky-500 bg-sky-500/10 text-white'
              : 'border-[#262940] bg-[#161826] text-slate-300 hover:border-slate-600'
          }"
          data-sku="${v.sku}"
        >
          <div class="text-xs font-bold font-mono">${v.size}</div>
          <div class="text-[10px] text-slate-400 mt-0.5 font-mono">$${v.retailPriceUsd.toFixed(2)}</div>
        </button>
      `
        )
        .join('');

      sizeContainer.querySelectorAll('.size-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const sku = btn.getAttribute('data-sku');
          const found = matchingVariants.find((v) => v.sku === sku);
          if (found) {
            selectedVariant = found;
            renderSizes();
            updatePrice();
          }
        });
      });
    }

    function updatePrice() {
      if (priceDisplay) {
        priceDisplay.textContent = `$${selectedVariant.retailPriceUsd.toFixed(2)}`;
      }

      // Track size selection telemetry
      trackSelectPrintSize({
        artworkId: artwork.id,
        slug: artwork.slug,
        substrate: selectedVariant.substrate,
        size: selectedVariant.size,
        priceUsd: selectedVariant.retailPriceUsd,
        lab: selectedVariant.lab
      });
    }

    substrateButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const sub = btn.getAttribute('data-substrate');
        if (!sub) return;
        selectedSubstrate = sub;

        substrateButtons.forEach((b) => {
          b.classList.remove('border-sky-500', 'bg-sky-500/10', 'text-white');
          b.classList.add('border-[#262940]', 'bg-[#161826]', 'text-slate-300');
        });
        btn.classList.remove('border-[#262940]', 'bg-[#161826]', 'text-slate-300');
        btn.classList.add('border-sky-500', 'bg-sky-500/10', 'text-white');

        const firstMatch = artwork.variants.find((v) => v.substrate === selectedSubstrate);
        if (firstMatch) {
          selectedVariant = firstMatch;
        }
        renderSizes();
        updatePrice();
      });
    });

    renderSizes();
    updatePrice();

    if (addBtn) {
      addBtn.addEventListener('click', () => {
        if ((window as any).awpAddToCart) {
          (window as any).awpAddToCart({
            id: selectedVariant.sku,
            artworkId: artwork.id,
            slug: artwork.slug,
            title: artwork.title,
            previewImage: artwork.previewImage,
            variantSku: selectedVariant.sku,
            substrate: selectedVariant.substrate,
            substrateName: selectedVariant.substrateName,
            size: selectedVariant.size,
            lab: selectedVariant.lab,
            supplierSku: selectedVariant.supplierSku,
            priceUsd: selectedVariant.retailPriceUsd,
            quantity: 1
          });
        }
      });
    }
  </script>
</Layout>
