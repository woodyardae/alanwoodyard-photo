---
// src/pages/artwork/[slug].astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const artworks = await getCollection('artworks');
  return artworks.map(entry => {
    const slug = entry.data?.slug || (entry as any).slug || entry.id.replace(/\.[^/.]+$/, '');
    return {
      params: { slug: String(slug) },
      props: { artwork: entry }
    };
  });
}

const { artwork } = Astro.props;
const data = artwork.data;
const slug = data.slug || artwork.slug || artwork.id.replace(/\.[^/.]+$/, '');
const locationName = typeof data.capture?.location === 'object' ? data.capture.location.name : (data.capture?.location || '');
const variants = data.print_variants || data.variants || [];
const colorSpace = data.colorScience?.colorSpace || data.color_science?.native_space || 'Adobe RGB (1998)';
---
<Layout title={`${data.title} | Alan Woodyard`}>
  <Header />

  <article class="w-full max-w-[1700px] mx-auto px-6 md:px-16 py-10 md:py-16">
    <!-- Image Display -->
    <div class="w-full flex items-center justify-center bg-[#0a0908] py-4">
      <img 
        src={`/images/artworks/${slug}.webp`} 
        alt={data.title}
        class="max-w-full max-h-[82vh] object-contain shadow-2xl"
      />
    </div>

    <!-- Details & Acquisition Console -->
    <div class="mt-12 md:mt-20 grid grid-cols-1 lg:grid-cols-12 gap-12 border-t border-white/[0.06] pt-12">
      
      <!-- Left: Factual Description & Camera Data -->
      <div class="lg:col-span-7 space-y-8">
        <div>
          <h1 class="font-serif text-3xl md:text-5xl text-[#f7f4ee] font-light">{data.title}</h1>
          <p class="text-xs text-[#8e8577] mt-2 font-sans tracking-wide">
            {locationName}{locationName && ' — '}{new Date(data.capture.date).getFullYear()}
          </p>
        </div>

        <p class="text-[#cfc8bd] font-light leading-relaxed text-sm md:text-base max-w-2xl">
          {data.description}
        </p>

        <!-- Technical Exposure Placard -->
        <div class="pt-6 border-t border-white/[0.06]">
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-mono text-[#a89f91]">
            <div>
              <span class="block text-[#6e6557] text-[10px] uppercase">Camera</span>
              {data.capture.camera || 'Medium Format'}
            </div>
            <div>
              <span class="block text-[#6e6557] text-[10px] uppercase">Lens</span>
              {data.capture.lens || 'Prime'}
            </div>
            <div>
              <span class="block text-[#6e6557] text-[10px] uppercase">Exposure</span>
              {data.capture.settings?.aperture || 'f/8'} &bull; {data.capture.settings?.shutter_speed || '1/125s'}
            </div>
            <div>
              <span class="block text-[#6e6557] text-[10px] uppercase">Profile</span>
              {colorSpace}
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Substrate Selector -->
      <div class="lg:col-span-5 bg-[#141210] border border-white/[0.06] p-8 space-y-6">
        <div>
          <h2 class="font-serif text-xl text-[#f7f4ee]">Acquire Print</h2>
          <p class="text-xs text-[#8e8577] mt-1">Archival giclée, acrylic, and direct metal editions.</p>
        </div>

        <div class="space-y-2">
          {variants.map((v: any, i: number) => {
            const substrateLabel = (v.substrate || v.label || 'Fine Art Giclée').replace(/-/g, ' ');
            const price = (v.price_usd_cents || v.priceCents || 18500) / 100;
            return (
              <label class="flex items-center justify-between p-3.5 border border-white/[0.05] bg-[#0d0c0a] hover:border-white/[0.15] cursor-pointer transition-colors text-xs">
                <div class="flex items-center gap-3">
                  <input type="radio" name="substrate" value={v.sku} checked={i === 0} class="accent-[#c5a059]" />
                  <span class="text-[#f7f4ee] capitalize font-sans">{substrateLabel}</span>
                </div>
                <span class="font-mono text-[#c5a059]">${price}</span>
              </label>
            );
          })}
        </div>

        <button 
          id="buy-btn"
          class="w-full py-4 border border-[#c5a059] text-[#0d0c0a] text-xs font-mono uppercase tracking-[0.2em] bg-[#c5a059] hover:bg-[#dfb872] transition-colors font-bold"
        >
          Add to Collection &rarr;
        </button>

        <p class="text-[11px] text-[#6e6557] font-light text-center">
          Printed to 300 DPI museum standards. Insured art shipping calculated at checkout.
        </p>
      </div>

    </div>
  </article>

  <Footer />
</Layout>