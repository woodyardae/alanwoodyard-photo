---
// src/pages/artwork/[slug].astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const artworks = await getCollection('artworks');
  return artworks.map(entry => ({
    params: { slug: entry.slug },
    props: { artwork: entry }
  }));
}

const { artwork } = Astro.props;
const data = artwork.data;
---
<Layout title={`${data.title} | Alan Woodyard`}>
  <Header />

  <article class="w-full max-w-[1700px] mx-auto px-4 md:px-12 py-10 md:py-16">
    <!-- Main Print Frame (Floats with Generous Negative Space) -->
    <div class="w-full flex items-center justify-center p-4 md:p-16 border gallery-hairline bg-[#08080a]">
      <img 
        src={`/images/artworks/${artwork.slug}.webp`} 
        alt={data.title}
        class="max-w-full max-h-[82vh] object-contain shadow-2xl"
      />
    </div>

    <!-- Versace Gallery Placard & Collector Purchase Console -->
    <div class="mt-12 md:mt-20 grid grid-cols-1 lg:grid-cols-12 gap-12 border-t gallery-hairline pt-12">
      
      <!-- Left: Curatorial & Technical Provenance -->
      <div class="lg:col-span-7 space-y-6">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-zinc-500">Fine Art Photographic Print</span>
          <h1 class="font-serif text-3xl md:text-4xl text-zinc-100 mt-1">{data.title}</h1>
          <p class="text-sm text-zinc-400 mt-2 font-light">{data.capture.location} &bull; {new Date(data.capture.date).getFullYear()}</p>
        </div>

        <p class="text-zinc-300 font-light leading-relaxed text-sm md:text-base max-w-2xl">
          {data.description}
        </p>

        <!-- Technical Capture Placard -->
        <div class="pt-6 border-t gallery-hairline">
          <h3 class="text-[10px] font-mono uppercase tracking-widest text-zinc-500 mb-3">Capture & Exposure Specifications</h3>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-mono text-zinc-400">
            <div>
              <span class="block text-zinc-600 text-[10px]">CAMERA</span>
              {data.capture.camera || 'Medium Format'}
            </div>
            <div>
              <span class="block text-zinc-600 text-[10px]">LENS</span>
              {data.capture.lens || 'Prime'}
            </div>
            <div>
              <span class="block text-zinc-600 text-[10px]">SETTINGS</span>
              {data.capture.settings?.aperture || 'f/8'} &bull; {data.capture.settings?.shutter_speed || '1/125s'}
            </div>
            <div>
              <span class="block text-zinc-600 text-[10px]">COLOR SPACE</span>
              {data.color_science?.native_space || 'Adobe RGB'}
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Substrate & Acquisition Console -->
      <div class="lg:col-span-5 bg-[#0f0f12] border gallery-hairline p-8 space-y-6">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-widest text-zinc-500 block mb-2">Acquire Edition</span>
          <h2 class="font-serif text-xl text-zinc-100">Select Substrate & Dimensions</h2>
        </div>

        <!-- Substrate Options -->
        <div class="space-y-3">
          <label class="block text-xs font-mono uppercase tracking-wider text-zinc-400">Print Medium</label>
          <div class="grid grid-cols-1 gap-2 text-xs">
            {data.print_variants.map((v: any, i: number) => (
              <label class="flex items-center justify-between p-3 border gallery-hairline bg-[#09090b] hover:border-zinc-500 cursor-pointer transition-colors">
                <div class="flex items-center gap-3">
                  <input type="radio" name="substrate" value={v.sku} checked={i === 0} class="accent-zinc-100" />
                  <span class="text-zinc-200 capitalize">{v.substrate.replace(/-/g, ' ')}</span>
                </div>
                <span class="font-mono text-zinc-400">${v.price_usd_cents / 100}</span>
              </label>
            ))}
          </div>
        </div>

        <button 
          id="buy-btn"
          class="w-full py-4 border border-zinc-100 text-zinc-100 text-xs font-mono uppercase tracking-widest hover:bg-white hover:text-black transition-all duration-300"
        >
          Add to Private Collection &rarr;
        </button>

        <p class="text-[11px] text-zinc-500 font-light text-center leading-normal">
          Each fine-art giclée is custom printed to 300 DPI archival museum standards on 100% cotton rag with pigmented mineral inks. Insured art freight calculated at checkout.
        </p>
      </div>

    </div>
  </article>

  <Footer />
</Layout>