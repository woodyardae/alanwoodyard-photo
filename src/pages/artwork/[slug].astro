---
// src/pages/artwork/[slug].astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const artworks = await getCollection('artworks');
  return artworks.map(entry => {
    const slug = entry.data?.slug || (entry as any).slug || entry.id.replace(/\.[^/.]+$/, '');
    return {
      params: { slug: String(slug) },
      props: { artwork: entry }
    };
  });
}

const { artwork } = Astro.props;
const data = artwork.data;
const slug = data.slug || artwork.slug || artwork.id.replace(/\.[^/.]+$/, '');
const locationName = typeof data.capture?.location === 'object' ? data.capture.location.name : (data.capture?.location || '');
const variants = data.print_variants || data.variants || [];
const colorSpace = data.colorScience?.colorSpace || data.color_science?.native_space || 'Adobe RGB (1998)';
---
<Layout title={`${data.title} | Alan Woodyard`}>
  <Header />

  <article class="w-full max-w-[1700px] mx-auto px-6 md:px-16 py-12 md:py-20">
    <div class="w-full flex items-center justify-center bg-[#0a0908] py-4">
      <img 
        src={`/images/artworks/${slug}.webp`} 
        alt={data.title}
        class="max-w-full max-h-[84vh] object-contain shadow-2xl"
      />
    </div>

    <div class="mt-14 md:mt-24 grid grid-cols-1 lg:grid-cols-12 gap-14 border-t border-white/[0.08] pt-14">
      
      <!-- Left: Curatorial & Exposure Placard -->
      <div class="lg:col-span-7 space-y-8">
        <div>
          <h1 class="font-serif text-4xl md:text-6xl text-[#f7f4ee] font-light leading-tight">{data.title}</h1>
          <p class="text-sm text-[#a89f91] mt-2.5 font-sans tracking-wide">
            {locationName}{locationName && ' — '}{new Date(data.capture.date).getFullYear()}
          </p>
        </div>

        <p class="text-[#cfc8bd] font-light leading-relaxed text-base md:text-lg max-w-2xl">
          {data.description}
        </p>

        <!-- Technical Exposure Specs -->
        <div class="pt-8 border-t border-white/[0.08]">
          <h3 class="text-xs font-mono uppercase tracking-[0.25em] text-[#c5a059] mb-4">Capture Specifications</h3>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 text-sm font-mono text-[#a89f91]">
            <div>
              <span class="block text-[#6e6557] text-xs uppercase tracking-wider mb-1">Camera</span>
              {data.capture.camera || 'Medium Format'}
            </div>
            <div>
              <span class="block text-[#6e6557] text-xs uppercase tracking-wider mb-1">Lens</span>
              {data.capture.lens || 'Prime'}
            </div>
            <div>
              <span class="block text-[#6e6557] text-xs uppercase tracking-wider mb-1">Exposure</span>
              {data.capture.settings?.aperture || 'f/8'} &bull; {data.capture.settings?.shutter_speed || '1/125s'}
            </div>
            <div>
              <span class="block text-[#6e6557] text-xs uppercase tracking-wider mb-1">Profile</span>
              {colorSpace}
            </div>
          </div>
        </div>
      </div>

      <!-- Right: Substrate Options -->
      <div class="lg:col-span-5 bg-[#141210] border border-white/[0.08] p-8 md:p-10 space-y-7">
        <div>
          <h2 class="font-serif text-2xl md:text-3xl text-[#f7f4ee]">Acquire Archival Print</h2>
          <p class="text-sm text-[#a89f91] mt-1.5">Custom giclée, optical acrylic, and aluminum editions.</p>
        </div>

        <div class="space-y-3">
          {variants.map((v: any, i: number) => {
            const substrateLabel = (v.substrate || v.label || 'Fine Art Giclée').replace(/-/g, ' ');
            const price = (v.price_usd_cents || v.priceCents || 18500) / 100;
            return (
              <label class="flex items-center justify-between p-4 border border-white/[0.08] bg-[#0d0c0a] hover:border-white/[0.2] cursor-pointer transition-colors text-sm">
                <div class="flex items-center gap-3.5">
                  <input type="radio" name="substrate" value={v.sku} checked={i === 0} class="accent-[#c5a059]" />
                  <span class="text-[#f7f4ee] capitalize font-sans">{substrateLabel}</span>
                </div>
                <span class="font-mono text-[#c5a059] font-medium">${price}</span>
              </label>
            );
          })}
        </div>

        <button 
          id="buy-btn"
          class="w-full py-4 border border-[#c5a059] text-[#0d0c0a] text-sm font-mono uppercase tracking-[0.2em] bg-[#c5a059] hover:bg-[#dfb872] transition-colors font-bold"
        >
          Add to Collection &rarr;
        </button>

        <p class="text-xs text-[#8e8577] font-light text-center leading-relaxed">
          Printed to 300 DPI archival museum standards. Insured freight calculated at checkout.
        </p>
      </div>

    </div>
  </article>

  <Footer />
</Layout>