---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import StorefrontFrame from '../../components/StorefrontFrame.astro';
// @ts-ignore cloudflare:workers binding is absent during local Node typecheck.
import { env } from 'cloudflare:workers';
import { ARTWORK_SLUG_RE, getEffectiveCatalog, type SessionKv } from '../../lib/artwork-overlay';
import { parseEnabledVendorsConfig } from '../../lib/checkout-catalog';
import { renderArtworkRoute } from '../../lib/storefront-nav';

const session = (env as { SESSION?: SessionKv } | undefined)?.SESSION;
const catalog = await getEffectiveCatalog({ SESSION: session });
const requested = (Astro.params.id || '').trim().toLowerCase();

if (!ARTWORK_SLUG_RE.test(requested)) {
  return new Response('Artwork not found', { status: 404, headers: { 'Content-Type': 'text/plain' } });
}

const artwork =
  catalog.find((item) => item.slug === requested) ?? catalog.find((item) => item.id === requested) ?? null;
if (!artwork) {
  return new Response('Artwork not found', { status: 404, headers: { 'Content-Type': 'text/plain' } });
}
if (artwork.slug !== requested) {
  return Astro.redirect(`/artwork/${artwork.slug}${Astro.url.search}`, 301);
}

Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');

const page = renderArtworkRoute({
  artwork,
  catalog,
  searchParams: Astro.url.searchParams,
  enabledVendors: parseEnabledVendorsConfig(
    (import.meta.env as Record<string, string | undefined>).CHECKOUT_ENABLED_VENDORS
  ),
});
---

<Layout title={page.title} theme="walnut">
  <StorefrontFrame navHtml={page.navHtml} mainHtml={page.mainHtml} />
</Layout>

<script>
  import { addItem, type CartItem, type ProviderId } from '../../stores/cart';

  const title = document.querySelector('h1')?.textContent?.trim() || 'Alan Woodyard Photograph';
  const artworkImg = document.getElementById('artworkImage') as HTMLImageElement | null;
  const imageSrc = artworkImg ? artworkImg.src : '';
  const stage = document.querySelector('[data-artwork-id]');
  const artworkId = stage?.getAttribute('data-artwork-id')
    || window.location.pathname.split('/').filter(Boolean).pop()
    || 'artwork';

  document.querySelectorAll('.btn-add-cart').forEach((btn) => {
    btn.addEventListener('click', (event) => {
      const el = event.currentTarget as HTMLButtonElement;
      const sku = el.dataset.sku || '';
      const variantTitle = el.dataset.variant || title;
      const price = parseFloat(el.dataset.price || '0');
      const provider = el.dataset.provider as ProviderId;
      const packagingType = (el.dataset.packaging || 'rigid_tube') as CartItem['packagingType'];
      if (!sku || !provider || !(price > 0)) return;

      const item: CartItem = {
        id: `${artworkId}-${sku}`,
        artworkId,
        artworkTitle: title,
        variantTitle,
        sku,
        provider,
        packagingType,
        price,
        quantity: 1,
        imageSrc,
      };

      addItem(item);
    });
  });
</script>
