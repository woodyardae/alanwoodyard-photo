---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { getCollection } from 'astro:content';
import pricingMatrixRaw from '../../content/pricing-matrix.json';

export async function getStaticPaths() {
  const artworks = await getCollection('artworks');
  return artworks.map((item) => ({
    params: { id: item.id },
    props: { artwork: item },
  }));
}

const { artwork } = Astro.props;
const { 
  title, 
  year, 
  medium, 
  caption,
  description, 
  merch_approved = [], 
  print_variants = [],
  capture = {} 
} = artwork.data;

const hasDisplate = merch_approved.some((p: string) => p.toLowerCase().includes('displate'));
const matrix = pricingMatrixRaw as Record<string, { retailPrice: number; name: string; provider: string; packagingType: string; spec: string }>;

const allMerchCatalog = [
  {
    matchKey: 'mug',
    skuKey: 'AWP-PFY-MUG',
    title: matrix['AWP-PFY-MUG']?.name || 'Ceramic Waterfront Mug (11oz)',
    price: matrix['AWP-PFY-MUG']?.retailPrice || 22,
    spec: matrix['AWP-PFY-MUG']?.spec || 'Dishwasher safe • Full wrap finish',
    provider: 'printify',
    packaging: 'corrugated_box',
  },
  {
    matchKey: 'coaster',
    skuKey: 'AWP-PFY-COASTERS',
    title: matrix['AWP-PFY-COASTERS']?.name || 'Hardwood Coaster Set (4-Pk)',
    price: matrix['AWP-PFY-COASTERS']?.retailPrice || 28,
    spec: matrix['AWP-PFY-COASTERS']?.spec || 'High-gloss heat-resistant top • Cork base',
    provider: 'printify',
    packaging: 'corrugated_box',
  },
  {
    matchKey: 'desk',
    skuKey: 'AWP-PFY-DESKMAT',
    title: matrix['AWP-PFY-DESKMAT']?.name || 'Studio Panoramic Desk Mat',
    price: matrix['AWP-PFY-DESKMAT']?.retailPrice || 48,
    spec: matrix['AWP-PFY-DESKMAT']?.spec || 'Natural rubber base • Stitched border',
    provider: 'printify',
    packaging: 'poly_mailer',
  },
  {
    matchKey: 'acrylic',
    skuKey: 'AWP-GTN-ACRYLIC',
    title: matrix['AWP-GTN-ACRYLIC']?.name || 'Optical Acrylic Desk Block (6x6")',
    price: matrix['AWP-GTN-ACRYLIC']?.retailPrice || 55,
    spec: matrix['AWP-GTN-ACRYLIC']?.spec || '1" thick optical acrylic • Freestanding',
    provider: 'gooten',
    packaging: 'corrugated_box',
  },
];

const approvedGoods = allMerchCatalog.filter((item) =>
  merch_approved.some((approved: string) => approved.toLowerCase().includes(item.matchKey))
);

const nativeRatio = capture?.aspect_ratio || 'Native';
const rawVariants = print_variants.length > 0 
  ? print_variants 
  : [
      { size: '12x18"', substrate: 'Hahnemühle Photo Rag', price_cents: 12500, sku: 'GLOBAL-FAP-12x18' },
      { size: '16x24"', substrate: 'Hahnemühle Photo Rag', price_cents: 19500, sku: 'GLOBAL-FAP-16x24' },
      { size: '24x36"', substrate: 'Hahnemühle Photo Rag', price_cents: 34000, sku: 'GLOBAL-FAP-24x36' },
    ];

const prints = rawVariants.map((v: any) => ({
  sku: v.sku,
  size: v.size,
  substrate: v.substrate || 'Hahnemühle Photo Rag 308gsm',
  price: v.price_cents ? Math.round(v.price_cents / 100) : (matrix[v.sku]?.retailPrice || 185),
  provider: 'prodigi',
  packaging: 'rigid_tube',
}));

const lowestPrice = approvedGoods.length > 0 
  ? Math.min(...approvedGoods.map(g => g.price)) 
  : (prints.length > 0 ? Math.min(...prints.map((p: any) => p.price)) : 185);
---

<Layout title={`${title} | Alan Woodyard`} theme="walnut">
  <Header />

  <main class="w-full max-w-6xl mx-auto px-6 lg:px-12 py-10 flex-1">
    <div class="mb-8">
      <a href="/artworks" class="inline-flex items-center gap-2 text-xs font-mono text-[var(--theme-text-muted)] hover:text-[var(--theme-accent)] transition-colors">
        <span>&larr;</span>
        <span class="tracking-widest uppercase text-[11px]">Back to Artworks</span>
      </a>
    </div>

    <!-- STAGE 1: Museum Presentation -->
    <section class="flex flex-col items-center">
      <div class="relative w-full bg-[#0a0807] border border-[var(--theme-border)] p-4 sm:p-8 flex items-center justify-center shadow-2xl">
        <img
          id="artworkImage"
          src={`/images/artworks/${artwork.id}.webp`}
          alt={title}
          class="w-full h-auto max-h-[75vh] object-contain select-none"
          loading="eager"
        />
      </div>

      <!-- Museum Placard & Caption Block -->
      <div class="w-full mt-8 max-w-3xl text-center space-y-4">
        <span class="text-[11px] font-mono text-[var(--theme-accent)] tracking-[0.25em] uppercase block">
          {year || '2026 Collection'} &bull; Ratio {nativeRatio}
        </span>
        <h1 class="font-serif text-3xl sm:text-4xl text-[var(--theme-text)] font-light tracking-wide">
          {title}
        </h1>
        {caption && (
          <p class="font-serif italic text-sm text-[var(--theme-text-muted)] max-w-xl mx-auto leading-relaxed">
            "{caption}"
          </p>
        )}
        {description && (
          <p class="font-sans text-xs text-[var(--theme-text-muted)]/90 max-w-xl mx-auto leading-relaxed font-light">
            {description}
          </p>
        )}

        <!-- Progressive Disclosure CTA Button -->
        <div class="pt-6">
          <button
            type="button"
            id="toggleShopBtn"
            class="px-8 py-3.5 border border-[var(--theme-accent)] bg-[var(--theme-accent)] text-[var(--theme-bg)] hover:bg-transparent hover:text-[var(--theme-accent)] transition-all font-mono text-xs uppercase tracking-widest font-bold shadow-lg inline-flex items-center gap-2 cursor-pointer"
          >
            <span>Explore Prints & Merchandise (From ${lowestPrice})</span>
            <span id="shopBtnArrow">&darr;</span>
          </button>
        </div>
      </div>
    </section>

    <!-- STAGE 2: Purchasing Controls (Unlocks on click) -->
    <section id="shoppingSection" class="hidden mt-16 pt-12 border-t border-[var(--theme-border)] transition-all duration-500">
      <div class="max-w-4xl mx-auto space-y-12">
        <div class="text-center">
          <span class="text-[11px] font-mono text-[var(--theme-accent)] tracking-[0.2em] uppercase block mb-1">
            Order Direct
          </span>
          <h2 class="font-serif text-2xl text-[var(--theme-text)] font-light">
            Available Physical Formats
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
          
          <!-- Column 1: Approved Goods & Merch -->
          <div class="space-y-4">
            <div class="flex items-baseline justify-between border-b border-[var(--theme-border)] pb-2">
              <h3 class="text-xs font-mono tracking-wider uppercase text-[var(--theme-accent)] font-bold">
                Studio Goods & Gifts
              </h3>
              <span class="text-[10px] font-mono text-emerald-400">✓ Manually Approved Crops</span>
            </div>

            {approvedGoods.length > 0 ? (
              <div class="space-y-3">
                {approvedGoods.map((item) => (
                  <div class="p-3.5 border border-[var(--theme-border)] bg-[var(--theme-surface)] flex items-center justify-between hover:border-[var(--theme-accent)]/50 transition-colors">
                    <div class="pr-3 min-w-0">
                      <div class="flex items-center gap-2">
                        <span class="text-xs font-mono font-medium text-[var(--theme-text)] truncate">{item.title}</span>
                        <span class="text-sm font-sans font-bold text-[var(--theme-accent)]">${item.price}</span>
                      </div>
                      <p class="text-[10px] font-mono text-[var(--theme-text-muted)] mt-0.5">{item.spec}</p>
                    </div>
                    <button
                      type="button"
                      class="btn-add-cart shrink-0 px-3.5 py-2 text-xs font-mono bg-[var(--theme-accent)] text-[var(--theme-bg)] hover:bg-[var(--theme-accent-hover)] font-bold tracking-wider uppercase transition-colors"
                      data-sku={`${item.skuKey}-${artwork.id}`}
                      data-variant={item.title}
                      data-price={item.price}
                      data-provider={item.provider}
                      data-packaging={item.packaging}
                    >
                      Add to Cart &rarr;
                    </button>
                  </div>
                ))}
              </div>
            ) : (
              <div class="p-6 border border-dashed border-[var(--theme-border)] text-center text-xs font-mono text-[var(--theme-text-muted)]">
                No everyday merchandise has been manually approved for this piece yet.
              </div>
            )}
          </div>

          <!-- Column 2: Archival Prints -->
          <div class="space-y-4">
            <div class="flex items-baseline justify-between border-b border-[var(--theme-border)] pb-2">
              <h3 class="text-xs font-mono tracking-wider uppercase text-[var(--theme-accent)] font-bold">
                Archival Fine-Art Prints
              </h3>
              <span class="text-[10px] font-mono text-[var(--theme-text-muted)]">Free Art Freight</span>
            </div>

            <div class="space-y-3">
              {prints.map((print: any) => (
                <div class="p-3.5 border border-[var(--theme-border)] bg-[var(--theme-surface)] flex items-center justify-between hover:border-[var(--theme-accent)]/50 transition-colors">
                  <div class="pr-3">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-mono font-bold text-[var(--theme-text)]">{print.size}</span>
                      <span class="text-sm font-sans font-bold text-[var(--theme-accent)]">${print.price}</span>
                    </div>
                    <p class="text-[10px] font-mono text-[var(--theme-text-muted)] mt-0.5">{print.substrate}</p>
                  </div>
                  <button
                    type="button"
                    class="btn-add-cart shrink-0 px-3.5 py-2 text-xs font-mono border border-[var(--theme-accent)] text-[var(--theme-accent)] hover:bg-[var(--theme-accent)] hover:text-[var(--theme-bg)] font-bold tracking-wider uppercase transition-colors"
                    data-sku={print.sku}
                    data-variant={`${print.size} Fine-Art Print`}
                    data-price={print.price}
                    data-provider={print.provider}
                    data-packaging={print.packaging}
                  >
                    Add to Cart &rarr;
                  </button>
                </div>
              ))}

              {hasDisplate && (
                <div class="p-3.5 border border-[var(--theme-border)] bg-[var(--theme-surface)] flex items-center justify-between">
                  <div>
                    <p class="text-xs font-mono font-medium text-[var(--theme-text)]">Displate Metal Poster</p>
                    <p class="text-[10px] font-mono text-[var(--theme-text-muted)] mt-0.5">Magnetic Mount &bull; External Platform</p>
                  </div>
                  <a
                    href="https://displate.com/alanwoodyard"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3.5 py-2 text-xs font-mono border border-white/20 text-[var(--theme-text)] hover:border-[var(--theme-accent)] hover:text-[var(--theme-accent)] transition-colors inline-flex items-center gap-1.5 uppercase tracking-wider"
                  >
                    <span>Displate</span>
                    <span class="text-xs">&nearr;</span>
                  </a>
                </div>
              )}
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { addItem, type CartItem, type ProviderId } from '../../stores/cart';

  const title = document.querySelector('h1')?.textContent?.trim() || 'Alan Woodyard Photograph';
  const artworkImg = document.getElementById('artworkImage') as HTMLImageElement;
  const imageSrc = artworkImg ? artworkImg.src : '';
  const currentPath = window.location.pathname;
  const artworkId = currentPath.split('/').filter(Boolean).pop() || 'artwork';

  // Toggle Shopping Drawer
  const toggleBtn = document.getElementById('toggleShopBtn');
  const shopSection = document.getElementById('shoppingSection');
  const arrow = document.getElementById('shopBtnArrow');

  if (toggleBtn && shopSection) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = shopSection.classList.contains('hidden');
      if (isHidden) {
        shopSection.classList.remove('hidden');
        if (arrow) arrow.innerHTML = '&uarr;';
        shopSection.scrollIntoView({ behavior: 'smooth' });
      } else {
        shopSection.classList.add('hidden');
        if (arrow) arrow.innerHTML = '&darr;';
      }
    });
  }

  // Add to Cart
  document.querySelectorAll('.btn-add-cart').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const el = e.currentTarget as HTMLButtonElement;
      const sku = el.dataset.sku!;
      const variantTitle = el.dataset.variant!;
      const price = parseFloat(el.dataset.price || '0');
      const provider = el.dataset.provider as ProviderId;
      const packagingType = (el.dataset.packaging || 'rigid_tube') as any;

      const item: CartItem = {
        id: `${artworkId}-${sku}`,
        artworkId,
        artworkTitle: title,
        variantTitle,
        sku,
        provider,
        packagingType,
        price,
        quantity: 1,
        imageSrc,
      };

      addItem(item);
    });
  });
</script>