---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Provenance | Alan Woodyard">
  <Header />

  <main class="w-full max-w-4xl mx-auto px-6 md:px-12 py-20 md:py-28 space-y-16">
    <section>
      <h1 class="font-serif text-3xl md:text-5xl text-[#f7f4ee] font-light tracking-wide mb-8">
        Studio & Field Provenance
      </h1>
      <p class="text-[#cfc8bd] text-base md:text-lg leading-relaxed font-light">
        Alan Woodyard produces architectural, maritime, and coastal landscape plates across Texas and the mid-Atlantic. Capture workflows utilize high-resolution digital medium-format and 35mm systems, preserving uncompressed wide-gamut color data for large-format physical editions.
      </p>
    </section>

    <section class="border-t border-white/[0.06] pt-12 space-y-8">
      <h2 class="text-xs font-mono uppercase tracking-[0.25em] text-[#c5a059]">
        Substrates & Archival Standards
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-sm">
        <div class="space-y-2">
          <h3 class="text-[#f7f4ee] font-medium font-sans">Hahnemühle Photo Rag</h3>
          <p class="text-[#8e8577] text-xs leading-relaxed">
            308gsm 100% cotton rag. Matte finish, zero optical brightening agents, archival pigment inks with 100+ year lightfastness.
          </p>
        </div>

        <div class="space-y-2">
          <h3 class="text-[#f7f4ee] font-medium font-sans">Optical Acrylic Float</h3>
          <p class="text-[#8e8577] text-xs leading-relaxed">
            High-gloss metallic print face-mounted to 1/4-inch cast acrylic with polished edges and a hidden aluminum rear float subframe.
          </p>
        </div>

        <div class="space-y-2">
          <h3 class="text-[#f7f4ee] font-medium font-sans">ChromaLuxe Aluminum</h3>
          <p class="text-[#8e8577] text-xs leading-relaxed">
            Dye-sublimation infused directly into coated aluminum panels. High contrast, moisture-resistant, frameless architectural mounting.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-white/[0.06] pt-12 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 text-xs font-mono text-[#8e8577]">
      <div>Inquiries & Commissions: contact@alanwoodyard.photo</div>
      <div>Commercial Fulfillment via Direct Print Labs</div>
    </section>
  </main>

  <Footer />
</Layout>