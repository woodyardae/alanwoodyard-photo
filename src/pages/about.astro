---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Contact | Alan Woodyard">
  <Header />

  <main class="w-full max-w-2xl mx-auto px-6 py-28 text-center space-y-6">
    <h1 class="font-serif text-3xl md:text-5xl text-[#f7f4ee] font-light tracking-wide">
      Alan Woodyard
    </h1>
    <p class="text-sm font-mono text-[#a89f91]">
      Inquiries: <a href="mailto:contact@alanwoodyard.photo" class="text-[#c5a059] hover:underline">contact@alanwoodyard.photo</a>
    </p>
  </main>

  <Footer />
</Layout>