{
  "routes": [
    {
      "routePath": "/api/checkout-status",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/checkout-status.ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/create-checkout-session",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/create-checkout-session.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/stripe-webhook",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/stripe-webhook.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/subscribe",
      "mountPath": "/api",
      "method": "OPTIONS",
      "module": [
        "api/subscribe.ts:onRequestOptions"
      ]
    },
    {
      "routePath": "/api/subscribe",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/subscribe.ts:onRequestPost"
      ]
    }
  ],
  "baseURL": "/"
}