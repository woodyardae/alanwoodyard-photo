{
    "name": "alanwoodyard-photo",
    "version": "1.0.0",
    "description": "Alan Woodyard Fine-Art Photography Storefront & Multi-Provider POD Fulfillment Engine",
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "preview": "astro preview",
        "preflight": "tsx scripts/preflight-prints.ts",
        "test": "tsx --test tests/**/*.test.ts",
        "typecheck": "tsc --noEmit",
        "sync-pricing": "tsx scripts/sync-pricing.ts",
