        "uuid": "^11.1.0",
        "zod": "^3.24.2"
    },
    "devDependencies": {
        "@astrojs/cloudflare": "^14.4.6",
        "@astrojs/tailwind": "^6.0.2",
        "@tailwindcss/vite": "^4.0.9",
        "@types/node": "^22.13.5",
        "@types/uuid": "^10.0.0",
        "sharp": "^0.35.5",
        "tailwindcss": "^3.4.17",
        "tsx": "^4.23.15",
        "typescript": "^5.7.3",
        "wrangler": "^4.158.0"
